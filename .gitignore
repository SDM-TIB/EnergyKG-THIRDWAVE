# Large raw knowledge graphs -- not committed, regardless of format.
# FrenchRoyalty is small (~1.6M) and stays committed directly.
# See data/README.md for how to obtain DB100K and YAGO3-10.
data/KG/DB100K/*.nt
data/KG/DB100K/*.tsv
data/KG/YAGO3-10/*.nt
data/KG/YAGO3-10/*.tsv
!data/KG/*/.gitkeep

# Runtime state -- generated by every run, never committed.
run_state/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Local venvs (e.g. scripts/setup_kaggle_py310.sh's target)
venv310/
.venv/
campaigns/
.DS_Store
*.log
*.tmp

# LaTeX build artifacts
*.aux
*.out
*.nav
*.snm
*.toc
*.bbl
*.blg
