# THIRDWAVE renewable-energy ontology, v15 (2026-10-13).
# 244 classes, 104 object properties, 224 datatype properties; every term has skos:definition and rdfs:comment.
# 254 SKOS alignments to OEO, STATO, ENVO, QUDT, SOSA, PROV-O, IAO, OBI, BFO, RO, SWO, CCO, FaBiO, BIBO, schema.org, ML-Schema, Dublin Core, DCAT.
@prefix : <https://w3id.org/thirdwave/ontology#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/thirdwave/ontology> a owl:Ontology ;
    dcterms:description "An ontology for representing renewable energy research studies: resources, systems, components, datasets, variables, models and their applications, analyses, locations, evaluation results, and economic and performance metrics."@en ;
    dcterms:references <http://purl.obolibrary.org/obo/>,
        dcterms:,
        <http://purl.org/ontology/bibo/>,
        <http://purl.org/spar/fabio/>,
        <http://qudt.org/schema/qudt/>,
        <http://www.ebi.ac.uk/swo/>,
        dcat:,
        <http://www.w3.org/ns/mls#>,
        prov:,
        sosa:,
        <https://openenergyplatform.org/ontology/oeo/>,
        schema:,
        <https://www.commoncoreontologies.org/> ;
    dcterms:title "Renewable Energy Research Ontology"@en ;
    owl:versionInfo "15" .

:AngularLinearJointDistribution a owl:Class ;
    rdfs:label "Angular-linear joint distribution"@en ;
    rdfs:comment "It describes wind direction and wind speed together, often with von Mises components for direction."@en ;
    rdfs:subClassOf :BivariateDistribution ;
    skos:definition "A bivariate distribution of a circular variable and a linear variable."@en .

:AtmosphericDerivedVariable a owl:Class ;
    rdfs:label "Atmospheric derived variable"@en ;
    rdfs:comment "Examples are the clearness index, which compares surface and extraterrestrial solar radiation, and drought indices combining precipitation and evapotranspiration."@en ;
    rdfs:subClassOf :Variable ;
    skos:definition "A variable derived from several atmospheric quantities, such as an index or a ratio."@en .

:BaggingModel a owl:Class ;
    rdfs:label "Bagging model"@en ;
    rdfs:comment "Random forest is the best-known bagging model; averaging reduces the variance of individual trees."@en ;
    rdfs:subClassOf :EnsembleTreeModel ;
    skos:definition "An ensemble model that averages the predictions of models trained on bootstrap samples of the data."@en .

:Barrier a owl:Class ;
    rdfs:label "Barrier"@en ;
    rdfs:comment "Examples are high initial costs, the lack of reliable resource data and the lack of infrastructure."@en ;
    rdfs:subClassOf :InfluencingFactor ;
    skos:definition "An influencing factor that hinders the use or deployment of an energy resource or system."@en .

:BayesianModel a owl:Class ;
    rdfs:label "Bayesian model"@en ;
    rdfs:comment "Examples are Gaussian process regression and Bayesian neural networks, which provide predictions with uncertainty."@en ;
    rdfs:subClassOf :MachineLearningModel ;
    skos:closeMatch <http://purl.obolibrary.org/obo/STATO_0000530> ;
    skos:definition "A model that represents uncertainty with probability distributions and updates them with data using Bayes theorem."@en .

:BiomassEnergy a owl:Class ;
    rdfs:label "Biomass energy"@en ;
    rdfs:comment "Sources include wood, charcoal, crop residues, animal manure and organic waste; in Sub-Saharan Africa traditional biomass often dominates household energy use. It differs from fossil fuels, which are of ancient biological origin."@en ;
    rdfs:subClassOf :RenewableEnergyResource ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00010258> ;
    skos:definition "A renewable energy resource consisting of the chemical energy stored in organic matter of recent biological origin."@en .

:BoostingModel a owl:Class ;
    rdfs:label "Boosting model"@en ;
    rdfs:comment "Gradient boosting methods such as XGBoost, LightGBM and CatBoost are frequent in solar and wind forecasting."@en ;
    rdfs:subClassOf :EnsembleTreeModel ;
    skos:definition "An ensemble model that builds models sequentially, each one correcting the errors of the previous ones."@en .

:BoundaryLayerVariable a owl:Class ;
    rdfs:label "Boundary layer variable"@en ;
    rdfs:comment "Boundary-layer variables, such as roughness length, friction velocity or Obukhov length, govern how wind speed changes with height and are used to extrapolate wind to hub height."@en ;
    rdfs:subClassOf :MeteorologicalVariable ;
    skos:definition "A meteorological variable describing the atmospheric boundary layer near the surface."@en .

:CaseStudy a owl:Class ;
    rdfs:label "Case study"@en ;
    rdfs:comment "A case study applies methods to concrete sites or systems in order to describe or assess them, for example evaluating the wind potential of selected towns. Its findings are tied to the cases examined."@en ;
    rdfs:subClassOf :Study ;
    skos:definition "A study that examines a renewable energy question at one or more specific locations or systems."@en .

:ClassificationMetric a owl:Class ;
    rdfs:label "Classification metric"@en ;
    rdfs:comment "Examples are the accuracy and the area under the ROC curve."@en ;
    rdfs:subClassOf :EvaluationMetric ;
    skos:definition "An evaluation metric for models that assign observations to classes."@en .

:ClimateModel a owl:Class ;
    rdfs:label "Climate model"@en ;
    rdfs:comment "Numerical weather prediction, reanalysis and regional climate models such as WRF or CORDEX provide wind and solar data and projections."@en ;
    rdfs:subClassOf :ProcessBasedModel ;
    skos:definition "A process-based model that simulates the atmosphere and climate system."@en .

:Coal a owl:Class ;
    rdfs:label "Coal"@en ;
    rdfs:comment "In renewable energy studies coal usually appears as the conventional reference that wind, solar or hydropower would displace, for example when computing avoided CO2 emissions or comparing generation costs."@en ;
    rdfs:subClassOf :NonRenewableEnergyResource ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_02000091>,
        <https://openenergyplatform.org/ontology/oeo/OEO_00000088> ;
    skos:definition "A non-renewable energy resource consisting of a combustible sedimentary rock formed from ancient plant matter."@en .

:CoastalTerrain a owl:Class ;
    rdfs:label "Coastal terrain"@en ;
    rdfs:comment "Coastal terrain is influenced by the sea, which moderates temperatures and drives land and sea breezes. Coasts are often favourable for wind energy because of the smooth sea surface upwind."@en ;
    rdfs:subClassOf :Terrain ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01000687> ;
    skos:definition "A terrain located along the boundary between land and sea."@en .

:ComparativeStudy a owl:Class ;
    rdfs:label "Comparative study"@en ;
    rdfs:comment "A comparative study sets alternatives side by side under common conditions in order to identify which performs best or how they differ, for example comparing estimation methods or turbine models."@en ;
    rdfs:subClassOf :Study ;
    skos:definition "A study whose main contribution is the comparison of several models, methods, systems or sites."@en .

:ContinentalClimate a owl:Class ;
    rdfs:label "Continental climate"@en ;
    rdfs:comment "Continental climates occur far from the moderating influence of the ocean, typically in the interior of large landmasses of the Northern Hemisphere, with large differences between summer and winter temperatures."@en ;
    rdfs:subClassOf :Climate ;
    skos:definition "A climate with cold winters, whose coldest month averages below 0 °C (or −3 °C) and warmest month above 10 °C (Köppen group D)."@en .

:ConvolutionalNeuralNetwork a owl:Class ;
    rdfs:label "Convolutional neural network"@en ;
    rdfs:comment "CNNs are used for sky images and for extracting features from time series in renewable energy forecasting."@en ;
    rdfs:subClassOf :NeuralNetworkModel ;
    skos:definition "A neural network that uses convolution layers to extract local patterns from grid-like data such as images or sequences."@en .

:CorrelationMetric a owl:Class ;
    rdfs:label "Correlation metric"@en ;
    rdfs:comment "The Pearson correlation coefficient is the most common example."@en ;
    rdfs:subClassOf :EvaluationMetric ;
    skos:closeMatch <http://purl.obolibrary.org/obo/STATO_0000142> ;
    skos:definition "An evaluation metric that measures the strength of the association between predicted and observed values."@en .

:CostMetric a owl:Class ;
    rdfs:label "Cost metric"@en ;
    rdfs:comment "Examples are the levelised cost of electricity in USD/kWh, the capital cost per installed kW and annual operation and maintenance costs. It differs from a profitability metric, which compares costs with revenues."@en ;
    rdfs:subClassOf :EconomicMetric ;
    skos:definition "An economic metric that expresses the cost of building, operating or producing energy with an energy system."@en .

:DataProcessingLibrary a owl:Class ;
    rdfs:label "Data processing library"@en ;
    rdfs:comment "Examples are pandas, NumPy and xarray in Python, often used to prepare wind speed, irradiance or discharge time series. It differs from statistical or visualization libraries, whose main purpose is inference or plotting."@en ;
    rdfs:subClassOf :SoftwareLibrary ;
    skos:definition "A software library that provides functions to read, clean, transform and manipulate data."@en .

:DecisionTreeModel a owl:Class ;
    rdfs:label "Decision tree model"@en ;
    rdfs:comment "Examples are CART and M5 model trees; they are easy to interpret but less accurate than ensembles."@en ;
    rdfs:subClassOf :TreeBasedModel ;
    skos:definition "A tree-based model consisting of a single tree of decision rules."@en ;
    skos:relatedMatch <http://purl.obolibrary.org/obo/OBI_0000707> .

:DemandVariable a owl:Class ;
    rdfs:label "Demand variable"@en ;
    rdfs:comment "Demand variables are compared with production to size systems and to assess how much of a demand can be covered."@en ;
    rdfs:subClassOf :Variable ;
    skos:definition "A variable describing the demand for or consumption of energy."@en .

:Depression a owl:Class ;
    rdfs:label "Depression"@en ;
    rdfs:comment "A depression is a sunken area enclosed or bordered by higher ground. It can collect water and cold air, and its relief shelters it from winds coming from the surrounding heights."@en ;
    rdfs:subClassOf :Terrain ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_00000309> ;
    skos:definition "A terrain formed by an area of land lower than its surroundings."@en .

:DesertClimate a owl:Class ;
    rdfs:label "Desert climate"@en ;
    rdfs:comment "Desert climates receive so little rain that vegetation is sparse or absent. They are often marked by strong sunshine, large daily temperature ranges and, in hot deserts, very high summer temperatures."@en ;
    rdfs:subClassOf :AridClimate ;
    skos:definition "An arid climate with very low annual precipitation (Köppen BW)."@en .

:DesertTerrain a owl:Class ;
    rdfs:label "Desert terrain"@en ;
    rdfs:comment "Desert terrain is characterized by sparse vegetation and often by sand, gravel or bare rock surfaces. It typically offers high solar radiation and open, unobstructed land."@en ;
    rdfs:subClassOf :Terrain ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001357> ;
    skos:definition "A terrain of arid land with little or no vegetation."@en .

:DistributionMetric a owl:Class ;
    rdfs:label "Distribution metric"@en ;
    rdfs:comment "Such metrics are used to compare wind-speed distributions."@en ;
    rdfs:subClassOf :EvaluationMetric ;
    skos:definition "An evaluation metric that compares a fitted probability distribution with the empirical distribution of the data."@en .

:Driver a owl:Class ;
    rdfs:label "Driver"@en ;
    rdfs:comment "For example, the planned retirement of ageing coal power plants opens room for new renewable capacity."@en ;
    rdfs:subClassOf :InfluencingFactor ;
    skos:definition "An influencing factor that favours the use or deployment of an energy resource or system."@en .

:EconomicAssessment a owl:Class ;
    rdfs:label "Economic assessment"@en ;
    rdfs:comment "A renewable energy project is only pursued if its costs are justified by the energy and benefits it delivers. Economic assessment concerns the cost of producing energy, the profitability of investments and the financial conditions under which renewable energy becomes viable."@en ;
    rdfs:subClassOf :ResearchProblem ;
    skos:definition "A research problem concerning the costs and economic viability of renewable energy."@en .

:EconomicEvaluation a owl:Class ;
    rdfs:label "Economic evaluation"@en ;
    rdfs:comment "Economic evaluation is the work of estimating the costs of producing energy and comparing them with the revenues or savings a system brings. It indicates whether a system or project is financially worthwhile."@en ;
    rdfs:subClassOf :StudyObjective ;
    skos:definition "A study objective of evaluating the costs or economic viability of an energy system."@en .

:EconomicFactor a owl:Class ;
    rdfs:label "Economic factor"@en ;
    rdfs:comment "Economic factors are the \"E\" of the PESTEL framework that concerns the economy. Examples are capital cost, discount rate, electricity prices and access to finance, which decide whether a project is viable."@en ;
    rdfs:subClassOf :InfluencingFactor ;
    skos:definition "An influencing factor arising from costs, prices, markets or financing."@en .

:EconomicImpact a owl:Class ;
    rdfs:label "Economic impact"@en ;
    rdfs:comment "Examples are cheaper energy than existing sources, savings on fuel or electricity bills, and new economic activity created around energy projects."@en ;
    rdfs:subClassOf :Impact ;
    skos:definition "An impact on costs, incomes, prices or economic activity."@en .

:EconomicPolicy a owl:Class ;
    rdfs:label "Economic policy"@en ;
    rdfs:comment "Economic policies steer behaviour through financial incentives rather than rules, for example a feed-in tariff, an environmental levy on fossil electricity or a competitive procurement programme. They are the \"carrots\" of the classic typology of policy instruments."@en ;
    rdfs:subClassOf :Policy ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00010456> ;
    skos:definition "A policy that changes costs or revenues, such as tariffs, taxes, levies, subsidies or auctions."@en .

:EconomicVariable a owl:Class ;
    rdfs:label "Economic variable"@en ;
    rdfs:comment "Examples are the cost of electricity generation, energy prices and net present value; they are used to judge whether projects are viable."@en ;
    rdfs:subClassOf :Variable ;
    skos:definition "A variable describing costs, prices, values or other economic quantities."@en .

:EfficiencyMetric a owl:Class ;
    rdfs:label "Efficiency metric"@en ;
    rdfs:comment "Examples are the Nash-Sutcliffe efficiency, the Kling-Gupta efficiency and the computation time."@en ;
    rdfs:subClassOf :EvaluationMetric ;
    skos:definition "An evaluation metric that expresses the skill of a model relative to a reference, or its computational efficiency."@en .

:EnergyEstimation a owl:Class ;
    rdfs:label "Energy estimation"@en ;
    rdfs:comment "The energy delivered by a renewable system depends on the resource, the technology and its operation. Energy estimation addresses how much electricity or useful energy a system produces or will produce, which underpins planning, grid operation and investment decisions."@en ;
    rdfs:subClassOf :ResearchProblem ;
    skos:definition "A research problem concerning the estimation or forecasting of the energy produced by renewable energy systems."@en .

:EnergyProductionVariable a owl:Class ;
    rdfs:label "Energy production variable"@en ;
    rdfs:comment "Examples are annual energy production, power output, capacity factor and installed capacity; they measure what a system actually delivers."@en ;
    rdfs:subClassOf :Variable ;
    skos:definition "A variable describing the energy or power produced by an energy system, or its operating state."@en .

:EnergyResourceVariable a owl:Class ;
    rdfs:label "Energy resource variable"@en ;
    rdfs:comment "Examples are theoretical and technical hydropower potential and available energy density; they express how much energy could be harvested at a site."@en ;
    rdfs:subClassOf :Variable ;
    skos:definition "A variable describing the amount of energy that a resource makes available before conversion."@en .

:EnergySupplyImpact a owl:Class ;
    rdfs:label "Energy supply impact"@en ;
    rdfs:comment "It records what an energy system or resource contributes to an energy system, for example covering 15% of national electricity demand or substituting for imported fuels."@en ;
    rdfs:subClassOf :Impact ;
    skos:definition "An impact on the supply of energy, such as the energy generated, the share of demand covered or the reduced dependence on other sources."@en .

:EnergySystemPerformance a owl:Class ;
    rdfs:label "Energy system performance"@en ;
    rdfs:comment "Turbines, photovoltaic plants, hydropower plants and hybrid systems convert a resource into energy with a certain efficiency, reliability and controllability. Energy system performance concerns how well such systems work in real or simulated conditions and how their operation can be improved."@en ;
    rdfs:subClassOf :ResearchProblem ;
    skos:definition "A research problem concerning the operational performance of renewable energy systems."@en .

:EnvironmentalAssessment a owl:Class ;
    rdfs:label "Environmental assessment"@en ;
    rdfs:comment "Renewable energy systems interact with their surroundings: they can alter river flows, land use and ecosystems, and they also avoid emissions from fossil generation. Environmental assessment concerns the nature and magnitude of these effects, whether harmful or beneficial."@en ;
    rdfs:subClassOf :ResearchProblem ;
    skos:definition "A research problem concerning the effects of renewable energy systems on the environment."@en .

:EnvironmentalFactor a owl:Class ;
    rdfs:label "Environmental factor"@en ;
    rdfs:comment "Environmental factors are the \"E\" of the PESTEL framework. In energy studies they include topography, surface roughness, atmospheric stability, seasonal winds, climate change and land-use change, which shape the resource itself."@en ;
    rdfs:subClassOf :InfluencingFactor ;
    skos:definition "An influencing factor arising from natural conditions, such as terrain, weather, climate or land cover."@en .

:EnvironmentalImpact a owl:Class ;
    rdfs:label "Environmental impact"@en ;
    rdfs:comment "Environmental impacts of renewable energy are often positive, such as avoided greenhouse gas emissions from fossil generation, but can also be negative, such as visual impact or altered river flows. (The research problem formerly named EnvironmentalImpact is now EnvironmentalAssessment.)"@en ;
    rdfs:subClassOf :Impact ;
    skos:definition "An impact on the natural environment, such as on emissions, landscape, water or ecosystems."@en ;
    skos:relatedMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000147> .

:ErrorMetric a owl:Class ;
    rdfs:label "Error metric"@en ;
    rdfs:comment "Examples are the RMSE, the MAE and the mean bias error; lower absolute values are better."@en ;
    rdfs:subClassOf :EvaluationMetric ;
    skos:definition "An evaluation metric that measures the size or direction of the differences between predicted and observed values."@en .

:FGMCopulaModel a owl:Class ;
    rdfs:label "FGM copula model"@en ;
    rdfs:comment "The FGM copula describes weak dependence between two variables, such as wind speed and direction."@en ;
    rdfs:subClassOf :CopulaModel ;
    skos:definition "A copula model based on the Farlie-Gumbel-Morgenstern copula."@en .

:FeedforwardNeuralNetwork a owl:Class ;
    rdfs:label "Feedforward neural network"@en ;
    rdfs:comment "The multilayer perceptron is the typical feedforward network and is commonly used to estimate solar radiation from meteorological data."@en ;
    rdfs:subClassOf :NeuralNetworkModel ;
    skos:definition "A neural network in which information flows in one direction from inputs to outputs without cycles."@en .

:GISSoftware a owl:Class ;
    rdfs:label "GIS software"@en ;
    rdfs:comment "Examples are ArcGIS and QGIS."@en ;
    rdfs:subClassOf :SoftwareTool ;
    skos:definition "A geographic information system software."@en .

:GeospatialVariable a owl:Class ;
    rdfs:label "Geospatial variable"@en ;
    rdfs:comment "Geospatial variables, such as latitude, basin area or the distance from a site to the grid, are used in mapping and site selection."@en ;
    rdfs:subClassOf :Variable ;
    skos:definition "A variable describing position, distance, length or area on the Earth surface."@en .

:GeothermalEnergy a owl:Class ;
    rdfs:label "Geothermal energy"@en ;
    rdfs:comment "It is exploited for electricity in high-temperature fields, such as those of the East African Rift, and for direct heating at lower temperatures."@en ;
    rdfs:subClassOf :RenewableEnergyResource ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_2000034> ;
    skos:definition "A renewable energy resource consisting of the heat contained in the interior of the Earth."@en ;
    skos:exactMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000191> .

:GoodnessOfFitMetric a owl:Class ;
    rdfs:label "Goodness of fit metric"@en ;
    rdfs:comment "Examples are the coefficient of determination and the index of agreement; higher values are usually better."@en ;
    rdfs:subClassOf :EvaluationMetric ;
    skos:definition "An evaluation metric that measures the agreement between a model and the data."@en .

:Highland a owl:Class ;
    rdfs:label "Highland"@en ;
    rdfs:comment "A highland is a broad area of high ground that may combine hills, plateaus and mountains. Its elevation influences temperature, wind exposure and river flow compared with nearby lowlands."@en ;
    rdfs:subClassOf :Terrain ;
    skos:definition "A terrain of elevated land, generally rugged, standing above the surrounding lowlands."@en .

:Hill a owl:Class ;
    rdfs:label "Hill"@en ;
    rdfs:comment "Hills are local elevations of moderate height. Their tops and exposed ridges are often windier than the surrounding land, and their slopes shape local runoff."@en ;
    rdfs:subClassOf :Terrain ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_00000083> ;
    skos:definition "A terrain formed by a naturally raised area of land, lower and less steep than a mountain."@en .

:HydroEnergy a owl:Class ;
    rdfs:label "Hydro energy"@en ;
    rdfs:comment "Hydro energy comes from water moving from higher to lower elevation in rivers and reservoirs. Its potential depends on river flow and the available head, both shaped by rainfall and topography."@en ;
    rdfs:subClassOf :RenewableEnergyResource ;
    skos:definition "A renewable energy resource consisting of the energy of flowing or falling water."@en ;
    skos:exactMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000218> .

:HydroSoftware a owl:Class ;
    rdfs:label "Hydro software"@en ;
    rdfs:comment "Examples are SWAT-CUP and HEC-RAS."@en ;
    rdfs:subClassOf :SoftwareTool ;
    skos:definition "A software tool dedicated to hydrological or hydraulic modelling."@en .

:HydrodynamicModel a owl:Class ;
    rdfs:label "Hydrodynamic model"@en ;
    rdfs:comment "HEC-RAS is a typical hydrodynamic model used for water levels and velocities."@en ;
    rdfs:subClassOf :ProcessBasedModel ;
    skos:definition "A process-based model that simulates the flow of water in rivers or channels from fluid-dynamics equations."@en .

:HydrogenFuel a owl:Class ;
    rdfs:label "Hydrogen fuel"@en ;
    rdfs:comment "Hydrogen can be produced from renewable electricity by electrolysis, stored, and converted back into electricity in fuel cells or burned for heat."@en ;
    rdfs:subClassOf :EnergyCarrier ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000220> ;
    skos:definition "Hydrogen used as a fuel or energy carrier."@en .

:HydrologicalModel a owl:Class ;
    rdfs:label "Hydrological model"@en ;
    rdfs:comment "Models such as SWAT, HBV or VIC estimate the river flows available for hydropower."@en ;
    rdfs:subClassOf :ProcessBasedModel ;
    skos:definition "A process-based model that simulates the water cycle of a catchment, such as runoff and streamflow."@en .

:HydrologicalVariable a owl:Class ;
    rdfs:label "Hydrological variable"@en ;
    rdfs:comment "Hydrological variables, such as discharge, streamflow, head and reservoir inflow, are the basis of hydropower resource assessment."@en ;
    rdfs:subClassOf :Variable ;
    skos:definition "A variable describing water flow, storage or level in the hydrological cycle."@en .

:ImpactEvaluation a owl:Class ;
    rdfs:label "Impact evaluation"@en ;
    rdfs:comment "Impact evaluation is the work of identifying and quantifying how an energy system affects its environment, such as changes in water flows, ecosystems or emissions. It informs whether those effects are acceptable and how they can be reduced."@en ;
    rdfs:subClassOf :StudyObjective ;
    skos:definition "A study objective of evaluating the environmental impacts of an energy system."@en .

:InSituInstrument a owl:Class ;
    rdfs:label "In situ instrument"@en ;
    rdfs:comment "In situ instruments, such as anemometers, pyranometers or data loggers on a mast or buoy, take measurements by being physically present at the site. They provide point measurements of high accuracy."@en ;
    rdfs:subClassOf :MeasuringInstrument ;
    skos:broadMatch sosa:Sensor ;
    skos:definition "A measuring instrument that measures a variable directly at the place where it is located."@en .

:InfiniteGaussianMixtureModel a owl:Class ;
    rdfs:label "Infinite Gaussian mixture model"@en ;
    rdfs:comment "The number of components is inferred from the data, typically by Bayesian non-parametric methods."@en ;
    rdfs:subClassOf :UnivariateDistribution ;
    skos:definition "A univariate mixture of Gaussian components whose number is not fixed in advance."@en .

:InformationCriterion a owl:Class ;
    rdfs:label "Information criterion"@en ;
    rdfs:comment "Examples are the AIC and the BIC; lower values are better."@en ;
    rdfs:subClassOf :EvaluationMetric ;
    skos:definition "An evaluation metric that balances the goodness of fit of a model against its number of parameters."@en .

:InformationalPolicy a owl:Class ;
    rdfs:label "Informational policy"@en ;
    rdfs:comment "Informational policies rely on knowledge rather than rules or money, for example publishing wind atlases or running awareness campaigns. They are the \"sermons\" of the classic typology of policy instruments."@en ;
    rdfs:subClassOf :Policy ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00010459> ;
    skos:definition "A policy that informs or persuades, such as labelling, awareness campaigns or resource maps."@en .

:InfrastructureVariable a owl:Class ;
    rdfs:label "Infrastructure variable"@en ;
    rdfs:comment "Infrastructure variables limit where and how much renewable capacity can be connected and delivered."@en ;
    rdfs:subClassOf :Variable ;
    skos:definition "A variable describing energy infrastructure, such as grid capacity, transmission lines or network losses."@en .

:InstanceBasedModel a owl:Class ;
    rdfs:label "Instance-based model"@en ;
    rdfs:comment "k-nearest neighbours is the typical instance-based model."@en ;
    rdfs:subClassOf :MachineLearningModel ;
    skos:definition "A machine-learning model that predicts from the most similar stored examples rather than from a learned function."@en ;
    skos:relatedMatch <http://purl.obolibrary.org/obo/OBI_0000727> .

:LandSurfaceVariable a owl:Class ;
    rdfs:label "Land surface variable"@en ;
    rdfs:comment "Land-surface variables influence runoff, evaporation and surface roughness, and therefore water and wind resources."@en ;
    rdfs:subClassOf :Variable ;
    skos:definition "A variable describing the land surface, such as soil, land cover or snow cover."@en .

:LegalFactor a owl:Class ;
    rdfs:label "Legal factor"@en ;
    rdfs:comment "Legal factors are the \"L\" of the PESTEL framework. Examples are grid codes, permitting procedures, land rights and environmental regulations."@en ;
    rdfs:subClassOf :InfluencingFactor ;
    skos:definition "An influencing factor arising from laws, regulations or legal procedures."@en .

:MediterraneanClimate a owl:Class ;
    rdfs:label "Mediterranean climate"@en ;
    rdfs:comment "In a Mediterranean climate, rainfall is concentrated in the cool season while summers are dry and sunny. It is typical of the Mediterranean basin and of west coasts at similar latitudes."@en ;
    rdfs:subClassOf :TemperateClimate ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01000207> ;
    skos:definition "A temperate climate with dry summers and wet winters (Köppen Cs)."@en .

:MeteorologicalSoftware a owl:Class ;
    rdfs:label "Meteorological software"@en ;
    rdfs:comment "An example is WRFDA."@en ;
    rdfs:subClassOf :SoftwareTool ;
    skos:definition "A software tool for meteorological modelling or data assimilation."@en .

:MethodologicalFactor a owl:Class ;
    rdfs:label "Methodological factor"@en ;
    rdfs:comment "Methodological factors lie outside the PESTEL framework, which covers the external environment: they concern the research itself. Examples are data size and quality, measurement height and representativeness, and the choice of estimation method or goodness-of-fit measure."@en ;
    rdfs:subClassOf :InfluencingFactor ;
    skos:definition "An influencing factor arising from the data or methods used in a study."@en .

:MethodologicalStudy a owl:Class ;
    rdfs:label "Methodological study"@en ;
    rdfs:comment "A methodological study proposes and tests a way of doing something, such as a new probability distribution or forecasting model. The data serve mainly to demonstrate the method."@en ;
    rdfs:subClassOf :Study ;
    skos:definition "A study whose main contribution is a new or improved method, model or procedure."@en .

:MixtureDistributionModel a owl:Class ;
    rdfs:label "Mixture distribution model"@en ;
    rdfs:comment "Mixtures fit bimodal or irregular wind-speed regimes that a single distribution cannot represent."@en ;
    rdfs:subClassOf :ProbabilityDistributionModel ;
    skos:definition "A probability distribution formed as a weighted sum of several component distributions."@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/STATO_0000334> .

:ModelDevelopment a owl:Class ;
    rdfs:label "Model development"@en ;
    rdfs:comment "Model development is the work of constructing a mathematical, statistical or data-driven representation of a phenomenon, or of adapting an existing one to new data by estimating its parameters. Its outcome is a model or method that can then be applied or evaluated."@en ;
    rdfs:subClassOf :StudyObjective ;
    skos:definition "A study objective of building, fitting or calibrating a model or method."@en .

:ModelEvaluation a owl:Class ;
    rdfs:label "Model evaluation"@en ;
    rdfs:comment "Model evaluation aims to establish how well a model, method or distribution reproduces observed data, either on its own or relative to alternatives. It supports the choice of the most reliable approach for a given resource, site or application by quantifying agreement with observations."@en ;
    rdfs:subClassOf :StudyObjective ;
    skos:definition "A study objective of comparing or validating models, methods or distributions."@en .

:MountainousTerrain a owl:Class ;
    rdfs:label "Mountainous terrain"@en ;
    rdfs:comment "Mountainous terrain rises well above its surroundings and is marked by ridges, peaks and steep valleys. It strongly modifies wind flow, rainfall and solar exposure, which is why it matters for resource assessment."@en ;
    rdfs:subClassOf :Terrain ;
    skos:definition "A terrain dominated by mountains, with high elevation and steep slopes."@en ;
    skos:relatedMatch <http://purl.obolibrary.org/obo/ENVO_00000081> .

:NaturalGas a owl:Class ;
    rdfs:label "Natural gas"@en ;
    rdfs:comment "In renewable energy studies it usually appears as the conventional or backup generation that renewables would complement or replace, for example in hybrid systems or emission comparisons."@en ;
    rdfs:subClassOf :NonRenewableEnergyResource ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01000552>,
        <https://openenergyplatform.org/ontology/oeo/OEO_00000292> ;
    skos:definition "A non-renewable energy resource consisting of a gaseous fossil fuel composed mainly of methane."@en .

:NeuroFuzzyModel a owl:Class ;
    rdfs:label "Neuro-fuzzy model"@en ;
    rdfs:comment "ANFIS is the typical neuro-fuzzy model; it learns fuzzy rules from data."@en ;
    rdfs:subClassOf :MachineLearningModel ;
    skos:definition "A model that combines a neural network with fuzzy inference rules."@en .

:NonParametricDistributionModel a owl:Class ;
    rdfs:label "Non parametric distribution model"@en ;
    rdfs:comment "Kernel density estimation is the typical non-parametric approach."@en ;
    rdfs:subClassOf :ProbabilityDistributionModel ;
    skos:closeMatch <http://purl.obolibrary.org/obo/STATO_0000321> ;
    skos:definition "A probability distribution estimated from data without assuming a fixed functional form."@en .

:NuclearEnergy a owl:Class ;
    rdfs:label "Nuclear energy"@en ;
    rdfs:comment "Current power plants use fission of uranium. It is low-carbon but is not renewable, because its fuel is not replenished on a human timescale."@en ;
    rdfs:subClassOf :NonRenewableEnergyResource ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_2000025> ;
    skos:definition "A non-renewable energy resource consisting of the energy released by nuclear fission or fusion."@en .

:OffshoreArea a owl:Class ;
    rdfs:label "Offshore area"@en ;
    rdfs:comment "Offshore areas are open sea surfaces where wind blows with little obstruction and is generally stronger and steadier than on land, which makes them important for offshore wind energy."@en ;
    rdfs:subClassOf :Terrain ;
    skos:definition "An area of sea located away from the coast."@en ;
    skos:relatedMatch <http://purl.obolibrary.org/obo/ENVO_00000016> .

:Opportunity a owl:Class ;
    rdfs:label "Opportunity"@en ;
    rdfs:comment "Examples are rising electricity demand, new feed-in tariffs or falling module prices. Unlike a strength, it lies outside the system being analysed."@en ;
    rdfs:subClassOf :SWOTFactor ;
    skos:definition "A SWOT factor that is an external condition favourable to an energy resource, project or technology."@en .

:Optimization a owl:Class ;
    rdfs:label "Optimization"@en ;
    rdfs:comment "Optimization is the work of adjusting the size, configuration, control or schedule of an energy system so that it performs as well as possible with respect to an objective such as energy output, profit or stability."@en ;
    rdfs:subClassOf :StudyObjective ;
    skos:definition "A study objective of improving the design or operation of an energy system."@en .

:OptimizationModel a owl:Class ;
    rdfs:label "Optimization model"@en ;
    rdfs:comment "Metaheuristics such as genetic algorithms or particle swarm optimization tune model parameters or size energy systems."@en ;
    rdfs:subClassOf :Model ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000314> ;
    skos:definition "A model or algorithm that searches for the best solution of an objective under constraints."@en .

:ParametricDistributionModel a owl:Class ;
    rdfs:label "Parametric distribution model"@en ;
    rdfs:comment "Examples are the Weibull, Rayleigh, Gamma and lognormal distributions, whose parameters are estimated from data."@en ;
    rdfs:subClassOf :ProbabilityDistributionModel ;
    skos:definition "A probability distribution defined by a known functional form with a finite number of parameters."@en .

:PerformanceEvaluation a owl:Class ;
    rdfs:label "Performance evaluation"@en ;
    rdfs:comment "Performance evaluation is the work of quantifying how much energy a system produces and how efficiently and reliably it does so, for example through energy yield or capacity factor. It shows how a given technology behaves under the conditions of a site."@en ;
    rdfs:subClassOf :StudyObjective ;
    skos:definition "A study objective of evaluating the performance of an energy system."@en .

:Petroleum a owl:Class ;
    rdfs:label "Petroleum"@en ;
    rdfs:comment "In renewable energy studies it typically appears as diesel used in generators for off-grid supply, which solar or wind hybrid systems are designed to reduce."@en ;
    rdfs:subClassOf :NonRenewableEnergyResource ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_00002984> ;
    skos:definition "A non-renewable energy resource consisting of liquid fossil hydrocarbons and the fuels refined from them."@en ;
    skos:narrowMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000115> .

:Plain a owl:Class ;
    rdfs:label "Plain"@en ;
    rdfs:comment "Plains are broad, low-relief areas. Their smooth surface lets wind flow with little disturbance and makes them easy to access and build on."@en ;
    rdfs:subClassOf :Terrain ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_00000086> ;
    skos:definition "A terrain of flat or gently rolling land with little variation in elevation."@en .

:PlanningPolicy a owl:Class ;
    rdfs:label "Planning policy"@en ;
    rdfs:comment "Planning policies, such as a national renewable energy masterplan, an integrated resource plan or a spatial planning framework, set targets and priorities that other instruments then implement."@en ;
    rdfs:subClassOf :Policy ;
    skos:definition "A policy that sets a plan, strategy or spatial framework for future development."@en .

:Plateau a owl:Class ;
    rdfs:label "Plateau"@en ;
    rdfs:comment "A plateau combines high elevation with a flat surface. It shares the exposure of high ground while offering the even terrain of a plain."@en ;
    rdfs:subClassOf :Terrain ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_00000182> ;
    skos:definition "A terrain of elevated, relatively flat land bounded on at least one side by a steep slope."@en .

:PolarClimate a owl:Class ;
    rdfs:label "Polar climate"@en ;
    rdfs:comment "Polar climates have no true summer. They include tundra, where the ground thaws briefly, and ice cap climates, where temperatures remain below freezing almost all year."@en ;
    rdfs:subClassOf :Climate ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01000238> ;
    skos:definition "A climate in which every month has a mean temperature below 10 °C (Köppen group E)."@en .

:PolicyAnalysis a owl:Class ;
    rdfs:label "Policy analysis"@en ;
    rdfs:comment "Policy analysis is the work of examining the institutional, regulatory, economic and social conditions that shape energy deployment, identifying what hinders it and proposing measures or strategies to support it."@en ;
    rdfs:subClassOf :StudyObjective ;
    skos:definition "A study objective of analysing policies, barriers or strategies for energy deployment."@en .

:PolicyAssessment a owl:Class ;
    rdfs:label "Policy assessment"@en ;
    rdfs:comment "The uptake of renewable energy depends not only on resources and technologies but also on institutions, regulations, incentives and social acceptance. Policy assessment concerns how these factors enable or hinder deployment and how policies can be designed to support it."@en ;
    rdfs:subClassOf :ResearchProblem ;
    skos:definition "A research problem concerning policies, regulations and barriers affecting renewable energy deployment."@en .

:PoliticalFactor a owl:Class ;
    rdfs:label "Political factor"@en ;
    rdfs:comment "Political factors are the \"P\" of the PESTEL framework. Examples are energy policies, support schemes, planned retirement of power plants and political stability."@en ;
    rdfs:subClassOf :InfluencingFactor ;
    skos:definition "An influencing factor arising from government action, public policy or political decisions."@en .

:Prediction a owl:Class ;
    rdfs:label "Prediction"@en ;
    rdfs:comment "Prediction is the work of producing values of a variable that has not been observed, either because it lies in the future, at another location or height, or because it is not measured directly. It applies a model to inputs in order to obtain the values needed for a decision or an analysis."@en ;
    rdfs:subClassOf :StudyObjective ;
    skos:definition "A study objective of estimating or forecasting values of a variable."@en .

:ProfitabilityMetric a owl:Class ;
    rdfs:label "Profitability metric"@en ;
    rdfs:comment "Examples are the net present value, the internal rate of return, the payback period and the benefit-cost ratio. It differs from a cost metric, which expresses costs alone."@en ;
    rdfs:subClassOf :EconomicMetric ;
    skos:definition "An economic metric that compares the revenues or savings of an energy system with its costs."@en .

:ProgrammingLanguage a owl:Class ;
    rdfs:label "Programming language"@en ;
    rdfs:comment "Examples are Python, R and C."@en ;
    rdfs:subClassOf :SoftwareTool ;
    skos:closeMatch schema:ComputerLanguage ;
    skos:definition "A programming language used to implement models or analyses."@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/IAO_0000025> .

:QualitativeAnalysis a owl:Class ;
    rdfs:label "Qualitative analysis"@en ;
    rdfs:comment "Qualitative analysis interprets textual or categorical evidence, for example to identify barriers to renewable energy adoption from stakeholder interviews, surveys or policy documents. It produces categories, themes and explanations rather than numerical estimates."@en ;
    rdfs:subClassOf :Analysis ;
    skos:definition "An analysis of non-numerical information such as interviews, questionnaires, documents or policies."@en .

:RadiativeVariable a owl:Class ;
    rdfs:label "Radiative variable"@en ;
    rdfs:comment "Radiative variables, such as global, direct and diffuse solar radiation, irradiance and sunshine duration, are the basis of solar resource assessment."@en ;
    rdfs:subClassOf :MeteorologicalVariable ;
    skos:definition "A meteorological variable describing solar radiation or sunshine."@en .

:RankingMetric a owl:Class ;
    rdfs:label "Ranking metric"@en ;
    rdfs:comment "An example is the global performance indicator used for solar radiation models."@en ;
    rdfs:subClassOf :EvaluationMetric ;
    skos:definition "An evaluation metric that combines several metrics to rank models or alternatives."@en .

:RecurrentNeuralNetwork a owl:Class ;
    rdfs:label "Recurrent neural network"@en ;
    rdfs:comment "LSTM and GRU networks are recurrent networks widely used to forecast wind and solar time series."@en ;
    rdfs:subClassOf :NeuralNetworkModel ;
    skos:definition "A neural network with recurrent connections that let it retain information from previous time steps."@en .

:RegressionModel a owl:Class ;
    rdfs:label "Regression model"@en ;
    rdfs:comment "Linear, polynomial and multiple regressions are common for estimating solar radiation from sunshine or temperature."@en ;
    rdfs:subClassOf :StatisticalModel ;
    skos:closeMatch <http://purl.obolibrary.org/obo/STATO_0000390> ;
    skos:definition "A statistical model that relates a dependent variable to one or more explanatory variables."@en .

:RegulatoryPolicy a owl:Class ;
    rdfs:label "Regulatory policy"@en ;
    rdfs:comment "Regulatory policies tell actors what they must or must not do, for example a law governing renewable energy licensing or a buffer zone in which wind farms may not be built. They are the \"sticks\" of the classic typology of policy instruments."@en ;
    rdfs:subClassOf :Policy ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00010458> ;
    skos:definition "A policy that sets binding rules, such as laws, regulations, standards or restrictions."@en .

:RemoteSensingInstrument a owl:Class ;
    rdfs:label "Remote sensing instrument"@en ;
    rdfs:comment "Remote sensing instruments, such as satellites, lidar or sodar, infer variables from emitted or reflected signals. They can cover large areas or heights that in situ instruments cannot reach."@en ;
    rdfs:subClassOf :MeasuringInstrument ;
    skos:broadMatch sosa:Sensor ;
    skos:definition "A measuring instrument that measures a variable at a distance, without physical contact."@en .

:RenewableEnergySoftware a owl:Class ;
    rdfs:label "Renewable energy software"@en ;
    rdfs:comment "Examples are HOMER and RETScreen."@en ;
    rdfs:subClassOf :SoftwareTool ;
    skos:definition "A software tool for the techno-economic assessment of renewable energy systems."@en .

:ResourceAnalysis a owl:Class ;
    rdfs:label "Resource analysis"@en ;
    rdfs:comment "Resource analysis is the work of describing a resource from data: its magnitude, its statistical behaviour, its variation in time and its spatial distribution. It produces the quantitative picture of the resource on which further modelling, system design and planning rely."@en ;
    rdfs:subClassOf :StudyObjective ;
    skos:definition "A study objective of characterizing, quantifying or mapping a renewable energy resource."@en .

:ResourceAssessment a owl:Class ;
    rdfs:label "Resource assessment"@en ;
    rdfs:comment "Renewable energy development starts from knowing how much wind, solar or water resource exists at a place and how it varies over time. Resource assessment addresses this question, typically from measured, reanalysis or satellite data, in order to judge whether and where the resource can be exploited."@en ;
    rdfs:subClassOf :ResearchProblem ;
    skos:definition "A research problem concerning the quantification of the renewable energy resource available at given locations."@en .

:ResourceIndicator a owl:Class ;
    rdfs:label "Resource indicator"@en ;
    rdfs:comment "Examples are the wind power density in W/m2, the annual global horizontal irradiation in kWh/m2 and the theoretical hydropower potential. It differs from a system indicator, which describes the output of a given system."@en ;
    rdfs:subClassOf :PerformanceMetric ;
    skos:definition "A performance metric that quantifies the energy resource available at a location, independently of a specific conversion system."@en .

:ResourceModelling a owl:Class ;
    rdfs:label "Resource modelling"@en ;
    rdfs:comment "Renewable resources vary in space and time and are rarely measured everywhere they are needed. Resource modelling addresses how these variables can be described mathematically or estimated from available data, so that the resource can be characterized at locations, heights or times where direct observations are missing or insufficient."@en ;
    rdfs:subClassOf :ResearchProblem ;
    skos:definition "A research problem concerning the representation or estimation of renewable resource variables such as wind speed, solar radiation or streamflow."@en .

:ReviewStudy a owl:Class ;
    rdfs:label "Review study"@en ;
    rdfs:comment "A review study collects, organizes and discusses previously published work on a topic in order to summarize the state of knowledge, identify gaps and point to future research."@en ;
    rdfs:subClassOf :Study ;
    skos:definition "A study that synthesizes existing literature rather than producing new primary results."@en ;
    skos:relatedMatch <http://purl.org/spar/fabio/ReviewArticle> .

:Selection a owl:Class ;
    rdfs:label "Selection"@en ;
    rdfs:comment "Selection is the work of identifying, among several candidates, the site, technology or system configuration that best meets given criteria. It turns analyses of resource, performance or cost into a concrete choice."@en ;
    rdfs:subClassOf :StudyObjective ;
    skos:definition "A study objective of choosing a site, technology or system among alternatives."@en .

:SemiAridClimate a owl:Class ;
    rdfs:label "Semi-arid climate"@en ;
    rdfs:comment "Semi-arid or steppe climates lie between deserts and humid climates. They receive enough rain to support grasses and shrubs, usually concentrated in a short rainy season, as in the Sahelian belt."@en ;
    rdfs:subClassOf :AridClimate ;
    skos:definition "An arid climate with precipitation below potential evaporation but above desert levels (Köppen BS)."@en .

:SocialFactor a owl:Class ;
    rdfs:label "Social factor"@en ;
    rdfs:comment "Social factors are the \"S\" of the PESTEL framework. Examples are energy demand and how it can be managed, public acceptance of projects, and the ability of communities to pay for energy."@en ;
    rdfs:subClassOf :InfluencingFactor ;
    skos:definition "An influencing factor arising from people and society, such as population, behaviour, demand or acceptance."@en .

:SocialImpact a owl:Class ;
    rdfs:label "Social impact"@en ;
    rdfs:comment "Social impacts include rural electrification, household electricity supply, access to drinking water and improvements in living conditions brought by energy projects."@en ;
    rdfs:subClassOf :Impact ;
    skos:definition "An impact on people and communities, such as on access to energy or water, health or well-being."@en .

:SolarEnergy a owl:Class ;
    rdfs:label "Solar energy"@en ;
    rdfs:comment "Solar energy reaches the Earth as radiation, part of which is absorbed or scattered by the atmosphere. It is converted into electricity by photovoltaic or concentrated solar systems, or into heat."@en ;
    rdfs:subClassOf :RenewableEnergyResource ;
    skos:definition "A renewable energy resource consisting of the radiant energy emitted by the Sun."@en ;
    skos:exactMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000384> .

:SolarEnergySoftware a owl:Class ;
    rdfs:label "Solar energy software"@en ;
    rdfs:comment "Examples are PVsyst and PVGIS."@en ;
    rdfs:subClassOf :SoftwareTool ;
    skos:definition "A software tool dedicated to solar energy simulation or assessment."@en .

:SpreadsheetSoftware a owl:Class ;
    rdfs:label "Spreadsheet software"@en ;
    rdfs:comment "An example is Microsoft Excel."@en ;
    rdfs:subClassOf :SoftwareTool ;
    skos:definition "A spreadsheet application."@en .

:StatisticalAnalysis a owl:Class ;
    rdfs:label "Statistical analysis"@en ;
    rdfs:comment "Statistical analysis describes data through summary values, distributions and graphics, or infers properties such as trends, correlations and regressions. In this corpus it typically characterizes resource variables such as wind speed, solar radiation or river flow."@en ;
    rdfs:subClassOf :DataAnalysis ;
    skos:broadMatch <http://purl.obolibrary.org/obo/OBI_0200000> ;
    skos:definition "A data analysis that applies statistical methods to describe data or draw inferences from it."@en .

:StatisticalLibrary a owl:Class ;
    rdfs:label "Statistical library"@en ;
    rdfs:comment "Examples are SciPy.stats and statsmodels in Python, or R packages such as fitdistrplus, used for instance to fit Weibull distributions to wind speed data."@en ;
    rdfs:subClassOf :SoftwareLibrary ;
    skos:definition "A software library that provides statistical methods such as distribution fitting, hypothesis tests or regression."@en .

:StatisticalSoftware a owl:Class ;
    rdfs:label "Statistical software"@en ;
    rdfs:comment "Examples are SPSS and Statgraphics."@en ;
    rdfs:subClassOf :SoftwareTool ;
    skos:definition "A software tool for statistical analysis."@en .

:StatisticalTestMetric a owl:Class ;
    rdfs:label "Statistical test metric"@en ;
    rdfs:comment "Examples are the Kolmogorov-Smirnov and chi-square statistics used to test fitted distributions."@en ;
    rdfs:subClassOf :EvaluationMetric ;
    skos:definition "An evaluation metric that is the statistic or p-value of a statistical test."@en .

:StatisticalVariable a owl:Class ;
    rdfs:label "Statistical variable"@en ;
    rdfs:comment "Examples are the Weibull shape and scale parameters, wind speed probability distributions and standard deviations; they summarize how other variables vary."@en ;
    rdfs:subClassOf :Variable ;
    skos:definition "A variable that describes a statistical property, such as a distribution, a distribution parameter or a probability."@en .

:Strength a owl:Class ;
    rdfs:label "Strength"@en ;
    rdfs:comment "Examples are a high mean wind speed at the site or an abundant river flow. Unlike an opportunity, it belongs to the system being analysed."@en ;
    rdfs:subClassOf :SWOTFactor ;
    skos:definition "A SWOT factor that is an internal characteristic giving an energy resource, project or technology an advantage."@en .

:SupportVectorMachine a owl:Class ;
    rdfs:label "Support vector machine"@en ;
    rdfs:comment "Support vector regression is a common baseline for solar radiation and wind speed estimation."@en ;
    rdfs:subClassOf :KernelBasedModel ;
    skos:definition "A kernel-based model that finds the decision boundary or regression function with the maximum margin."@en ;
    skos:relatedMatch <http://purl.obolibrary.org/obo/OBI_0000700> .

:SystemIndicator a owl:Class ;
    rdfs:label "System indicator"@en ;
    rdfs:comment "Examples are the annual energy production in MWh, the capacity factor and the performance ratio of a PV plant. It differs from a resource indicator, which describes the resource before conversion."@en ;
    rdfs:subClassOf :PerformanceMetric ;
    skos:definition "A performance metric that quantifies the output or efficiency of a specific energy system or component."@en .

:Technique a owl:Class ;
    rdfs:label "Technique"@en ;
    rdfs:comment "A technique is a concrete way of doing something within a study, such as data assimilation, which updates a numerical model with observations. It describes how a step is performed, as distinct from the type of analysis or the model to which it is applied."@en ;
    skos:definition "A practical procedure used to carry out a scientific task."@en .

:TechnologicalFactor a owl:Class ;
    rdfs:label "Technological factor"@en ;
    rdfs:comment "Technological factors are the \"T\" of the PESTEL framework. Examples are turbine characteristics, hub height, wake effects, failures, maintenance and the availability of infrastructure."@en ;
    rdfs:subClassOf :InfluencingFactor ;
    skos:definition "An influencing factor arising from technology, equipment or infrastructure."@en .

:TemporalVariable a owl:Class ;
    rdfs:label "Temporal variable"@en ;
    rdfs:comment "Examples are day length, operation period and the time needed to implement a project."@en ;
    rdfs:subClassOf :Variable ;
    skos:definition "A variable describing a time, a duration or a period."@en .

:TerrainVariable a owl:Class ;
    rdfs:label "Terrain variable"@en ;
    rdfs:comment "Terrain variables, such as elevation, slope or drainage density, are used for site selection and to model how terrain changes wind flow and runoff."@en ;
    rdfs:subClassOf :Variable ;
    skos:definition "A variable describing the shape, elevation or geology of the terrain."@en .

:ThermodynamicVariable a owl:Class ;
    rdfs:label "Thermodynamic variable"@en ;
    rdfs:comment "Thermodynamic variables affect air density, and therefore wind power, as well as the efficiency of photovoltaic modules; they are also predictors of solar radiation."@en ;
    rdfs:subClassOf :MeteorologicalVariable ;
    skos:definition "A meteorological variable describing the thermodynamic state of the air, such as temperature, pressure, density or humidity."@en .

:Threat a owl:Class ;
    rdfs:label "Threat"@en ;
    rdfs:comment "Examples are political instability, droughts reducing river flow or competition from cheap fossil fuels. Unlike a weakness, it lies outside the system being analysed."@en ;
    rdfs:subClassOf :SWOTFactor ;
    skos:definition "A SWOT factor that is an external condition that could harm an energy resource, project or technology."@en .

:TidalEnergy a owl:Class ;
    rdfs:label "Tidal energy"@en ;
    rdfs:comment "It is exploited by barrages using the tidal range or by turbines placed in tidal streams; it is highly predictable compared with wind and wave energy."@en ;
    rdfs:subClassOf :OceanEnergy ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00010100> ;
    skos:definition "An ocean energy resource consisting of the energy of the rise and fall of tides and of tidal currents."@en .

:TransformerNetwork a owl:Class ;
    rdfs:label "Transformer network"@en ;
    rdfs:comment "Transformers are increasingly applied to long-horizon forecasting of renewable generation."@en ;
    rdfs:subClassOf :NeuralNetworkModel ;
    skos:definition "A neural network based on attention mechanisms that relate all positions of a sequence to each other."@en .

:TropicalClimate a owl:Class ;
    rdfs:label "Tropical climate"@en ;
    rdfs:comment "Tropical climates are warm throughout the year, so seasons are defined by rainfall rather than temperature. They include rainforest, monsoon and savanna climates, which differ in the length and intensity of the dry season."@en ;
    rdfs:subClassOf :Climate ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01000204> ;
    skos:definition "A climate in which every month has a mean temperature of at least 18 °C (Köppen group A)."@en .

:Valley a owl:Class ;
    rdfs:label "Valley"@en ;
    rdfs:comment "A valley is a channel in the landscape, often shaped by a river or glacier. It can channel and accelerate winds along its axis and concentrates water flow, which is relevant to both wind and hydropower."@en ;
    rdfs:subClassOf :Terrain ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_00000100> ;
    skos:definition "A terrain formed by an elongated low area between higher ground, usually drained by a river."@en .

:VisualizationLibrary a owl:Class ;
    rdfs:label "Visualization library"@en ;
    rdfs:comment "Examples are Matplotlib, seaborn and ggplot2, used for instance to draw wind roses or irradiance maps."@en ;
    rdfs:subClassOf :SoftwareLibrary ;
    skos:definition "A software library for producing charts, maps or other graphical representations of data."@en .

:WaveEnergy a owl:Class ;
    rdfs:label "Wave energy"@en ;
    rdfs:comment "The resource is usually expressed as wave power per metre of wave crest, in kW/m, and depends on the significant wave height and wave period."@en ;
    rdfs:subClassOf :OceanEnergy ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01003019>,
        <https://openenergyplatform.org/ontology/oeo/OEO_00010102> ;
    skos:definition "An ocean energy resource consisting of the energy carried by surface waves."@en .

:Weakness a owl:Class ;
    rdfs:label "Weakness"@en ;
    rdfs:comment "Examples are the intermittency of solar output or the high upfront cost of a technology. Unlike a threat, it belongs to the system being analysed."@en ;
    rdfs:subClassOf :SWOTFactor ;
    skos:definition "A SWOT factor that is an internal characteristic putting an energy resource, project or technology at a disadvantage."@en .

:WindEnergy a owl:Class ;
    rdfs:label "Wind energy"@en ;
    rdfs:comment "Wind energy comes from air movements driven by uneven heating of the Earth. Its usable amount depends strongly on wind speed, which varies with height, terrain, season and time of day."@en ;
    rdfs:subClassOf :RenewableEnergyResource ;
    skos:definition "A renewable energy resource consisting of the kinetic energy of moving air."@en ;
    skos:exactMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000446> .

:WindEnergySoftware a owl:Class ;
    rdfs:label "Wind energy software"@en ;
    rdfs:comment "Examples are WAsP and Windographer."@en ;
    rdfs:subClassOf :SoftwareTool ;
    skos:definition "A software tool dedicated to wind resource or wind farm assessment."@en .

:WindVariable a owl:Class ;
    rdfs:label "Wind variable"@en ;
    rdfs:comment "Wind variables include wind speed and direction at given heights, wind components, wind power and energy density, and turbulence; they are the basis of wind resource assessment."@en ;
    rdfs:subClassOf :MeteorologicalVariable ;
    skos:definition "A meteorological variable describing the wind."@en .

:aboutApplication a owl:ObjectProperty ;
    rdfs:label "About application"@en ;
    rdfs:comment "For example a finding that a Weibull fit is poor at low wind speeds refers to the Weibull application at that station. aboutModel links to the canonical model instead."@en ;
    rdfs:domain :ConditionalFinding ;
    rdfs:range :ModelApplication ;
    skos:broadMatch <http://purl.obolibrary.org/obo/IAO_0000136> ;
    skos:definition "Relates a conditional finding to the model application that it is about."@en .

:aboutModel a owl:ObjectProperty ;
    rdfs:label "About model"@en ;
    rdfs:comment "For example the model whose accuracy decreases near the coastline."@en ;
    rdfs:domain :ConditionalFinding ;
    rdfs:range :Model ;
    skos:broadMatch <http://purl.obolibrary.org/obo/IAO_0000136> ;
    skos:definition "Relates a conditional finding to the model that it is about."@en .

:addressesFactor a owl:ObjectProperty ;
    rdfs:label "Addresses factor"@en ;
    rdfs:comment "For example, a subsidy addresses the barrier of high initial cost."@en ;
    rdfs:domain :Policy ;
    rdfs:range :InfluencingFactor ;
    skos:definition "Relates a policy to an influencing factor that it addresses."@en .

:affectsEnergyResource a owl:ObjectProperty ;
    rdfs:label "Affects energy resource"@en ;
    rdfs:comment "For example, surface roughness affects the wind energy resource."@en ;
    rdfs:domain :InfluencingFactor ;
    rdfs:range :EnergyResource ;
    skos:definition "Relates an influencing factor to the energy resource that it affects."@en .

:affectsEnergySystem a owl:ObjectProperty ;
    rdfs:label "Affects energy system"@en ;
    rdfs:comment "For example, cut-in and rated wind speeds affect the capacity factor of a wind turbine."@en ;
    rdfs:domain :InfluencingFactor ;
    rdfs:range :EnergySystem ;
    skos:definition "Relates an influencing factor to the energy system that it affects."@en .

:affectsLocation a owl:ObjectProperty ;
    rdfs:label "Affects location"@en ;
    rdfs:comment "It is recorded only when the study ties the factor to a place, for example obstacles in a given city."@en ;
    rdfs:domain :InfluencingFactor ;
    rdfs:range :Location ;
    skos:definition "Relates an influencing factor to the location where it applies."@en .

:analysisConsidersScenario a owl:ObjectProperty ;
    rdfs:label "Analysis considers scenario"@en ;
    rdfs:comment "For example an analysis of future hydropower output under RCP4.5 and RCP8.5 climate scenarios."@en ;
    rdfs:domain :Analysis ;
    rdfs:range :Scenario ;
    skos:definition "Relates an analysis to a scenario that it considers."@en .

:analysisKeyOutcome a owl:DatatypeProperty ;
    rdfs:label "Analysis key outcome"@en ;
    rdfs:comment "For example 'the prevailing wind direction is north-east' or 'monthly irradiation peaks in March'. It summarises one analysis, whereas studyKeyFindings summarises the whole study."@en ;
    rdfs:domain :Analysis ;
    rdfs:range xsd:string ;
    skos:definition "The main result of an analysis as stated in the study."@en .

:analysisMethodDescription a owl:DatatypeProperty ;
    rdfs:label "Analysis method description"@en ;
    rdfs:comment "It can mention the steps, data treatment and software, for example 'hourly wind speeds were binned into 1 m/s classes and averaged by month'."@en ;
    rdfs:domain :Analysis ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "The description of how an analysis was carried out, as reported in the study."@en .

:analysisName a owl:DatatypeProperty ;
    rdfs:label "Analysis name"@en ;
    rdfs:comment "For example 'wind rose analysis', 'trend analysis of annual discharge' or 'sensitivity analysis'."@en ;
    rdfs:domain :Analysis ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of an analysis as reported in the study."@en .

:analysisPurpose a owl:DatatypeProperty ;
    rdfs:label "Analysis purpose"@en ;
    rdfs:comment "For example 'to identify the prevailing wind direction for turbine layout' or 'to detect seasonal variation of solar radiation'."@en ;
    rdfs:domain :Analysis ;
    rdfs:range xsd:string ;
    skos:definition "The purpose of an analysis as stated in the study."@en .

:analysisTechnique a owl:DatatypeProperty ;
    rdfs:label "Analysis technique"@en ;
    rdfs:comment "Examples are the Mann-Kendall test, the analytic hierarchy process, a wind rose or principal component analysis. It names the procedure, while the analysis records its purpose and outcome."@en ;
    rdfs:domain :Analysis ;
    rdfs:range xsd:string ;
    skos:definition "The technique applied in an analysis, as named in the study."@en .

:analysisUsesCriterion a owl:ObjectProperty ;
    rdfs:label "Analysis uses criterion"@en ;
    rdfs:comment "Typical in multi-criteria site selection, for example slope, distance to roads and mean wind speed."@en ;
    rdfs:domain :Analysis ;
    rdfs:range :DecisionCriterion ;
    skos:definition "Relates an analysis to a decision criterion that it uses."@en .

:analysisUsesVariable a owl:ObjectProperty ;
    rdfs:label "Analysis uses variable"@en ;
    rdfs:comment "For example a wind rose analysis uses wind speed and wind direction."@en ;
    rdfs:domain :Analysis ;
    rdfs:range :Variable ;
    skos:definition "Relates an analysis to a variable that it uses."@en .

:analyzesEnergyResource a owl:ObjectProperty ;
    rdfs:label "Analyzes energy resource"@en ;
    rdfs:comment "For example a SWOT analysis of small hydropower in Cameroon analyses hydro energy."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :SWOTAnalysis :Study ) ] ;
    rdfs:range :EnergyResource ;
    skos:definition "Relates a study or SWOT analysis to an energy resource that it analyses."@en .

:applicationArchitecture a owl:DatatypeProperty ;
    rdfs:label "Application architecture"@en ;
    rdfs:comment "For example three hidden layers with ReLU activation."@en ;
    rdfs:domain :ModelApplication ;
    rdfs:range xsd:string ;
    skos:definition "The architecture or configuration of the model in an application, as reported."@en .

:applicationForecastHorizon a owl:DatatypeProperty ;
    rdfs:label "Application forecast horizon"@en ;
    rdfs:comment "For example 1-day-ahead or hourly."@en ;
    rdfs:domain :ModelApplication ;
    rdfs:range xsd:string ;
    skos:definition "The forecast horizon of a predictive application."@en .

:applicationFormulaAsReported a owl:DatatypeProperty ;
    rdfs:label "Application formula as reported"@en ;
    rdfs:comment "It may differ in notation from the canonical formula of the model node."@en ;
    rdfs:domain :ModelApplication ;
    rdfs:range xsd:string ;
    skos:definition "The formula of the model as written in the study for this application."@en .

:applicationHyperparameters a owl:DatatypeProperty ;
    rdfs:label "Application hyperparameters"@en ;
    rdfs:comment "For example the number of neurons, the learning rate or the bin width."@en ;
    rdfs:domain :ModelApplication ;
    rdfs:range xsd:string ;
    skos:definition "The hyperparameters or settings of a model application as reported."@en .

:applicationPurpose a owl:DatatypeProperty ;
    rdfs:label "Application purpose"@en ;
    rdfs:comment "For example fit the wind-speed distribution at a station."@en ;
    rdfs:domain :ModelApplication ;
    rdfs:range xsd:string ;
    skos:definition "The purpose of a model application as stated in the study."@en .

:applicationTemporalScope a owl:DatatypeProperty ;
    rdfs:label "Application temporal scope"@en ;
    rdfs:comment "For example 2010–2014, daily or the test set."@en ;
    rdfs:domain :ModelApplication ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:temporal ;
    skos:definition "The period or time step to which a model application refers."@en .

:applicationUsesScenario a owl:ObjectProperty ;
    rdfs:label "Application uses scenario"@en ;
    rdfs:comment "For example a climate or input-data scenario."@en ;
    rdfs:domain :ModelApplication ;
    rdfs:range :Scenario ;
    skos:definition "Relates a model application to a scenario under which it is run."@en .

:appliedAtLocation a owl:ObjectProperty ;
    rdfs:label "Applied at location"@en ;
    rdfs:comment "For example the station whose wind data are fitted."@en ;
    rdfs:domain :ModelApplication ;
    rdfs:range :Location ;
    skos:broadMatch dcterms:spatial ;
    skos:definition "Relates a model application to a location where the model is applied."@en .

:appliedToVariable a owl:ObjectProperty ;
    rdfs:label "Applied to variable"@en ;
    rdfs:comment "Its domain was widened from DescriptiveApplication to ModelApplication so that every application keeps its variable without wrongly inferring its type."@en ;
    rdfs:domain :ModelApplication ;
    rdfs:range :Variable ;
    skos:definition "Relates a model application to a variable that the model describes or estimates."@en .

:appliesModel a owl:ObjectProperty ;
    rdfs:label "Applies model"@en ;
    rdfs:comment "The model is a canonical node shared by all studies that apply it."@en ;
    rdfs:domain :ModelApplication ;
    rdfs:range :Model ;
    skos:broadMatch prov:used ;
    skos:definition "Relates a model application to the model that it applies."@en .

:appliesToCountry a owl:ObjectProperty ;
    rdfs:label "Applies to country"@en ;
    rdfs:comment "It is used when a policy or target is national, so that it can be linked to the Country entity even when the study has no country-level location."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Policy :PolicyTarget ) ] ;
    rdfs:range :Country ;
    skos:definition "Relates a policy or policy target to the country in which it applies."@en .

:appliesToLocation a owl:ObjectProperty ;
    rdfs:label "Applies to location"@en ;
    rdfs:comment "It is used for local policies; national policies are linked with appliesToCountry."@en ;
    rdfs:domain :Policy ;
    rdfs:range :Location ;
    skos:definition "Relates a policy to a location where it applies."@en .

:assessedInStudy a owl:ObjectProperty ;
    rdfs:label "Assessed in study"@en ;
    rdfs:comment "A study may use a policy as context, as a constraint or as a recommendation."@en ;
    rdfs:domain :Policy ;
    rdfs:range :Study ;
    skos:definition "Relates a policy to the study that assesses or reports it."@en .

:assessesEnergySystem a owl:ObjectProperty ;
    rdfs:label "Assesses energy system"@en ;
    rdfs:comment "A study may assess several systems, for example several commercial turbine models at the same site."@en ;
    rdfs:domain :Study ;
    rdfs:range :EnergySystem ;
    skos:definition "Relates a study to an energy system that it assesses, designs or simulates."@en .

:atLocation a owl:ObjectProperty ;
    rdfs:label "At location"@en ;
    rdfs:comment "Its domain was widened from DerivedValue so that parameter values and evaluation results keep the station or site they were obtained for."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DerivedValue :ParameterValue :EvaluationResult ) ] ;
    rdfs:range :Location ;
    skos:broadMatch dcterms:spatial ;
    skos:definition "Relates a derived value, parameter value or evaluation result to the location to which it refers."@en .

:belongsToDesignCharacteristics a owl:ObjectProperty ;
    rdfs:label "Belongs to design characteristics"@en ;
    rdfs:comment "It attaches values without a dedicated property, such as inverter efficiency, to the design characteristics of a component."@en ;
    rdfs:domain :DesignParameterValue ;
    rdfs:range :DesignCharacteristics ;
    skos:definition "Relates a design parameter value to the set of design characteristics that it belongs to."@en .

:calorificValue a owl:DatatypeProperty ;
    rdfs:label "Calorific value"@en ;
    rdfs:comment "It is the energy released per unit mass when the fuel burns, typically 15–20 MJ/kg for dry wood; the unit is given by hasCalorificValueUnit."@en ;
    rdfs:domain :BiomassDesignCharacteristics ;
    rdfs:range xsd:decimal ;
    skos:definition "The calorific value of the fuel described by biomass design characteristics."@en .

:cellTechnology a owl:DatatypeProperty ;
    rdfs:label "Cell technology"@en ;
    rdfs:comment "Examples are monocrystalline silicon, polycrystalline silicon, CdTe and CIGS thin film."@en ;
    rdfs:domain :SolarDesignCharacteristics ;
    rdfs:range xsd:string ;
    skos:definition "The photovoltaic cell technology of a solar module described by solar design characteristics."@en .

:characterizationExceedanceProbability a owl:DatatypeProperty ;
    rdfs:label "Characterization exceedance probability"@en ;
    rdfs:comment "It is used notably in flow duration curves for hydropower, where Q90 is the discharge exceeded 90% of the time. Its unit is given by hasExceedanceProbabilityUnit."@en ;
    rdfs:domain :ResourceCharacterization ;
    rdfs:range xsd:decimal ;
    skos:definition "The probability that the characterized variable equals or exceeds the reported value."@en .

:characterizationKurtosis a owl:DatatypeProperty ;
    rdfs:label "Characterization kurtosis"@en ;
    rdfs:comment "A high kurtosis indicates that extreme values occur more often than in a normal distribution. It is dimensionless."@en ;
    rdfs:domain :ResourceCharacterization ;
    rdfs:range xsd:decimal ;
    skos:definition "A measure of the tailedness of the distribution of the characterized variable."@en .

:characterizationMaximumValue a owl:DatatypeProperty ;
    rdfs:label "Characterization maximum value"@en ;
    rdfs:comment "Depending on the study, it is the maximum of the raw series or of aggregated values, such as the highest monthly mean; the temporal resolution tells which."@en ;
    rdfs:domain :ResourceCharacterization ;
    rdfs:range xsd:decimal ;
    skos:definition "The largest value of the characterized variable reported over the period."@en .

:characterizationMeanValue a owl:DatatypeProperty ;
    rdfs:label "Characterization mean value"@en ;
    rdfs:comment "The mean is the value most often reported in resource assessment, such as the mean wind speed or the mean river discharge. It is expressed in the unit given by hasUnit."@en ;
    rdfs:domain :ResourceCharacterization ;
    rdfs:range xsd:decimal ;
    skos:definition "The arithmetic mean of the characterized variable over the reported period."@en .

:characterizationMeasurementHeight a owl:DatatypeProperty ;
    rdfs:label "Characterization measurement height"@en ;
    rdfs:comment "Wind speed varies strongly with height, so values are comparable only at the same height. The height is expressed in the unit given by hasMeasurementHeightUnit and measured from the level given by hasReferencePlane."@en ;
    rdfs:domain :ResourceCharacterization ;
    rdfs:range xsd:decimal ;
    skos:definition "The height at which the characterized variable was measured or estimated."@en .

:characterizationMinimumValue a owl:DatatypeProperty ;
    rdfs:label "Characterization minimum value"@en ;
    rdfs:comment "Depending on the study, it is the minimum of the raw series or of aggregated values, such as the lowest monthly mean; the temporal resolution tells which."@en ;
    rdfs:domain :ResourceCharacterization ;
    rdfs:range xsd:decimal ;
    skos:definition "The smallest value of the characterized variable reported over the period."@en .

:characterizationPeriodEnd a owl:DatatypeProperty ;
    rdfs:label "Characterization period end"@en ;
    rdfs:comment "With characterizationPeriodStart, it tells how long the record is; short records may not represent the long-term resource."@en ;
    rdfs:domain :ResourceCharacterization ;
    rdfs:range xsd:gYear ;
    skos:closeMatch dcat:endDate ;
    skos:definition "The last year of the period over which the characterization was computed."@en .

:characterizationPeriodStart a owl:DatatypeProperty ;
    rdfs:label "Characterization period start"@en ;
    rdfs:comment "With characterizationPeriodEnd, it tells how long the record is; short records may not represent the long-term resource."@en ;
    rdfs:domain :ResourceCharacterization ;
    rdfs:range xsd:gYear ;
    skos:closeMatch dcat:startDate ;
    skos:definition "The first year of the period over which the characterization was computed."@en .

:characterizationSkewness a owl:DatatypeProperty ;
    rdfs:label "Characterization skewness"@en ;
    rdfs:comment "A positive skewness indicates a longer tail of high values, which is typical of wind speed distributions. It is dimensionless."@en ;
    rdfs:domain :ResourceCharacterization ;
    rdfs:range xsd:decimal ;
    skos:definition "A measure of the asymmetry of the distribution of the characterized variable."@en .

:characterizationStandardDeviation a owl:DatatypeProperty ;
    rdfs:label "Characterization standard deviation"@en ;
    rdfs:comment "The standard deviation measures how much the values spread around the mean; a high value indicates a variable resource. It is expressed in the unit given by hasUnit."@en ;
    rdfs:domain :ResourceCharacterization ;
    rdfs:range xsd:decimal ;
    skos:definition "The standard deviation of the characterized variable over the reported period."@en .

:characterizesEnergyResource a owl:ObjectProperty ;
    rdfs:label "Characterizes energy resource"@en ;
    rdfs:comment "For example, wind speed characterizes wind energy and global solar radiation characterizes solar energy; the link is set for every variable of these kinds."@en ;
    rdfs:domain :Variable ;
    rdfs:range :EnergyResource ;
    skos:definition "Relates a variable to the energy resource that it characterizes."@en .

:characterizesLocation a owl:ObjectProperty ;
    rdfs:label "Characterizes location"@en ;
    rdfs:comment "It allows the resource values reported by different studies for the same place to be compared."@en ;
    rdfs:domain :ResourceCharacterization ;
    rdfs:range :Location ;
    skos:definition "Relates a resource characterization to the location whose resource it describes."@en .

:characterizesVariable a owl:ObjectProperty ;
    rdfs:label "Characterizes variable"@en ;
    rdfs:comment "Examples of variables are wind speed, wind power density, global horizontal irradiance and river discharge."@en ;
    rdfs:domain :ResourceCharacterization ;
    rdfs:range :Variable ;
    skos:definition "Relates a resource characterization to the variable that it describes."@en .

:climateDescription a owl:DatatypeProperty ;
    rdfs:label "Climate description"@en ;
    rdfs:comment "For example 'tropical savanna with a dry season from November to March'."@en ;
    rdfs:domain :Climate ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "The textual description of a climate as reported in a study."@en .

:climateName a owl:DatatypeProperty ;
    rdfs:label "Climate name"@en ;
    rdfs:comment "For example 'tropical monsoon' or 'Köppen Aw'. The class of the climate node gives its normalised Köppen group."@en ;
    rdfs:domain :Climate ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of a climate as reported in a study."@en .

:collectedAt a owl:ObjectProperty ;
    rdfs:label "Collected at"@en ;
    rdfs:comment "For example a station dataset collected at Douala airport. For gridded datasets it is the area covered."@en ;
    rdfs:domain :Dataset ;
    rdfs:range :Location ;
    skos:broadMatch dcterms:spatial ;
    skos:definition "Relates a dataset to a location at which its data were collected."@en .

:collectedWithInstrument a owl:ObjectProperty ;
    rdfs:label "Collected with instrument"@en ;
    rdfs:comment "For example a cup anemometer, a pyranometer or a lidar."@en ;
    rdfs:domain :Dataset ;
    rdfs:range :MeasuringInstrument ;
    skos:closeMatch sosa:madeBySensor ;
    skos:definition "Relates a dataset to a measuring instrument with which its data were collected."@en .

:combinesModel a owl:ObjectProperty ;
    rdfs:label "Combines model"@en ;
    rdfs:comment "For example a hybrid model combines a neural network with an optimization algorithm, or a mixture combines component distributions."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :HybridModel :Model ) ] ;
    rdfs:range :Model ;
    skos:broadMatch <http://purl.obolibrary.org/obo/BFO_0000051> ;
    skos:definition "Relates a model to another model that it combines."@en .

:combinesSystem a owl:ObjectProperty ;
    rdfs:label "Combines system"@en ;
    rdfs:comment "It is used when the combined systems, such as a PV plant and a wind turbine, are described separately."@en ;
    rdfs:domain :HybridEnergySystem ;
    rdfs:range :EnergySystem ;
    skos:broadMatch <http://purl.obolibrary.org/obo/BFO_0000051> ;
    skos:definition "Relates a hybrid energy system to an energy system that it combines."@en .

:comparedWithModel a owl:ObjectProperty ;
    rdfs:label "Compared with model"@en ;
    rdfs:comment "It records explicit comparisons such as model X performs better than model Y under a condition."@en ;
    rdfs:domain :ConditionalFinding ;
    rdfs:range :Model ;
    skos:definition "Relates a conditional finding to a model with which the model of the finding is compared."@en .

:componentCategory a owl:DatatypeProperty ;
    rdfs:label "Component category"@en ;
    rdfs:comment "For example 'turbine', 'inverter', 'battery' or 'PV module'. It applies to physical components, not to mixture components."@en ;
    rdfs:domain :EnergySystemComponent ;
    rdfs:range xsd:string ;
    skos:definition "The category of an energy system component as reported."@en .

:componentDescription a owl:DatatypeProperty ;
    rdfs:label "Component description"@en ;
    rdfs:comment "For example 'three-bladed upwind turbine with permanent-magnet generator'."@en ;
    rdfs:domain :EnergySystemComponent ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "The textual description of an energy system component."@en .

:componentIndex a owl:DatatypeProperty ;
    rdfs:label "Component index"@en ;
    rdfs:comment "Components are numbered 1, 2, ... so that weights and parameters of a two-component Weibull mixture can be matched to the right component."@en ;
    rdfs:domain :MixtureComponent ;
    rdfs:range xsd:integer ;
    skos:definition "The position number of a mixture component within a mixture distribution."@en .

:componentManufacturer a owl:DatatypeProperty ;
    rdfs:label "Component manufacturer"@en ;
    rdfs:comment "For example Vestas, Enercon or Siemens Gamesa for wind turbines, or Jinko Solar for PV modules."@en ;
    rdfs:domain :EnergySystemComponent ;
    rdfs:range xsd:string ;
    skos:closeMatch schema:manufacturer ;
    skos:definition "The manufacturer of an energy system component."@en .

:componentModelType a owl:ObjectProperty ;
    rdfs:label "Component model type"@en ;
    rdfs:comment "For example the first component of a Weibull–Gamma mixture is a Weibull distribution."@en ;
    rdfs:domain :MixtureComponent ;
    rdfs:range :Model ;
    skos:definition "Relates a mixture component to the model that gives its distribution."@en .

:componentName a owl:DatatypeProperty ;
    rdfs:label "Component name"@en ;
    rdfs:comment "For example 'Vestas V90-2.0 MW' or 'Bergey Excel 10'."@en ;
    rdfs:domain :EnergySystemComponent ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name or model designation of an energy system component."@en .

:componentQuantity a owl:DatatypeProperty ;
    rdfs:label "Component quantity"@en ;
    rdfs:comment "For example 25 turbines in a wind farm or 400 PV modules in an array."@en ;
    rdfs:domain :EnergySystemComponent ;
    rdfs:range xsd:integer ;
    skos:definition "The number of identical units of an energy system component in an energy system."@en .

:componentWeight a owl:DatatypeProperty ;
    rdfs:label "Component weight"@en ;
    rdfs:comment "It is a value between 0 and 1, and the weights of all components of a mixture sum to 1."@en ;
    rdfs:domain :MixtureComponent ;
    rdfs:range xsd:decimal ;
    skos:definition "The mixing weight of a mixture component within a mixture distribution."@en .

:concernsEnergyResource a owl:ObjectProperty ;
    rdfs:label "Concerns energy resource"@en ;
    rdfs:comment "For example the factor 'high seasonal variability of river flow' concerns hydro energy."@en ;
    rdfs:domain :SWOTFactor ;
    rdfs:range :EnergyResource ;
    skos:definition "Relates a SWOT factor to the energy resource that it concerns."@en .

:conditionOperator a owl:DatatypeProperty ;
    rdfs:label "Condition operator"@en ;
    rdfs:comment "Values are for example '<', '>=', '=' or 'between', as in 'wind speed < 5 m/s'."@en ;
    rdfs:domain :Condition ;
    rdfs:range xsd:string ;
    skos:definition "The comparison operator that relates the condition variable to the condition value."@en .

:conditionScope a owl:DatatypeProperty ;
    rdfs:label "Condition scope"@en ;
    rdfs:comment "For example a spatial scope (certain stations), a temporal scope (dry season) or a data scope (sample size)."@en ;
    rdfs:domain :Condition ;
    rdfs:range xsd:string ;
    skos:definition "The aspect of a study to which a condition applies."@en .

:conditionStatement a owl:DatatypeProperty ;
    rdfs:label "Condition statement"@en ;
    rdfs:comment "For example 'for sites with mean wind speeds below 4 m/s' or 'during the rainy season'."@en ;
    rdfs:domain :Condition ;
    rdfs:range xsd:string ;
    skos:definition "The condition under which a finding holds, stated as text."@en .

:conditionType a owl:DatatypeProperty ;
    rdfs:label "Condition type"@en ;
    rdfs:comment "Examples are wind speed range, terrain type, season, measurement height or data length."@en ;
    rdfs:domain :Condition ;
    rdfs:range xsd:string ;
    skos:definition "The type of a condition."@en .

:conditionValue a owl:DatatypeProperty ;
    rdfs:label "Condition value"@en ;
    rdfs:comment "For example '5 m/s', '50 m' or 'June–September'; it is stored as text because it may be a range or category."@en ;
    rdfs:domain :Condition ;
    rdfs:range xsd:string ;
    skos:definition "The value or range that the condition variable must satisfy."@en .

:conditionVariable a owl:DatatypeProperty ;
    rdfs:label "Condition variable"@en ;
    rdfs:comment "For example wind speed, skewness of the data or altitude."@en ;
    rdfs:domain :Condition ;
    rdfs:range xsd:string ;
    skos:definition "The variable constrained by a condition."@en .

:conductedAt a owl:ObjectProperty ;
    rdfs:label "Conducted at"@en ;
    rdfs:comment "It is the study area, such as a city, region, river basin or country, not the affiliation of the authors."@en ;
    rdfs:domain :Study ;
    rdfs:range :Location ;
    skos:broadMatch dcterms:spatial ;
    skos:definition "Relates a study to a location at which it was conducted."@en .

:consumesEnergyCarrier a owl:ObjectProperty ;
    rdfs:label "Consumes energy carrier"@en ;
    rdfs:comment "For example an electrolyser consumes electricity to produce hydrogen. Energy resources found in nature, such as wind, are linked with usesEnergyResource instead."@en ;
    rdfs:domain :EnergySystem ;
    rdfs:range :EnergyCarrier ;
    skos:broadMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000532> ;
    skos:definition "Relates an energy system to an energy carrier that it consumes."@en .

:conversionTechnology a owl:DatatypeProperty ;
    rdfs:label "Conversion technology"@en ;
    rdfs:comment "Examples are direct combustion, gasification, pyrolysis and anaerobic digestion."@en ;
    rdfs:domain :BiomassDesignCharacteristics ;
    rdfs:range xsd:string ;
    skos:definition "The technology used to convert biomass into useful energy, as described by biomass design characteristics."@en .

:coolantType a owl:DatatypeProperty ;
    rdfs:label "Coolant type"@en ;
    rdfs:comment "Examples are light water, heavy water, helium gas and liquid sodium."@en ;
    rdfs:domain :NuclearDesignCharacteristics ;
    rdfs:range xsd:string ;
    skos:definition "The coolant used to remove heat from the reactor described by nuclear design characteristics."@en .

:countryIsoCode a owl:DatatypeProperty ;
    rdfs:label "Country ISO code"@en ;
    rdfs:comment "For example CMR for Cameroon or DEU for Germany. Use it rather than the name to match countries across sources."@en ;
    rdfs:domain :Country ;
    rdfs:range xsd:string ;
    skos:definition "The ISO 3166-1 alpha-3 code of a country."@en .

:countryName a owl:DatatypeProperty ;
    rdfs:label "Country name"@en ;
    rdfs:comment "For example 'Cameroon' or 'Nigeria'. Names vary between sources, so countryIsoCode is preferred for matching."@en ;
    rdfs:domain :Country ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The common English name of a country."@en .

:criterionDirection a owl:DatatypeProperty ;
    rdfs:label "Criterion direction"@en ;
    rdfs:comment "Values are typically 'benefit' or 'maximize' (for example wind speed or irradiation) and 'cost' or 'minimize' (for example slope or distance to the grid)."@en ;
    rdfs:domain :DecisionCriterion ;
    rdfs:range xsd:string ;
    skos:definition "Whether higher or lower values of a decision criterion are preferred."@en .

:criterionEvaluatesVariable a owl:ObjectProperty ;
    rdfs:label "Criterion evaluates variable"@en ;
    rdfs:comment "For example the criterion 'wind resource' evaluates mean wind speed at 50 m."@en ;
    rdfs:domain :DecisionCriterion ;
    rdfs:range :Variable ;
    skos:definition "Relates a decision criterion to the variable that it evaluates."@en .

:criterionName a owl:DatatypeProperty ;
    rdfs:label "Criterion name"@en ;
    rdfs:comment "For example 'slope', 'distance to roads', 'mean wind speed' or 'land use'."@en ;
    rdfs:domain :DecisionCriterion ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of a decision criterion as reported in the study."@en .

:criterionRationale a owl:DatatypeProperty ;
    rdfs:label "Criterion rationale"@en ;
    rdfs:comment "For example 'steep slopes increase construction costs'."@en ;
    rdfs:domain :DecisionCriterion ;
    rdfs:range xsd:string ;
    skos:definition "The reason given in the study for using a decision criterion."@en .

:criterionThreshold a owl:DatatypeProperty ;
    rdfs:label "Criterion threshold"@en ;
    rdfs:comment "For example a slope above 5% or a distance to the grid above 10 km excludes a site; the unit is given by hasThresholdUnit."@en ;
    rdfs:domain :DecisionCriterion ;
    rdfs:range xsd:decimal ;
    skos:definition "The threshold value of a decision criterion used to include or exclude alternatives."@en .

:criterionWeight a owl:DatatypeProperty ;
    rdfs:label "Criterion weight"@en ;
    rdfs:comment "Weights are often derived with the analytic hierarchy process and expressed as fractions or percentages summing to 1 or 100."@en ;
    rdfs:domain :DecisionCriterion ;
    rdfs:range xsd:decimal ;
    skos:definition "The relative importance of a decision criterion in a multi-criteria analysis."@en .

:datasetContainsObservation a owl:ObjectProperty ;
    rdfs:label "Dataset contains observation"@en ;
    rdfs:comment "Only observations reported in the paper are represented, not every record of the dataset."@en ;
    rdfs:domain :Dataset ;
    rdfs:range :Observation ;
    skos:broadMatch dcterms:hasPart ;
    skos:definition "Relates a dataset to an observation that it contains."@en .

:datasetDescription a owl:DatatypeProperty ;
    rdfs:label "Dataset description"@en ;
    rdfs:comment "For example 'hourly 10 m wind speed measured at Garoua airport from 2005 to 2015'."@en ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "The textual description of a dataset."@en .

:datasetDuration a owl:DatatypeProperty ;
    rdfs:label "Dataset duration"@en ;
    rdfs:comment "For example '10 years' or '18 months'; the start and end years are given separately."@en ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:string ;
    skos:definition "The length of the period covered by a dataset, as reported."@en .

:datasetMeasurementHeight a owl:DatatypeProperty ;
    rdfs:label "Dataset measurement height"@en ;
    rdfs:comment "For wind data it is commonly 10 m, or the mast or hub height; the unit is given by hasMeasurementHeightUnit."@en ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:decimal ;
    skos:definition "The height at which the data of a dataset were measured."@en .

:datasetName a owl:DatatypeProperty ;
    rdfs:label "Dataset name"@en ;
    rdfs:comment "For example 'ERA5', 'NASA POWER', 'MERRA-2' or the name of a meteorological station record."@en ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:title ;
    skos:definition "The name of a dataset."@en .

:datasetNumberOfTimeSeries a owl:DatatypeProperty ;
    rdfs:label "Dataset number of time series"@en ;
    rdfs:comment "For example the number of stations or grid points for which a series is provided."@en ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:integer ;
    skos:definition "The number of time series contained in a dataset."@en .

:datasetPeriodEnd a owl:DatatypeProperty ;
    rdfs:label "Dataset period end"@en ;
    rdfs:comment "It is given as a year, for example 2020."@en ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:gYear ;
    skos:closeMatch dcat:endDate ;
    skos:definition "The last year covered by a dataset."@en .

:datasetPeriodStart a owl:DatatypeProperty ;
    rdfs:label "Dataset period start"@en ;
    rdfs:comment "It is given as a year, for example 1990."@en ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:gYear ;
    skos:closeMatch dcat:startDate ;
    skos:definition "The first year covered by a dataset."@en .

:datasetSource a owl:DatatypeProperty ;
    rdfs:label "Dataset source"@en ;
    rdfs:comment "For example a national meteorological service, ECMWF, NASA or an on-site measurement campaign."@en ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:string ;
    skos:closeMatch dcterms:source ;
    skos:definition "The provider or origin of a dataset."@en .

:datasetSpatialResolution a owl:DatatypeProperty ;
    rdfs:label "Dataset spatial resolution"@en ;
    rdfs:comment "For example '0.25° x 0.25°' for ERA5 or '0.5° x 0.625°' for MERRA-2; it is not applicable to single-station data."@en ;
    rdfs:domain :Dataset ;
    rdfs:range xsd:string ;
    skos:closeMatch dcat:spatialResolutionInMeters ;
    skos:definition "The spatial resolution of a gridded dataset, as reported."@en .

:decisionRuleAsReported a owl:DatatypeProperty ;
    rdfs:label "Decision rule as reported"@en ;
    rdfs:comment "For example 'the distribution with the lowest RMSE is selected' or 'the model is accepted when p > 0.05'."@en ;
    rdfs:domain :EvaluationResult ;
    rdfs:range xsd:string ;
    skos:definition "The rule used in the study to decide which model or alternative is best, as reported."@en .

:derivedFromDataset a owl:ObjectProperty ;
    rdfs:label "Derived from dataset"@en ;
    rdfs:comment "It records the provenance of a resource characterization or a derived value, such as a station record, a reanalysis or a satellite product, which helps judge how reliable the value is."@en ;
    rdfs:domain :DerivedValue,
        :ResourceCharacterization ;
    rdfs:range :Dataset ;
    skos:broadMatch prov:wasDerivedFrom ;
    skos:definition "Relates a value to the dataset from which it was computed."@en .

:derivedFromModel a owl:ObjectProperty ;
    rdfs:label "Derived from model"@en ;
    rdfs:comment "For example a modified version of an empirical model is derived from the original."@en ;
    rdfs:domain :Model ;
    rdfs:range :Model ;
    skos:broadMatch prov:wasDerivedFrom ;
    skos:definition "Relates a model to the model from which it is derived."@en .

:derivedFromVariable a owl:ObjectProperty ;
    rdfs:label "Derived from variable"@en ;
    rdfs:comment "For example, wind power density is derived from wind speed and air density."@en ;
    rdfs:domain :Variable ;
    rdfs:range :Variable ;
    skos:broadMatch prov:wasDerivedFrom ;
    skos:definition "Relates a variable to another variable from which it is derived."@en .

:derivedValueMagnitude a owl:DatatypeProperty ;
    rdfs:label "Derived value magnitude"@en ;
    rdfs:comment "It is text so that values such as '250–300' or '>400' can be kept; the unit is given by hasUnit."@en ;
    rdfs:domain :DerivedValue ;
    rdfs:range xsd:string ;
    skos:definition "The magnitude of a derived value as reported, possibly with a range."@en .

:derivedValueTemporalScope a owl:DatatypeProperty ;
    rdfs:label "Derived value temporal scope"@en ;
    rdfs:comment "For example 'annual', 'January' or '2010–2015'."@en ;
    rdfs:domain :DerivedValue ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:temporal ;
    skos:definition "The period or time step to which a derived value refers."@en .

:derivedValueType a owl:DatatypeProperty ;
    rdfs:label "Derived value type"@en ;
    rdfs:comment "Examples are mean wind power density, most probable wind speed, wind speed carrying maximum energy and mean energy output."@en ;
    rdfs:domain :DerivedValue ;
    rdfs:range xsd:string ;
    skos:definition "The type of a derived value."@en .

:designParameterName a owl:DatatypeProperty ;
    rdfs:label "Design parameter name"@en ;
    rdfs:comment "For example 'inverter efficiency', 'penstock length' or 'number of turbines'."@en ;
    rdfs:domain :DesignParameterValue ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of the design parameter whose value is recorded."@en .

:designParameterTemporalScope a owl:DatatypeProperty ;
    rdfs:label "Design parameter temporal scope"@en ;
    rdfs:comment "For example 'rated conditions', 'year 1' or 'dry season'."@en ;
    rdfs:domain :DesignParameterValue ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:temporal ;
    skos:definition "The period or condition to which a design parameter value refers."@en .

:designParameterValue a owl:DatatypeProperty ;
    rdfs:label "Design parameter value"@en ;
    rdfs:comment "It is text so that ranges or qualitative values can be kept; the unit is given by hasUnit. Do not confuse this property with the class DesignParameterValue."@en ;
    rdfs:domain :DesignParameterValue ;
    rdfs:range xsd:string ;
    skos:closeMatch <http://qudt.org/schema/qudt/value> ;
    skos:definition "The value of a design parameter, as reported."@en .

:distributionFormula a owl:DatatypeProperty ;
    rdfs:label "Distribution formula"@en ;
    rdfs:comment "It is given for every canonical distribution, so that studies that do not report it inherit it."@en ;
    rdfs:domain :ProbabilityDistributionModel ;
    rdfs:range xsd:string ;
    skos:definition "The standard probability density function of a probability distribution."@en .

:distributionNumberOfParameters a owl:DatatypeProperty ;
    rdfs:label "Distribution number of parameters"@en ;
    rdfs:comment "For example 2 for the Weibull distribution and 3 for the three-parameter Weibull distribution."@en ;
    rdfs:domain :ProbabilityDistributionModel ;
    rdfs:range xsd:integer ;
    skos:definition "The number of parameters of a probability distribution."@en .

:distributionParameters a owl:DatatypeProperty ;
    rdfs:label "Distribution parameters"@en ;
    rdfs:comment "For example k: shape parameter ; c: scale parameter for the Weibull distribution."@en ;
    rdfs:domain :ProbabilityDistributionModel ;
    rdfs:range xsd:string ;
    skos:definition "The parameters of a probability distribution, with their meaning."@en .

:economicMetricCostAssumption a owl:DatatypeProperty ;
    rdfs:label "Economic metric cost assumption"@en ;
    rdfs:comment "For example 'capital cost 1,500 USD/kW, O&M 2% of capital cost per year'."@en ;
    rdfs:domain :EconomicMetric ;
    rdfs:range xsd:string ;
    skos:definition "The cost assumptions used to compute an economic metric."@en .

:economicMetricCurrency a owl:DatatypeProperty ;
    rdfs:label "Economic metric currency"@en ;
    rdfs:comment "For example USD, EUR or XAF, preferably as an ISO 4217 code."@en ;
    rdfs:domain :EconomicMetric ;
    rdfs:range xsd:string ;
    skos:definition "The currency in which an economic metric is expressed."@en .

:economicMetricDescription a owl:DatatypeProperty ;
    rdfs:label "Economic metric description"@en ;
    rdfs:comment "For example 'cost of each kWh produced over the lifetime of the plant'."@en ;
    rdfs:domain :EconomicMetric ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "The textual description of an economic metric as reported."@en .

:economicMetricEvaluationPeriod a owl:DatatypeProperty ;
    rdfs:label "Economic metric evaluation period"@en ;
    rdfs:comment "For example the project lifetime of 20 or 25 years."@en ;
    rdfs:domain :EconomicMetric ;
    rdfs:range xsd:string ;
    skos:definition "The period over which an economic metric is computed."@en .

:economicMetricFormula a owl:DatatypeProperty ;
    rdfs:label "Economic metric formula"@en ;
    rdfs:comment "For example LCOE = (sum of discounted costs) / (sum of discounted energy)."@en ;
    rdfs:domain :EconomicMetric ;
    rdfs:range xsd:string ;
    skos:closeMatch <http://qudt.org/schema/qudt/latexDefinition> ;
    skos:definition "The formula used to compute an economic metric, as reported."@en .

:economicMetricMaximumValue a owl:DatatypeProperty ;
    rdfs:label "Economic metric maximum value"@en ;
    rdfs:comment "It is used when the study gives a range, for example an LCOE between 0.08 and 0.15 USD/kWh; the unit is given by hasUnit."@en ;
    rdfs:domain :EconomicMetric ;
    rdfs:range xsd:decimal ;
    skos:definition "The highest value of an economic metric reported across sites, scenarios or systems."@en .

:economicMetricMinimumValue a owl:DatatypeProperty ;
    rdfs:label "Economic metric minimum value"@en ;
    rdfs:comment "It is used when the study gives a range; the unit is given by hasUnit."@en ;
    rdfs:domain :EconomicMetric ;
    rdfs:range xsd:decimal ;
    skos:definition "The lowest value of an economic metric reported across sites, scenarios or systems."@en .

:economicMetricName a owl:DatatypeProperty ;
    rdfs:label "Economic metric name"@en ;
    rdfs:comment "For example 'levelised cost of energy', 'net present value' or 'simple payback period'."@en ;
    rdfs:domain :EconomicMetric ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of an economic metric as reported."@en .

:economicMetricParameters a owl:DatatypeProperty ;
    rdfs:label "Economic metric parameters"@en ;
    rdfs:comment "For example the discount rate, lifetime, capital cost and electricity tariff."@en ;
    rdfs:domain :EconomicMetric ;
    rdfs:range xsd:string ;
    skos:definition "The parameters entering the computation of an economic metric."@en .

:economicMetricPriceAssumption a owl:DatatypeProperty ;
    rdfs:label "Economic metric price assumption"@en ;
    rdfs:comment "For example the electricity selling price, the feed-in tariff or the diesel price."@en ;
    rdfs:domain :EconomicMetric ;
    rdfs:range xsd:string ;
    skos:definition "The price assumptions used to compute an economic metric."@en .

:economicMetricResultSummary a owl:DatatypeProperty ;
    rdfs:label "Economic metric result summary"@en ;
    rdfs:comment "For example 'the hybrid system has the lowest LCOE at all sites'."@en ;
    rdfs:domain :EconomicMetric ;
    rdfs:range xsd:string ;
    skos:definition "A summary of the results reported for an economic metric."@en .

:economicMetricType a owl:DatatypeProperty ;
    rdfs:label "Economic metric type"@en ;
    rdfs:comment "For example cost metric or profitability metric, or the specific kind such as LCOE, NPV, IRR or payback period."@en ;
    rdfs:domain :EconomicMetric ;
    rdfs:range xsd:string ;
    skos:definition "The type of an economic metric."@en .

:economicMetricValue a owl:DatatypeProperty ;
    rdfs:label "Economic metric value"@en ;
    rdfs:comment "For example an LCOE of 0.12 USD/kWh or a payback period of 7 years; the unit is given by hasUnit and the currency by economicMetricCurrency."@en ;
    rdfs:domain :EconomicMetric ;
    rdfs:range xsd:decimal ;
    skos:closeMatch <http://qudt.org/schema/qudt/value> ;
    skos:definition "The value of an economic metric reported in a study."@en .

:electrolyserEfficiencyValue a owl:DatatypeProperty ;
    rdfs:label "Electrolyser efficiency value"@en ;
    rdfs:comment "It is often 60–80% on a lower-heating-value basis, or expressed as specific consumption in kWh/kg; the unit is given by hasElectrolyserEfficiencyUnit."@en ;
    rdfs:domain :HydrogenPlantDesignCharacteristics ;
    rdfs:range xsd:decimal ;
    skos:definition "The efficiency of the electrolyser described by hydrogen plant design characteristics."@en .

:electrolyserType a owl:DatatypeProperty ;
    rdfs:label "Electrolyser type"@en ;
    rdfs:comment "Examples are alkaline, proton exchange membrane (PEM) and solid oxide electrolysers."@en ;
    rdfs:domain :HydrogenPlantDesignCharacteristics ;
    rdfs:range xsd:string ;
    skos:definition "The type of electrolyser described by hydrogen plant design characteristics."@en .

:empiricalModelApplicabilityConditions a owl:DatatypeProperty ;
    rdfs:label "Empirical model applicability conditions"@en ;
    rdfs:comment "Empirical models are fitted to particular climates or sites and may not transfer elsewhere."@en ;
    rdfs:domain :EmpiricalModel ;
    rdfs:range xsd:string ;
    skos:definition "The conditions under which an empirical model is valid."@en .

:empiricalModelFormula a owl:DatatypeProperty ;
    rdfs:label "Empirical model formula"@en ;
    rdfs:comment "For example H/H0 = a + b (S/S0) for the Angström-Prescott model."@en ;
    rdfs:domain :EmpiricalModel ;
    rdfs:range xsd:string ;
    skos:definition "The standard equation of an empirical model."@en .

:empiricalModelParameters a owl:DatatypeProperty ;
    rdfs:label "Empirical model parameters"@en ;
    rdfs:comment "Fitted values of the coefficients are study-specific and are recorded as parameter values."@en ;
    rdfs:domain :EmpiricalModel ;
    rdfs:range xsd:string ;
    skos:definition "The parameters of an empirical model, with their meaning."@en .

:employsAnalysis a owl:ObjectProperty ;
    rdfs:label "Employs analysis"@en ;
    rdfs:comment "For example a study employs a wind rose analysis, a statistical analysis and an economic analysis."@en ;
    rdfs:domain :Study ;
    rdfs:range :Analysis ;
    skos:broadMatch <http://purl.obolibrary.org/obo/BFO_0000051> ;
    skos:definition "Relates a study to an analysis that it carries out."@en .

:employsModel a owl:ObjectProperty ;
    rdfs:label "Employs model"@en ;
    rdfs:comment "Materialised by a SPARQL CONSTRUCT after RDFization. Never extracted from a paper."@en,
        "The details of each use are recorded in model applications."@en ;
    rdfs:domain :Study ;
    rdfs:range :Model ;
    skos:definition "Relates a study to a model that it employs."@en .

:energySystemConfiguration a owl:DatatypeProperty ;
    rdfs:label "Energy system configuration"@en ;
    rdfs:comment "Values are normalized, such as run-of-river, reservoir, onshore, offshore, grid-connected or stand-alone."@en ;
    rdfs:domain :EnergySystem ;
    rdfs:range xsd:string ;
    skos:definition "The layout or operating arrangement of an energy system."@en .

:energySystemDescription a owl:DatatypeProperty ;
    rdfs:label "Energy system description"@en ;
    rdfs:comment "It keeps details that have no dedicated property, such as whether the system is existing, proposed or only simulated."@en ;
    rdfs:domain :EnergySystem ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "A short description of an energy system as reported in a study."@en .

:energySystemInstalledCapacity a owl:DatatypeProperty ;
    rdfs:label "Energy system installed capacity"@en ;
    rdfs:comment "It is the maximum power output under rated conditions, expressed in the unit given by hasInstalledCapacityUnit, usually kilowatts or megawatts."@en ;
    rdfs:domain :EnergySystem ;
    rdfs:range xsd:decimal ;
    skos:definition "The rated power of an energy system."@en .

:energySystemName a owl:DatatypeProperty ;
    rdfs:label "Energy system name"@en ;
    rdfs:comment "It may be a proper name, such as Grand Ethiopian Renaissance Dam, or a turbine model, such as Vestas V82."@en ;
    rdfs:domain :EnergySystem ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of an energy system as given in a study."@en .

:estimationMethodCategory a owl:DatatypeProperty ;
    rdfs:label "Estimation method category"@en ;
    rdfs:comment "Values are statistical, graphical-regression or empirical."@en ;
    rdfs:domain :ParameterEstimationMethod ;
    rdfs:range xsd:string ;
    skos:definition "The category of a parameter estimation method."@en .

:estimationMethodDescription a owl:DatatypeProperty ;
    rdfs:label "Estimation method description"@en ;
    rdfs:comment "For example 'the shape and scale parameters are obtained by maximising the log-likelihood'."@en ;
    rdfs:domain :ParameterEstimationMethod ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "The textual description of a parameter estimation method."@en .

:estimationMethodFormula a owl:DatatypeProperty ;
    rdfs:label "Estimation method formula"@en ;
    rdfs:comment "For example the empirical method k = (sigma / mean)^-1.086 for the Weibull shape parameter."@en ;
    rdfs:domain :ParameterEstimationMethod ;
    rdfs:range xsd:string ;
    skos:definition "The formula of a parameter estimation method, as reported."@en .

:estimationMethodName a owl:DatatypeProperty ;
    rdfs:label "Estimation method name"@en ;
    rdfs:comment "For example maximum likelihood method."@en ;
    rdfs:domain :ParameterEstimationMethod ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of a parameter estimation method."@en .

:estimationMethodParameters a owl:DatatypeProperty ;
    rdfs:label "Estimation method parameters"@en ;
    rdfs:comment "For example the Weibull shape k and scale c, or the moments used by the method of moments."@en ;
    rdfs:domain :ParameterEstimationMethod ;
    rdfs:range xsd:string ;
    skos:definition "The parameters estimated or used by a parameter estimation method."@en .

:evaluatedAt a owl:ObjectProperty ;
    rdfs:label "Evaluated at"@en ;
    rdfs:comment "For example the capacity factor of a turbine at a given site. evaluatedAtLocation plays the same role for analyses."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :EconomicMetric :PerformanceMetric ) ] ;
    rdfs:range :Location ;
    skos:broadMatch dcterms:spatial ;
    skos:definition "Relates a performance or economic metric to the location for which it is evaluated."@en .

:evaluatedAtLocation a owl:ObjectProperty ;
    rdfs:label "Evaluated at location"@en ;
    rdfs:comment "For example a wind rose analysis carried out for a given station. evaluatedAt plays the same role for metrics."@en ;
    rdfs:domain :Analysis ;
    rdfs:range :Location ;
    skos:broadMatch dcterms:spatial ;
    skos:definition "Relates an analysis to a location at which it is evaluated."@en .

:evaluationMetricDescription a owl:DatatypeProperty ;
    rdfs:label "Evaluation metric description"@en ;
    rdfs:comment "For example 'square root of the mean of the squared differences between predicted and observed values'."@en ;
    rdfs:domain :EvaluationMetric ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "The textual description of an evaluation metric."@en .

:evaluationMetricFormula a owl:DatatypeProperty ;
    rdfs:label "Evaluation metric formula"@en ;
    rdfs:comment "For example RMSE = sqrt(1/n * sum((y_pred - y_obs)^2))."@en ;
    rdfs:domain :EvaluationMetric ;
    rdfs:range xsd:string ;
    skos:closeMatch <http://qudt.org/schema/qudt/latexDefinition> ;
    skos:definition "The formula of an evaluation metric."@en .

:evaluationMetricInterpretation a owl:DatatypeProperty ;
    rdfs:label "Evaluation metric interpretation"@en ;
    rdfs:comment "For example 'lower is better' for RMSE or 'closer to 1 is better' for R2."@en ;
    rdfs:domain :EvaluationMetric ;
    rdfs:range xsd:string ;
    skos:definition "The rule for interpreting the values of an evaluation metric."@en .

:evaluationMetricName a owl:DatatypeProperty ;
    rdfs:label "Evaluation metric name"@en ;
    rdfs:comment "For example root mean square error, coefficient of determination, Kolmogorov-Smirnov statistic or Akaike information criterion."@en ;
    rdfs:domain :EvaluationMetric ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of an evaluation metric."@en .

:evaluationMetricParameters a owl:DatatypeProperty ;
    rdfs:label "Evaluation metric parameters"@en ;
    rdfs:comment "For example the number of observations n, the number of model parameters k, or the quantile level for a pinball loss."@en ;
    rdfs:domain :EvaluationMetric ;
    rdfs:range xsd:string ;
    skos:definition "The parameters or inputs of an evaluation metric."@en .

:evaluationMetricType a owl:DatatypeProperty ;
    rdfs:label "Evaluation metric type"@en ;
    rdfs:comment "For example error metric, correlation metric, goodness-of-fit metric or information criterion."@en ;
    rdfs:domain :EvaluationMetric ;
    rdfs:range xsd:string ;
    skos:definition "The type of an evaluation metric."@en .

:evaluationResultForCriterion a owl:ObjectProperty ;
    rdfs:label "Evaluation result for criterion"@en ;
    rdfs:comment "Used when a result is reported per criterion, for example the score of a site on the slope criterion."@en ;
    rdfs:domain :EvaluationResult ;
    rdfs:range :DecisionCriterion ;
    skos:definition "Relates an evaluation result to the decision criterion to which it refers."@en .

:evaluationResultForScenario a owl:ObjectProperty ;
    rdfs:label "Evaluation result for scenario"@en ;
    rdfs:comment "For example the RMSE of a model for a given input configuration or climate scenario."@en ;
    rdfs:domain :EvaluationResult ;
    rdfs:range :Scenario ;
    skos:definition "Relates an evaluation result to the scenario under which it was obtained."@en .

:evaluationResultTemporalScope a owl:DatatypeProperty ;
    rdfs:label "Evaluation result temporal scope"@en ;
    rdfs:comment "For example the test period or a given month. Together with the location it distinguishes the results of the same metric in one application."@en ;
    rdfs:domain :EvaluationResult ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:temporal ;
    skos:definition "The period or time step to which an evaluation result refers, as stated in the study."@en .

:evaluationResultValue a owl:DatatypeProperty ;
    rdfs:label "Evaluation result value"@en ;
    rdfs:comment "For example an RMSE of 0.45 m/s or an R2 of 0.97; the unit is given by hasUnit."@en ;
    rdfs:domain :EvaluationResult ;
    rdfs:range xsd:decimal ;
    skos:closeMatch <http://qudt.org/schema/qudt/value> ;
    skos:definition "The value of an evaluation metric obtained for a model application."@en .

:factorCause a owl:DatatypeProperty ;
    rdfs:label "Factor cause"@en ;
    rdfs:comment "It explains where the factor comes from, for example the variation of wind regimes between years at the same site."@en ;
    rdfs:domain :InfluencingFactor ;
    rdfs:range xsd:string ;
    skos:definition "The cause of an influencing factor as reported in a study."@en .

:factorScope a owl:DatatypeProperty ;
    rdfs:label "Factor scope"@en ;
    rdfs:comment "For example the study area, the turbines evaluated or the analysis in which the factor was identified."@en ;
    rdfs:domain :InfluencingFactor ;
    rdfs:range xsd:string ;
    skos:definition "The context in which an influencing factor applies, as reported in a study."@en .

:factorSolution a owl:DatatypeProperty ;
    rdfs:label "Factor solution"@en ;
    rdfs:comment "For example testing estimation methods over many years, or using offshore masts or remote sensing for accurate measurements."@en ;
    rdfs:domain :InfluencingFactor ;
    rdfs:range xsd:string ;
    skos:definition "A solution or mitigation proposed for an influencing factor."@en .

:factorStatement a owl:DatatypeProperty ;
    rdfs:label "Factor statement"@en ;
    rdfs:comment "It keeps the study's own words, for example \"Surface roughness affects changes in 100 m wind speed\"."@en ;
    rdfs:domain :InfluencingFactor ;
    rdfs:range xsd:string ;
    skos:definition "The statement of an influencing factor as reported in a study."@en .

:feedstockType a owl:DatatypeProperty ;
    rdfs:label "Feedstock type"@en ;
    rdfs:comment "Examples are wood chips, rice husks, sugarcane bagasse, cow dung and municipal solid waste."@en ;
    rdfs:domain :BiomassDesignCharacteristics ;
    rdfs:range xsd:string ;
    skos:definition "The type of biomass feedstock used, as described by biomass design characteristics."@en .

:findingOutcome a owl:DatatypeProperty ;
    rdfs:label "Finding outcome"@en ;
    rdfs:comment "For example 'Weibull performs best' or 'the mixture model outperforms the single distribution'. findingStatement gives the full sentence."@en ;
    rdfs:domain :ConditionalFinding ;
    rdfs:range xsd:string ;
    skos:definition "The outcome of a conditional finding, stated briefly."@en .

:findingScope a owl:DatatypeProperty ;
    rdfs:label "Finding scope"@en ;
    rdfs:comment "For example 'all five stations', 'coastal sites only' or 'the test period 2018–2019'."@en ;
    rdfs:domain :ConditionalFinding ;
    rdfs:range xsd:string ;
    skos:definition "The extent to which a conditional finding applies."@en .

:findingStatement a owl:DatatypeProperty ;
    rdfs:label "Finding statement"@en ;
    rdfs:comment "For example 'For bimodal wind regimes, the two-component Weibull mixture fits the data better than the Weibull distribution'."@en ;
    rdfs:domain :ConditionalFinding ;
    rdfs:range xsd:string ;
    skos:definition "The full statement of a conditional finding as reported in the study."@en .

:geothermalPlantType a owl:DatatypeProperty ;
    rdfs:label "Geothermal plant type"@en ;
    rdfs:comment "Examples are dry steam, single or double flash and binary cycle (ORC) plants."@en ;
    rdfs:domain :GeothermalDesignCharacteristics ;
    rdfs:range xsd:string ;
    skos:definition "The type of geothermal power plant described by geothermal design characteristics."@en .

:hasAnalysisType a owl:ObjectProperty ;
    rdfs:label "Has analysis type"@en ;
    rdfs:comment "The shared analysis acts as a category that gathers analyses described in different words in different studies, so that they can be compared."@en ;
    rdfs:domain :Analysis ;
    rdfs:range :Analysis ;
    skos:definition "Relates an analysis reported in a study to the shared analysis, such as wind rose or trend analysis, of which it is a case."@en .

:hasClimate a owl:ObjectProperty ;
    rdfs:label "Has climate"@en ;
    rdfs:comment "For example a station in northern Cameroon has a semi-arid climate (Köppen BSh)."@en ;
    rdfs:domain :Location ;
    rdfs:range :Climate ;
    skos:definition "Relates a location to the climate that characterizes it."@en .

:hasComponent a owl:ObjectProperty ;
    rdfs:label "Has component"@en ;
    rdfs:comment "Components are parts such as turbines, generators, PV modules, inverters or batteries."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :BiomassEnergySystem :EnergySystem :GeothermalEnergySystem :HydrogenEnergySystem :HydropowerEnergySystem :NuclearEnergySystem :OceanEnergySystem :SolarEnergySystem :WindEnergySystem ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( :BiomassComponent :EnergySystemComponent :GeothermalComponent :HydroComponent :HydrogenComponent :NuclearComponent :OceanComponent :SolarComponent :WindComponent ) ] ;
    skos:broadMatch <http://purl.obolibrary.org/obo/BFO_0000051> ;
    skos:definition "Relates an energy system to one of its components."@en .

:hasDesignCharacteristics a owl:ObjectProperty ;
    rdfs:label "Has design characteristics"@en ;
    rdfs:comment "Each technology-specific component points to the matching subclass, for example a wind component to wind design characteristics."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :BiomassComponent :EnergySystemComponent :GeothermalComponent :HydroComponent :HydrogenComponent :NuclearComponent :OceanComponent :SolarComponent :StorageComponent :WindComponent :EnergySystem ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( :BiomassDesignCharacteristics :DesignCharacteristics :GeothermalDesignCharacteristics :HydroDesignCharacteristics :HydrogenPlantDesignCharacteristics :NuclearDesignCharacteristics :OceanPlantDesignCharacteristics :SolarDesignCharacteristics :StorageDesignCharacteristics :WindDesignCharacteristics ) ] ;
    skos:definition "Relates an energy system component to the design characteristics that specify it."@en .

:hasEconomicMetric a owl:ObjectProperty ;
    rdfs:label "Has economic metric"@en ;
    rdfs:comment "Examples are the levelized cost of energy, the net present value and the payback period."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :EnergyResource :EnergySystem ) ] ;
    rdfs:range :EconomicMetric ;
    skos:definition "Relates an energy system or energy resource to an economic metric reported for it."@en .

:hasEconomicMetricType a owl:ObjectProperty ;
    rdfs:label "Has economic metric type"@en ;
    rdfs:comment "The shared metric node carries the definition and is reused by all studies; the turbine, site or scenario of the value is given by the links of the value itself, not by the name of the metric."@en ;
    rdfs:domain :EconomicMetric ;
    rdfs:range :EconomicMetric ;
    skos:definition "Relates an economic value reported in a study to the shared economic metric, such as the levelised cost of electricity, of which it is a value."@en .

:hasEnergySystemType a owl:ObjectProperty ;
    rdfs:label "Has energy system type"@en ;
    rdfs:comment "Shared categories, such as wind turbine or small hydropower plant, gather systems that different studies describe in different words, so that they can be compared."@en ;
    rdfs:domain :EnergySystem ;
    rdfs:range :EnergySystem ;
    skos:definition "Relates an energy system assessed in a study to the shared energy system category of which it is a case."@en .

:hasEvaluationResult a owl:ObjectProperty ;
    rdfs:label "Has evaluation result"@en ;
    rdfs:comment "For example an RMSE value of the fitted distribution."@en ;
    rdfs:domain :ModelApplication ;
    rdfs:range :EvaluationResult ;
    skos:definition "Relates a model application to an evaluation result obtained for it."@en .

:hasFactorType a owl:ObjectProperty ;
    rdfs:label "Has factor type"@en ;
    rdfs:comment "Shared factor types, such as terrain factor or economic factor, gather factors that different studies state in different words, so that they can be compared."@en ;
    rdfs:domain :InfluencingFactor ;
    rdfs:range :InfluencingFactor ;
    skos:definition "Relates an influencing factor identified in a study to the shared factor type of which it is a case."@en .

:hasImpactType a owl:ObjectProperty ;
    rdfs:label "Has impact type"@en ;
    rdfs:comment "Shared impact types, such as greenhouse gas emission reduction or electricity access, gather impacts that different studies state in different words."@en ;
    rdfs:domain :Impact ;
    rdfs:range :Impact ;
    skos:definition "Relates an impact reported in a study to the shared impact type of which it is a case."@en .

:hasInputVariable a owl:ObjectProperty ;
    rdfs:label "Has input variable"@en ;
    rdfs:comment "For example sunshine duration as an input to estimate global solar radiation."@en ;
    rdfs:domain :PredictiveApplication ;
    rdfs:range :Variable ;
    skos:broadMatch <http://www.w3.org/ns/mls#hasInput> ;
    skos:definition "Relates a predictive application to a variable used as model input."@en .

:hasMeasurementHeightUnit a owl:ObjectProperty ;
    rdfs:label "Has measurement height unit"@en ;
    rdfs:comment "The measurement height is almost always given in metres. The unit is a shared UnitOfMeasurement node, so all values expressed in the same unit can be retrieved and converted together."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ResourceCharacterization :Dataset :Observation :PerformanceMetric ) ] ;
    rdfs:range :UnitOfMeasurement ;
    skos:broadMatch <http://qudt.org/schema/qudt/hasUnit> ;
    skos:definition "Relates a quantitative entity to the unit in which its measurement height is expressed."@en .

:hasMixtureComponent a owl:ObjectProperty ;
    rdfs:label "Has mixture component"@en ;
    rdfs:comment "For example a two-component Weibull mixture application has two mixture components, each with its own weight and parameters."@en ;
    rdfs:domain :ModelApplication ;
    rdfs:range :MixtureComponent ;
    skos:definition "Relates a model application to one of the mixture components of the fitted mixture distribution."@en .

:hasObjective a owl:ObjectProperty ;
    rdfs:label "Has objective"@en ;
    rdfs:comment "For example resource analysis, model development or economic evaluation."@en ;
    rdfs:domain :Study ;
    rdfs:range :StudyObjective ;
    skos:definition "Relates a study to an objective that it sets out to achieve."@en .

:hasOutputVariable a owl:ObjectProperty ;
    rdfs:label "Has output variable"@en ;
    rdfs:comment "For example global solar radiation estimated from sunshine duration."@en ;
    rdfs:domain :PredictiveApplication ;
    rdfs:range :Variable ;
    skos:broadMatch <http://www.w3.org/ns/mls#hasOutput> ;
    skos:definition "Relates a predictive application to the variable that the model estimates or forecasts."@en .

:hasParameterValue a owl:ObjectProperty ;
    rdfs:label "Has parameter value"@en ;
    rdfs:comment "For example the Weibull shape and scale parameters estimated at a station for a given period."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :MixtureComponent :ModelApplication ) ] ;
    rdfs:range :ParameterValue ;
    skos:definition "Relates a model application or mixture component to a parameter value obtained or used in it."@en .

:hasPerformanceMetric a owl:ObjectProperty ;
    rdfs:label "Has performance metric"@en ;
    rdfs:comment "Examples are the capacity factor, the annual energy production and the efficiency."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :EnergySystem :EnergySystemComponent ) ] ;
    rdfs:range :PerformanceMetric ;
    skos:definition "Relates an energy system or component to a performance metric reported for it."@en .

:hasPerformanceMetricType a owl:ObjectProperty ;
    rdfs:label "Has performance metric type"@en ;
    rdfs:comment "The shared metric node carries the definition and is reused by all studies; the turbine, site or scenario of the value is given by the links of the value itself, not by the name of the metric."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range :PerformanceMetric ;
    skos:definition "Relates a performance value reported in a study to the shared performance metric, such as capacity factor, of which it is a value."@en .

:hasReferencePlane a owl:ObjectProperty ;
    rdfs:label "Has reference plane"@en ;
    rdfs:comment "The same height designates different positions above the ground, above sea level or above a hilltop, so the reference plane is needed to compare measurement heights. Reference planes are shared nodes."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ResourceCharacterization :Observation ) ] ;
    rdfs:range :ReferencePlane ;
    skos:definition "Relates a resource characterization or observation to the reference level from which its measurement height is measured."@en .

:hasSiteSetting a owl:ObjectProperty ;
    rdfs:label "Has site setting"@en ;
    rdfs:comment "For example an offshore wind farm or a rooftop PV system."@en ;
    rdfs:domain :EnergySystem ;
    rdfs:range :SiteSetting ;
    skos:definition "Relates an energy system to the site setting in which it is installed."@en .

:hasTemporalResolution a owl:ObjectProperty ;
    rdfs:label "Has temporal resolution"@en ;
    rdfs:comment "Examples are 10-minute records, hourly data or monthly means. The resolution affects statistics such as the standard deviation and the maximum, which are smoothed by averaging. Resolutions are shared nodes."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ResourceCharacterization :Dataset :Observation ) ] ;
    rdfs:range :TemporalResolution ;
    skos:definition "Relates a dataset, observation or resource characterization to the temporal resolution of its values."@en ;
    skos:exactMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000516> .

:hasTerrain a owl:ObjectProperty ;
    rdfs:label "Has terrain"@en ;
    rdfs:comment "For example a site on the Adamawa plateau or a coastal plain."@en ;
    rdfs:domain :Location ;
    rdfs:range :Terrain ;
    skos:definition "Relates a location to the terrain that characterizes it."@en .

:hasUnit a owl:ObjectProperty ;
    rdfs:label "Has unit"@en ;
    rdfs:comment "For example metres per second for a mean wind speed, megawatts for an installed capacity or metres for an altitude. The unit is a shared UnitOfMeasurement node, so all values expressed in the same unit can be retrieved and converted together."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ResourceCharacterization :Observation :Variable :PerformanceMetric :EconomicMetric :EvaluationResult :DerivedValue :ParameterValue :DesignParameterValue :Impact :PolicyTarget :UncertaintyComponent :Location :EnergySystem :Scenario :DecisionCriterion ) ] ;
    rdfs:range :UnitOfMeasurement ;
    skos:closeMatch <http://qudt.org/schema/qudt/hasUnit>,
        <https://openenergyplatform.org/ontology/oeo/OEO_00040010> ;
    skos:definition "Relates a quantitative entity to the unit of measurement of its value."@en .

:hasVariable a owl:ObjectProperty ;
    rdfs:label "Has variable"@en ;
    rdfs:comment "For example ERA5 contains 10 m wind speed, 100 m wind speed and surface solar radiation."@en ;
    rdfs:domain :Dataset ;
    rdfs:range :Variable ;
    skos:definition "Relates a dataset to a variable that it contains."@en .

:hasWindPowerClass a owl:ObjectProperty ;
    rdfs:label "Has wind power class"@en ;
    rdfs:comment "Wind power classes, as defined by NREL, rank sites from class 1 (poor) to class 7 (superb) by mean wind power density."@en ;
    rdfs:domain :ResourceCharacterization ;
    rdfs:range :WindPowerClass ;
    skos:definition "Relates a resource characterization to the wind power class of the site that it describes."@en .

:hydrogenProductionRate a owl:DatatypeProperty ;
    rdfs:label "Hydrogen production rate"@en ;
    rdfs:comment "It is expressed for example in kg/h, Nm3/h or tonnes per year; the unit is given by hasHydrogenProductionRateUnit."@en ;
    rdfs:domain :HydrogenPlantDesignCharacteristics ;
    rdfs:range xsd:decimal ;
    skos:definition "The hydrogen production rate of the plant described by hydrogen plant design characteristics."@en .

:identifiedInStudy a owl:ObjectProperty ;
    rdfs:label "Identified in study"@en ;
    rdfs:comment "Each factor belongs to the study that reports it."@en ;
    rdfs:domain :InfluencingFactor ;
    rdfs:range :Study ;
    skos:definition "Relates an influencing factor to the study in which it is identified."@en .

:identifiesFactor a owl:ObjectProperty ;
    rdfs:label "Identifies factor"@en ;
    rdfs:comment "For example a study identifies high investment cost as a barrier to wind energy deployment."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :SWOTAnalysis :Study ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( :InfluencingFactor :SWOTFactor ) ] ;
    skos:definition "Relates a study or SWOT analysis to an influencing factor or SWOT factor that it identifies."@en .

:impactDirection a owl:DatatypeProperty ;
    rdfs:label "Impact direction"@en ;
    rdfs:comment "For example, avoided emissions are a reduction and visual impact is negative."@en ;
    rdfs:domain :Impact ;
    rdfs:range xsd:string ;
    skos:definition "Whether an impact is positive, negative or a reduction."@en .

:impactOfEnergySystem a owl:ObjectProperty ;
    rdfs:label "Impact of energy system"@en ;
    rdfs:comment "For example, avoided emissions are an impact of a wind farm."@en ;
    rdfs:domain :Impact ;
    rdfs:range :EnergySystem ;
    skos:definition "Relates an impact to the energy system that causes it."@en .

:impactOnEnergyResource a owl:ObjectProperty ;
    rdfs:label "Impact on energy resource"@en ;
    rdfs:comment "For example, a projected decrease in hub-height wind speed affects the wind energy resource."@en ;
    rdfs:domain :Impact ;
    rdfs:range :EnergyResource ;
    skos:definition "Relates an impact to the energy resource that it concerns."@en .

:impactOnLocation a owl:ObjectProperty ;
    rdfs:label "Impact on location"@en ;
    rdfs:comment "For example, the city whose inhabitants could be supplied with water."@en ;
    rdfs:domain :Impact ;
    rdfs:range :Location ;
    skos:broadMatch dcterms:spatial ;
    skos:definition "Relates an impact to the location where it occurs."@en .

:impactStatement a owl:DatatypeProperty ;
    rdfs:label "Impact statement"@en ;
    rdfs:comment "It keeps the study's own words."@en ;
    rdfs:domain :Impact ;
    rdfs:range xsd:string ;
    skos:definition "The statement of an impact as reported in a study."@en .

:impactTimeHorizon a owl:DatatypeProperty ;
    rdfs:label "Impact time horizon"@en ;
    rdfs:comment "Values are normalized, such as annual or monthly; long horizons such as 21st century are kept."@en ;
    rdfs:domain :Impact ;
    rdfs:range xsd:string ;
    skos:definition "The period over which an impact is quantified or expected."@en .

:impactValue a owl:DatatypeProperty ;
    rdfs:label "Impact value"@en ;
    rdfs:comment "It is expressed in the unit given by hasUnit, for example tonnes of CO2 equivalent per year or number of persons."@en ;
    rdfs:domain :Impact ;
    rdfs:range xsd:decimal ;
    skos:closeMatch <http://qudt.org/schema/qudt/value> ;
    skos:definition "The quantified size of an impact."@en .

:installedAt a owl:ObjectProperty ;
    rdfs:label "Installed at"@en ;
    rdfs:comment "For proposed or simulated systems it is the location studied, not necessarily an existing installation."@en ;
    rdfs:domain :EnergySystem ;
    rdfs:range :Location ;
    skos:broadMatch <http://purl.obolibrary.org/obo/RO_0001025>,
        schema:location ;
    skos:definition "Relates an energy system to the location where it is installed or planned."@en .

:instrumentCategory a owl:DatatypeProperty ;
    rdfs:label "Instrument category"@en ;
    rdfs:comment "For example anemometer, wind vane, pyranometer, lidar, sodar, rain gauge or satellite sensor."@en ;
    rdfs:domain :MeasuringInstrument ;
    rdfs:range xsd:string ;
    skos:definition "The category of a measuring instrument."@en .

:instrumentName a owl:DatatypeProperty ;
    rdfs:label "Instrument name"@en ;
    rdfs:comment "For example 'Thies First Class cup anemometer' or 'Kipp & Zonen CMP11 pyranometer'."@en ;
    rdfs:domain :MeasuringInstrument ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name or model of a measuring instrument."@en .

:investigatesResearchProblem a owl:ObjectProperty ;
    rdfs:label "Investigates research problem"@en ;
    rdfs:comment "For example resource assessment, energy estimation or policy assessment."@en ;
    rdfs:domain :Study ;
    rdfs:range :ResearchProblem ;
    skos:definition "Relates a study to a research problem that it investigates."@en .

:learningParadigm a owl:DatatypeProperty ;
    rdfs:label "Learning paradigm"@en ;
    rdfs:comment "Values are supervised, unsupervised, semi-supervised or reinforcement."@en ;
    rdfs:domain :MachineLearningModel ;
    rdfs:range xsd:string ;
    skos:definition "The learning paradigm of a machine-learning model."@en .

:learningTask a owl:DatatypeProperty ;
    rdfs:label "Learning task"@en ;
    rdfs:comment "Values are regression, classification, clustering, dimensionality reduction or forecasting."@en ;
    rdfs:domain :MachineLearningModel ;
    rdfs:range xsd:string ;
    skos:definition "The task that a machine-learning model performs."@en .

:locatedInCountry a owl:ObjectProperty ;
    rdfs:label "Located in country"@en ;
    rdfs:comment "For example Garoua is located in Cameroon. Locations spanning several countries, such as a river basin, can have several values."@en ;
    rdfs:domain :Location ;
    rdfs:range :Country ;
    skos:broadMatch <http://purl.obolibrary.org/obo/RO_0001025>,
        schema:containedInPlace ;
    skos:definition "Relates a location to the country in which it lies."@en .

:locationAltitude a owl:DatatypeProperty ;
    rdfs:label "Location altitude"@en ;
    rdfs:comment "It is usually given in metres; the unit is given by hasAltitudeUnit."@en ;
    rdfs:domain :Location ;
    rdfs:range xsd:decimal ;
    skos:closeMatch schema:elevation ;
    skos:definition "The altitude of a location above sea level."@en .

:locationDescription a owl:DatatypeProperty ;
    rdfs:label "Location description"@en ;
    rdfs:comment "For example 'semi-arid plain in the Far North region, 30 km from the Logone river'."@en ;
    rdfs:domain :Location ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "The textual description of a location."@en .

:locationFeatureType a owl:DatatypeProperty ;
    rdfs:label "Location feature type"@en ;
    rdfs:comment "Examples are meteorological station, city, river basin, dam site, grid cell and administrative region."@en ;
    rdfs:domain :Location ;
    rdfs:range xsd:string ;
    skos:definition "The type of geographic feature a location represents."@en .

:locationGranularity a owl:DatatypeProperty ;
    rdfs:label "Location granularity"@en ;
    rdfs:comment "Values are for example point, city, district, region or country; it tells whether results refer to a single site or to an area."@en ;
    rdfs:domain :Location ;
    rdfs:range xsd:string ;
    skos:definition "The spatial granularity of a location."@en .

:locationLatitude a owl:DatatypeProperty ;
    rdfs:label "Location latitude"@en ;
    rdfs:comment "It is expressed in decimal degrees, positive north of the equator."@en ;
    rdfs:domain :Location ;
    rdfs:range xsd:decimal ;
    skos:definition "The latitude of a location."@en ;
    skos:exactMatch schema:latitude .

:locationLongitude a owl:DatatypeProperty ;
    rdfs:label "Location longitude"@en ;
    rdfs:comment "It is expressed in decimal degrees, positive east of Greenwich."@en ;
    rdfs:domain :Location ;
    rdfs:range xsd:decimal ;
    skos:definition "The longitude of a location."@en ;
    skos:exactMatch schema:longitude .

:locationName a owl:DatatypeProperty ;
    rdfs:label "Location name"@en ;
    rdfs:comment "For example 'Ngaoundéré', 'Lom Pangar dam' or 'FINO1'."@en ;
    rdfs:domain :Location ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of a location."@en .

:locationSettlementType a owl:DatatypeProperty ;
    rdfs:label "Location settlement type"@en ;
    rdfs:comment "Values are for example urban, peri-urban, rural or remote off-grid; it matters for electrification and demand studies."@en ;
    rdfs:domain :Location ;
    rdfs:range xsd:string ;
    skos:definition "The type of settlement at a location."@en .

:measuresVariable a owl:ObjectProperty ;
    rdfs:label "Measures variable"@en ;
    rdfs:comment "For example an anemometer measures wind speed and a pyranometer measures global solar radiation."@en ;
    rdfs:domain :MeasuringInstrument ;
    rdfs:range :Variable ;
    skos:closeMatch sosa:observes ;
    skos:definition "Relates a measuring instrument to a variable that it measures."@en .

:modelAssumptions a owl:DatatypeProperty ;
    rdfs:label "Model assumptions"@en ;
    rdfs:comment "Assumptions are specific to each study and are recorded on the model application of that study."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Model :ModelApplication ) ] ;
    rdfs:range xsd:string ;
    skos:definition "The assumptions on which a model relies, as stated in a study."@en .

:modelDescription a owl:DatatypeProperty ;
    rdfs:label "Model description"@en ;
    rdfs:comment "Descriptions written by individual studies are kept in the auxiliary files; the canonical node carries its own definition."@en ;
    rdfs:domain :Model ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "A description of a model."@en .

:modelName a owl:DatatypeProperty ;
    rdfs:label "Model name"@en ;
    rdfs:comment "For example Weibull distribution or random forest; names used by individual studies are kept in the auxiliary files."@en ;
    rdfs:domain :Model ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The canonical name of a model."@en .

:modelPurpose a owl:DatatypeProperty ;
    rdfs:label "Model purpose"@en ;
    rdfs:comment "Purposes are specific to each study and are recorded on the model application of that study; applicationPurpose describes the application itself."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Model :ModelApplication ) ] ;
    rdfs:range xsd:string ;
    skos:definition "The purpose for which a model is used, as stated in a study."@en .

:modelType a owl:DatatypeProperty ;
    rdfs:label "Model type"@en ;
    rdfs:comment "The type is now given by the subclass of the canonical model node."@en ;
    rdfs:domain :Model ;
    rdfs:range xsd:string ;
    skos:definition "A free-text type of model as written in a study."@en .

:numberOfBlades a owl:DatatypeProperty ;
    rdfs:label "Number of blades"@en ;
    rdfs:comment "Most modern horizontal-axis turbines have three blades; small or water-pumping turbines may have two or many more."@en ;
    rdfs:domain :WindDesignCharacteristics ;
    rdfs:range xsd:integer ;
    skos:definition "The number of rotor blades of a wind turbine described by wind design characteristics."@en .

:objectiveStatement a owl:DatatypeProperty ;
    rdfs:label "Objective statement"@en ;
    rdfs:comment "For example 'to assess the wind energy potential of five sites in northern Cameroon'."@en ;
    rdfs:domain :StudyObjective ;
    rdfs:range xsd:string ;
    skos:definition "The statement of a study objective as written in the study."@en .

:observationAtLocation a owl:ObjectProperty ;
    rdfs:label "Observation at location"@en ;
    rdfs:comment "It is usually a measurement station or site."@en ;
    rdfs:domain :Observation ;
    rdfs:range :Location ;
    skos:broadMatch dcterms:spatial ;
    skos:definition "Relates an observation to the location at which it was made."@en .

:observationMeasurementHeight a owl:DatatypeProperty ;
    rdfs:label "Observation measurement height"@en ;
    rdfs:comment "For wind speed it is often 10 m or the mast height; the unit is given by hasMeasurementHeightUnit and the reference level by hasReferencePlane."@en ;
    rdfs:domain :Observation ;
    rdfs:range xsd:decimal ;
    skos:definition "The height at which an observation was measured."@en .

:observationOfVariable a owl:ObjectProperty ;
    rdfs:label "Observation of variable"@en ;
    rdfs:comment "For example an observation of wind speed or of river discharge."@en ;
    rdfs:domain :Observation ;
    rdfs:range :Variable ;
    skos:closeMatch sosa:observedProperty ;
    skos:definition "Relates an observation to the variable whose value it records."@en .

:observationQualityFlag a owl:DatatypeProperty ;
    rdfs:label "Observation quality flag"@en ;
    rdfs:comment "For example 'valid', 'suspect', 'gap-filled' or a code from the data provider."@en ;
    rdfs:domain :Observation ;
    rdfs:range xsd:string ;
    skos:definition "The quality flag attached to an observation."@en .

:observationTimestamp a owl:DatatypeProperty ;
    rdfs:label "Observation timestamp"@en ;
    rdfs:comment "It is an xsd:dateTime value, ideally with a time zone, for example 2015-06-01T12:00:00Z."@en ;
    rdfs:domain :Observation ;
    rdfs:range xsd:dateTime ;
    skos:closeMatch sosa:resultTime ;
    skos:definition "The date and time at which an observation was made."@en .

:observationValue a owl:DatatypeProperty ;
    rdfs:label "Observation value"@en ;
    rdfs:comment "For example 5.3 for a wind speed in m/s or 650 for irradiance in W/m2; the unit is given by hasUnit."@en ;
    rdfs:domain :Observation ;
    rdfs:range xsd:decimal ;
    skos:closeMatch <http://qudt.org/schema/qudt/value>,
        sosa:hasSimpleResult ;
    skos:definition "The measured value of an observation."@en .

:oceanDeviceType a owl:DatatypeProperty ;
    rdfs:label "Ocean device type"@en ;
    rdfs:comment "Examples are oscillating water column, point absorber, attenuator, overtopping device, tidal stream turbine and tidal barrage."@en ;
    rdfs:domain :OceanPlantDesignCharacteristics ;
    rdfs:range xsd:string ;
    skos:definition "The type of ocean energy device described by ocean plant design characteristics."@en .

:ofVariable a owl:ObjectProperty ;
    rdfs:label "Of variable"@en ;
    rdfs:comment "For example a derived value of wind power density."@en ;
    rdfs:domain :DerivedValue ;
    rdfs:range :Variable ;
    skos:definition "Relates a derived value to the variable whose value it gives."@en .

:optimizationAlgorithmCategory a owl:DatatypeProperty ;
    rdfs:label "Optimization algorithm category"@en ;
    rdfs:comment "For example metaheuristic, evolutionary, swarm intelligence, gradient-based or exact (linear programming)."@en ;
    rdfs:domain :OptimizationAlgorithm ;
    rdfs:range xsd:string ;
    skos:definition "The category of an optimization algorithm."@en .

:optimizationAlgorithmName a owl:DatatypeProperty ;
    rdfs:label "Optimization algorithm name"@en ;
    rdfs:comment "For example particle swarm optimization, genetic algorithm, Levenberg-Marquardt or simulated annealing."@en ;
    rdfs:domain :OptimizationAlgorithm ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of an optimization algorithm."@en .

:paperAuthor a owl:DatatypeProperty ;
    rdfs:label "Paper author"@en ;
    rdfs:comment "Each author can be given as a separate value, in the order of the byline."@en ;
    rdfs:domain :Paper ;
    rdfs:range xsd:string ;
    skos:closeMatch dcterms:creator ;
    skos:definition "The name of an author of a paper."@en .

:paperDoi a owl:DatatypeProperty ;
    rdfs:label "Paper doi"@en ;
    rdfs:comment "It is given without resolver prefix, for example 10.1016/j.renene.2020.01.001."@en ;
    rdfs:domain :Paper ;
    rdfs:range xsd:string ;
    skos:definition "The digital object identifier of a paper."@en ;
    skos:exactMatch <http://purl.org/ontology/bibo/doi> .

:paperTitle a owl:DatatypeProperty ;
    rdfs:label "Paper title"@en ;
    rdfs:comment "It is the title as published."@en ;
    rdfs:domain :Paper ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:title ;
    skos:definition "The title of a paper."@en .

:parameterKind a owl:DatatypeProperty ;
    rdfs:label "Parameter kind"@en ;
    rdfs:comment "Examples are shape, scale, location, weight, coefficient and intercept."@en ;
    rdfs:domain :ParameterValue ;
    rdfs:range xsd:string ;
    skos:definition "The kind of model parameter whose value is recorded."@en .

:parameterSymbol a owl:DatatypeProperty ;
    rdfs:label "Parameter symbol"@en ;
    rdfs:comment "For example k and c for the Weibull shape and scale parameters, or alpha for the wind shear exponent."@en ;
    rdfs:domain :ParameterValue ;
    rdfs:range xsd:string ;
    skos:closeMatch <http://qudt.org/schema/qudt/symbol> ;
    skos:definition "The symbol of a model parameter as written in the study."@en .

:parameterTemporalScope a owl:DatatypeProperty ;
    rdfs:label "Parameter temporal scope"@en ;
    rdfs:comment "For example annual, January or 2002-2012. Together with the location it distinguishes the values of the same parameter in one application."@en ;
    rdfs:domain :ParameterValue ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:temporal ;
    skos:definition "The period or time step to which a parameter value refers, as stated in the study."@en .

:parameterValue a owl:DatatypeProperty ;
    rdfs:label "Parameter value"@en ;
    rdfs:comment "For example a Weibull shape parameter k = 2.1 or a scale parameter c = 5.4 m/s; the unit is given by hasUnit."@en ;
    rdfs:domain :ParameterValue ;
    rdfs:range xsd:decimal ;
    skos:closeMatch <http://qudt.org/schema/qudt/value> ;
    skos:definition "The numerical value of a model parameter in a model application."@en .

:performanceMetricBestPerformer a owl:DatatypeProperty ;
    rdfs:label "Performance metric best performer"@en ;
    rdfs:comment "For example 'site B' or 'the 2 MW turbine'."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:string ;
    skos:definition "The site, system or option that achieved the best value of a performance metric in the study."@en .

:performanceMetricConclusion a owl:DatatypeProperty ;
    rdfs:label "Performance metric conclusion"@en ;
    rdfs:comment "For example 'the site is suitable for large wind turbines' or 'capacity factors are too low for grid-connected use'."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:string ;
    skos:definition "The conclusion that the study draws from a performance metric."@en .

:performanceMetricDescription a owl:DatatypeProperty ;
    rdfs:label "Performance metric description"@en ;
    rdfs:comment "For example 'ratio of the actual energy output to the output at rated power over the same period'."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "The textual description of a performance metric."@en .

:performanceMetricFormula a owl:DatatypeProperty ;
    rdfs:label "Performance metric formula"@en ;
    rdfs:comment "For example capacity factor = annual energy output / (rated power x 8760 h)."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:string ;
    skos:closeMatch <http://qudt.org/schema/qudt/latexDefinition> ;
    skos:definition "The formula used to compute a performance metric."@en .

:performanceMetricHeight a owl:DatatypeProperty ;
    rdfs:label "Performance metric height"@en ;
    rdfs:comment "For example the wind power density at 50 m above ground; the unit is given by hasMeasurementHeightUnit."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:decimal ;
    skos:definition "The height to which a performance metric refers."@en .

:performanceMetricMaximumValue a owl:DatatypeProperty ;
    rdfs:label "Performance metric maximum value"@en ;
    rdfs:comment "For example the highest monthly wind power density; the unit is given by hasUnit."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:decimal ;
    skos:definition "The highest value of a performance metric reported across sites, periods or systems."@en .

:performanceMetricMeanValue a owl:DatatypeProperty ;
    rdfs:label "Performance metric mean value"@en ;
    rdfs:comment "For example the annual mean capacity factor; the unit is given by hasUnit."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:decimal ;
    skos:definition "The mean value of a performance metric over the reported sites, periods or systems."@en .

:performanceMetricMinimumValue a owl:DatatypeProperty ;
    rdfs:label "Performance metric minimum value"@en ;
    rdfs:comment "For example the lowest monthly energy output; the unit is given by hasUnit."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:decimal ;
    skos:definition "The lowest value of a performance metric reported across sites, periods or systems."@en .

:performanceMetricName a owl:DatatypeProperty ;
    rdfs:label "Performance metric name"@en ;
    rdfs:comment "For example 'capacity factor', 'annual energy production', 'wind power density' or 'performance ratio'."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of a performance metric as reported."@en .

:performanceMetricParameters a owl:DatatypeProperty ;
    rdfs:label "Performance metric parameters"@en ;
    rdfs:comment "For example air density, rated power or the Weibull parameters used to compute wind power density."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:string ;
    skos:definition "The parameters entering the computation of a performance metric."@en .

:performanceMetricReferenceYear a owl:DatatypeProperty ;
    rdfs:label "Performance metric reference year"@en ;
    rdfs:comment "It is given as a year, for example 2019."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:gYear ;
    skos:definition "The year to which a performance metric refers."@en .

:performanceMetricResultSummary a owl:DatatypeProperty ;
    rdfs:label "Performance metric result summary"@en ;
    rdfs:comment "For example 'capacity factors range from 18% to 32% across the six sites'."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:string ;
    skos:definition "A summary of the results reported for a performance metric."@en .

:performanceMetricTemporalScope a owl:DatatypeProperty ;
    rdfs:label "Performance metric temporal scope"@en ;
    rdfs:comment "For example 'annual', 'monthly', 'dry season' or '2010–2015'."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:temporal ;
    skos:definition "The period or time step to which a performance metric refers."@en .

:performanceMetricType a owl:DatatypeProperty ;
    rdfs:label "Performance metric type"@en ;
    rdfs:comment "For example resource indicator or system indicator, or the specific kind such as capacity factor or energy yield."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:string ;
    skos:definition "The type of a performance metric."@en .

:performanceMetricUsesVariable a owl:ObjectProperty ;
    rdfs:label "Performance metric uses variable"@en ;
    rdfs:comment "For example wind power density uses wind speed and air density."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range :Variable ;
    skos:definition "Relates a performance metric to a variable used in its computation."@en .

:performanceMetricValue a owl:DatatypeProperty ;
    rdfs:label "Performance metric value"@en ;
    rdfs:comment "For example a capacity factor of 0.28 or a wind power density of 180 W/m2; the unit is given by hasUnit."@en ;
    rdfs:domain :PerformanceMetric ;
    rdfs:range xsd:decimal ;
    skos:closeMatch <http://qudt.org/schema/qudt/value> ;
    skos:definition "The value of a performance metric reported in a study."@en .

:physicalModelFormula a owl:DatatypeProperty ;
    rdfs:label "Physical model formula"@en ;
    rdfs:comment "For example P = ρ g Q H η for the hydropower equation."@en ;
    rdfs:domain :PhysicalModel ;
    rdfs:range xsd:string ;
    skos:definition "The governing equation of a physical model."@en .

:physicalModelGoverningPrinciple a owl:DatatypeProperty ;
    rdfs:label "Physical model governing principle"@en ;
    rdfs:comment "For example conservation of energy or the kinetic energy flux of the wind."@en ;
    rdfs:domain :PhysicalModel ;
    rdfs:range xsd:string ;
    skos:definition "The physical principle from which a physical model is derived."@en .

:physicalModelParameters a owl:DatatypeProperty ;
    rdfs:label "Physical model parameters"@en ;
    rdfs:comment "For example ρ: water density ; Q: discharge ; H: head ; η: efficiency."@en ;
    rdfs:domain :PhysicalModel ;
    rdfs:range xsd:string ;
    skos:definition "The parameters of a physical model, with their meaning."@en .

:plantType a owl:DatatypeProperty ;
    rdfs:label "Plant type"@en ;
    rdfs:comment "Examples are run-of-river, reservoir (storage) and pumped-storage plants, and size classes such as pico, micro, mini or small hydropower."@en ;
    rdfs:domain :HydroDesignCharacteristics ;
    rdfs:range xsd:string ;
    skos:definition "The type of hydropower plant described by hydro design characteristics."@en .

:policyBindingness a owl:DatatypeProperty ;
    rdfs:label "Policy bindingness"@en ;
    rdfs:comment "Laws and regulations are binding; recommendations and plans may not be."@en ;
    rdfs:domain :Policy ;
    rdfs:range xsd:string ;
    skos:definition "Whether a policy is binding or voluntary."@en .

:policyDescription a owl:DatatypeProperty ;
    rdfs:label "Policy description"@en ;
    rdfs:comment "It explains what the policy does and how the study uses it."@en ;
    rdfs:domain :Policy ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "A short description of a policy as reported in a study."@en .

:policyEndYear a owl:DatatypeProperty ;
    rdfs:label "Policy end year"@en ;
    rdfs:comment "Stored as a year (xsd:gYear)."@en ;
    rdfs:domain :Policy ;
    rdfs:range xsd:gYear ;
    skos:broadMatch schema:endDate ;
    skos:definition "The year in which a policy ends."@en .

:policyImplementationStage a owl:DatatypeProperty ;
    rdfs:label "Policy implementation stage"@en ;
    rdfs:comment "For example, recommendation, adopted or in force."@en ;
    rdfs:domain :Policy ;
    rdfs:range xsd:string ;
    skos:definition "The stage of implementation of a policy."@en .

:policyJurisdiction a owl:DatatypeProperty ;
    rdfs:label "Policy jurisdiction"@en ;
    rdfs:comment "It may be a country, a region or a city; the country is also linked with appliesToCountry."@en ;
    rdfs:domain :Policy ;
    rdfs:range xsd:string ;
    skos:definition "The jurisdiction in which a policy applies, as written in the study."@en .

:policyName a owl:DatatypeProperty ;
    rdfs:label "Policy name"@en ;
    rdfs:comment "For example, Renewable Energy Independent Power Producer Procurement Programme."@en ;
    rdfs:domain :Policy ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of a policy."@en .

:policyStartYear a owl:DatatypeProperty ;
    rdfs:label "Policy start year"@en ;
    rdfs:comment "Stored as a year (xsd:gYear)."@en ;
    rdfs:domain :Policy ;
    rdfs:range xsd:gYear ;
    skos:broadMatch schema:startDate ;
    skos:definition "The year in which a policy starts."@en .

:policyStatus a owl:DatatypeProperty ;
    rdfs:label "Policy status"@en ;
    rdfs:comment "Recommendations made by the authors of a study are proposed policies."@en ;
    rdfs:domain :Policy ;
    rdfs:range xsd:string ;
    skos:definition "The status of a policy, such as proposed, approved, existing or scenario assumption."@en .

:policyTargetBasis a owl:DatatypeProperty ;
    rdfs:label "Policy target basis"@en ;
    rdfs:comment "For example, total power generation for a target expressed as a percentage."@en ;
    rdfs:domain :PolicyTarget ;
    rdfs:range xsd:string ;
    skos:definition "The quantity to which a policy target refers."@en .

:policyTargetLocation a owl:ObjectProperty ;
    rdfs:label "Policy target location"@en ;
    rdfs:comment "National targets are linked with appliesToCountry instead."@en ;
    rdfs:domain :PolicyTarget ;
    rdfs:range :Location ;
    skos:definition "Relates a policy target to a location where it applies."@en .

:policyTargetName a owl:DatatypeProperty ;
    rdfs:label "Policy target name"@en ;
    rdfs:comment "For example, renewable-energy supply target."@en ;
    rdfs:domain :PolicyTarget ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of a policy target."@en .

:policyTargetResource a owl:ObjectProperty ;
    rdfs:label "Policy target resource"@en ;
    rdfs:comment "For example, renewable energy as a whole, or wind energy."@en ;
    rdfs:domain :PolicyTarget ;
    rdfs:range :EnergyResource ;
    skos:definition "Relates a policy target to the energy resource that it concerns."@en .

:policyTargetStatus a owl:DatatypeProperty ;
    rdfs:label "Policy target status"@en ;
    rdfs:comment "For example, proposed or adopted."@en ;
    rdfs:domain :PolicyTarget ;
    rdfs:range xsd:string ;
    skos:definition "The status of a policy target."@en .

:policyTargetValue a owl:DatatypeProperty ;
    rdfs:label "Policy target value"@en ;
    rdfs:comment "It is expressed in the unit given by hasUnit, for example 23 percent or 8.4 gigawatts."@en ;
    rdfs:domain :PolicyTarget ;
    rdfs:range xsd:decimal ;
    skos:closeMatch <http://qudt.org/schema/qudt/value> ;
    skos:definition "The value of a policy target."@en .

:policyTargetYear a owl:DatatypeProperty ;
    rdfs:label "Policy target year"@en ;
    rdfs:comment "Stored as a year (xsd:gYear)."@en ;
    rdfs:domain :PolicyTarget ;
    rdfs:range xsd:gYear ;
    skos:definition "The year by which a policy target is to be reached."@en .

:powerCurveDescription a owl:DatatypeProperty ;
    rdfs:label "Power curve description"@en ;
    rdfs:comment "It gives the power output as a function of hub-height wind speed, for example as a table, a manufacturer reference or a fitted model."@en ;
    rdfs:domain :WindDesignCharacteristics ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "The description of the power curve of a wind turbine described by wind design characteristics."@en .

:producedByApplication a owl:ObjectProperty ;
    rdfs:label "Produced by application"@en ;
    rdfs:comment "For example a mean power density computed from the Weibull fit at a station."@en ;
    rdfs:domain :DerivedValue ;
    rdfs:range :ModelApplication ;
    skos:closeMatch prov:wasGeneratedBy ;
    skos:definition "Relates a derived value to the model application that produced it."@en .

:producesEnergyCarrier a owl:ObjectProperty ;
    rdfs:label "Produces energy carrier"@en ;
    rdfs:comment "Most systems in the corpus produce electricity."@en ;
    rdfs:domain :EnergySystem ;
    rdfs:range :EnergyCarrier ;
    skos:broadMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000533> ;
    skos:definition "Relates an energy system to the energy carrier that it produces."@en .

:producesImpact a owl:ObjectProperty ;
    rdfs:label "Produces impact"@en ;
    rdfs:comment "For example, a procurement programme produces new renewable capacity."@en ;
    rdfs:domain :Policy ;
    rdfs:range :Impact ;
    skos:definition "Relates a policy to an impact that it produces."@en .

:publicationType a owl:DatatypeProperty ;
    rdfs:label "Publication type"@en ;
    rdfs:comment "For example journal article, conference paper, review, thesis or report."@en ;
    rdfs:domain :Paper ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:type ;
    skos:definition "The type of publication of a paper."@en .

:reactorType a owl:DatatypeProperty ;
    rdfs:label "Reactor type"@en ;
    rdfs:comment "Examples are pressurised water reactor, boiling water reactor and small modular reactor."@en ;
    rdfs:domain :NuclearDesignCharacteristics ;
    rdfs:range xsd:string ;
    skos:definition "The type of nuclear reactor described by nuclear design characteristics."@en .

:reportedInStudy a owl:ObjectProperty ;
    rdfs:label "Reported in study"@en ;
    rdfs:comment "Each such element belongs to the study in which it is reported."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Analysis :Impact :ModelApplication :Condition :ConditionalFinding :PerformanceMetric :EconomicMetric :Scenario :DecisionCriterion :UncertaintyComponent :DesignCharacteristics :EnergySystemComponent ) ] ;
    rdfs:range :Study ;
    skos:definition "Relates an analysis, impact or model application to the study that reports it."@en ;
    skos:relatedMatch prov:wasGeneratedBy .

:reportedModelName a owl:DatatypeProperty ;
    rdfs:label "Reported model name"@en ;
    rdfs:comment "The canonical name is on the model node."@en ;
    rdfs:domain :ModelApplication ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of the model as written in the study."@en .

:reports a owl:ObjectProperty ;
    rdfs:label "Reports"@en ;
    rdfs:comment "Most papers report one study; the study holds the objectives, methods and findings, and the paper holds the bibliographic data."@en ;
    rdfs:domain :Paper ;
    rdfs:range :Study ;
    skos:broadMatch <http://purl.obolibrary.org/obo/IAO_0000136> ;
    skos:definition "Relates a paper to a study that it reports."@en .

:reportsCharacterization a owl:ObjectProperty ;
    rdfs:label "Reports characterization"@en ;
    rdfs:comment "A study may report many characterizations, for example one per site, variable or height."@en ;
    rdfs:domain :Study ;
    rdfs:range :ResourceCharacterization ;
    skos:definition "Relates a study to a resource characterization that it reports."@en .

:representsFactor a owl:ObjectProperty ;
    rdfs:label "Represents factor"@en ;
    rdfs:comment "For example the weakness 'high upfront cost' represents an economic barrier, so that SWOT results can be compared with factors from other studies."@en ;
    rdfs:domain :SWOTFactor ;
    rdfs:range :InfluencingFactor ;
    skos:definition "Relates a SWOT factor to the influencing factor that it represents."@en .

:researchProblemStatement a owl:DatatypeProperty ;
    rdfs:label "Research problem statement"@en ;
    rdfs:comment "For example 'the lack of reliable wind data limits wind farm planning in Cameroon'."@en ;
    rdfs:domain :ResearchProblem ;
    rdfs:range xsd:string ;
    skos:definition "The statement of a research problem as written in the study."@en .

:reservoirTemperature a owl:DatatypeProperty ;
    rdfs:label "Reservoir temperature"@en ;
    rdfs:comment "It is usually in °C; high-temperature fields above about 150 °C are suited to electricity generation. The unit is given by hasReservoirTemperatureUnit."@en ;
    rdfs:domain :GeothermalDesignCharacteristics ;
    rdfs:range xsd:decimal ;
    skos:definition "The temperature of the geothermal reservoir described by geothermal design characteristics."@en .

:resultOfMetric a owl:ObjectProperty ;
    rdfs:label "Result of metric"@en ;
    rdfs:comment "For example an evaluation result of 0.45 is a result of RMSE."@en ;
    rdfs:domain :EvaluationResult ;
    rdfs:range :EvaluationMetric ;
    skos:closeMatch <http://www.w3.org/ns/mls#specifiedBy> ;
    skos:definition "Relates an evaluation result to the evaluation metric whose value it gives."@en .

:scenarioDescription a owl:DatatypeProperty ;
    rdfs:label "Scenario description"@en ;
    rdfs:comment "For example 'RCP8.5 climate projection' or 'demand growth of 5% per year with no new hydropower'."@en ;
    rdfs:domain :Scenario ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "The textual description of a scenario."@en .

:scenarioEndYear a owl:DatatypeProperty ;
    rdfs:label "Scenario end year"@en ;
    rdfs:comment "It is given as a year, for example 2050."@en ;
    rdfs:domain :Scenario ;
    rdfs:range xsd:gYear ;
    skos:broadMatch schema:endDate ;
    skos:definition "The last year covered by a scenario."@en .

:scenarioName a owl:DatatypeProperty ;
    rdfs:label "Scenario name"@en ;
    rdfs:comment "For example 'RCP4.5', 'high demand' or 'baseline'."@en ;
    rdfs:domain :Scenario ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of a scenario as reported."@en .

:scenarioProbability a owl:DatatypeProperty ;
    rdfs:label "Scenario probability"@en ;
    rdfs:comment "It is given as a fraction or percentage; the unit is given by hasProbabilityUnit. Most scenarios in the literature have no stated probability."@en ;
    rdfs:domain :Scenario ;
    rdfs:range xsd:decimal ;
    skos:definition "The probability assigned to a scenario."@en .

:scenarioStartYear a owl:DatatypeProperty ;
    rdfs:label "Scenario start year"@en ;
    rdfs:comment "It is given as a year, for example 2020."@en ;
    rdfs:domain :Scenario ;
    rdfs:range xsd:gYear ;
    skos:broadMatch schema:startDate ;
    skos:definition "The first year covered by a scenario."@en .

:setsPolicyTarget a owl:ObjectProperty ;
    rdfs:label "Sets policy target"@en ;
    rdfs:comment "For example, a masterplan sets a share of renewable electricity to reach by a given year."@en ;
    rdfs:domain :Policy ;
    rdfs:range :PolicyTarget ;
    skos:definition "Relates a policy to a target that it sets."@en .

:siteSettingName a owl:DatatypeProperty ;
    rdfs:label "Site setting name"@en ;
    rdfs:comment "For example 'onshore', 'offshore', 'rooftop' or 'floating'."@en ;
    rdfs:domain :SiteSetting ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of a site setting."@en .

:storageTechnology a owl:DatatypeProperty ;
    rdfs:label "Storage technology"@en ;
    rdfs:comment "Examples are lithium-ion battery, lead-acid battery, pumped hydro storage, hydrogen storage and thermal storage."@en ;
    rdfs:domain :StorageDesignCharacteristics ;
    rdfs:range xsd:string ;
    skos:definition "The storage technology described by storage design characteristics."@en .

:studyDomain a owl:DatatypeProperty ;
    rdfs:label "Study domain"@en ;
    rdfs:comment "For example 'wind energy', 'solar energy', 'hydropower' or 'energy policy'."@en ;
    rdfs:domain :Study ;
    rdfs:range xsd:string ;
    skos:definition "The scientific or application domain of a study."@en .

:studyFutureWorks a owl:DatatypeProperty ;
    rdfs:label "Study future works"@en ;
    rdfs:comment "For example 'extend the analysis to hub-height measurements' or 'include economic assessment'."@en ;
    rdfs:domain :Study ;
    rdfs:range xsd:string ;
    skos:definition "The future work announced in a study."@en .

:studyKeyFindings a owl:DatatypeProperty ;
    rdfs:label "Study key findings"@en ;
    rdfs:comment "For example 'the Weibull distribution fits all sites best and the north has the highest wind potential'. It summarises the whole study, whereas analysisKeyOutcome summarises one analysis."@en ;
    rdfs:domain :Study ;
    rdfs:range xsd:string ;
    skos:definition "The main findings of a study as summarised from the paper."@en .

:studyLimits a owl:DatatypeProperty ;
    rdfs:label "Study limits"@en ;
    rdfs:comment "For example 'short data period', 'measurements only at 10 m' or 'no on-site validation'."@en ;
    rdfs:domain :Study ;
    rdfs:range xsd:string ;
    skos:definition "The limitations of a study as stated by its authors."@en .

:studyMethodsSummary a owl:DatatypeProperty ;
    rdfs:label "Study methods summary"@en ;
    rdfs:comment "For example 'Weibull fitting with five estimation methods, evaluated by RMSE and R2'."@en ;
    rdfs:domain :Study ;
    rdfs:range xsd:string ;
    skos:definition "A summary of the methods used in a study."@en .

:studyResearchGapAddressed a owl:DatatypeProperty ;
    rdfs:label "Study research gap addressed"@en ;
    rdfs:comment "For example 'no previous assessment of wind resources in the Adamawa region'."@en ;
    rdfs:domain :Study ;
    rdfs:range xsd:string ;
    skos:definition "The research gap that a study claims to address."@en .

:studyResearchGapIdentified a owl:DatatypeProperty ;
    rdfs:label "Study research gap identified"@en ;
    rdfs:comment "For example 'lack of long-term measurements at hub height'. It differs from studyResearchGapAddressed, which the study itself fills."@en ;
    rdfs:domain :Study ;
    rdfs:range xsd:string ;
    skos:definition "A research gap that a study identifies for future research."@en .

:swotFactorStatement a owl:DatatypeProperty ;
    rdfs:label "Swot factor statement"@en ;
    rdfs:comment "For example 'abundant hydropower potential' (strength) or 'weak grid infrastructure' (weakness)."@en ;
    rdfs:domain :SWOTFactor ;
    rdfs:range xsd:string ;
    skos:definition "The statement of a SWOT factor as written in the study."@en .

:targetsEnergyResource a owl:ObjectProperty ;
    rdfs:label "Targets energy resource"@en ;
    rdfs:comment "For example, a levy targets electricity from non-renewable resources."@en ;
    rdfs:domain :Policy ;
    rdfs:range :EnergyResource ;
    skos:definition "Relates a policy to the energy resource that it targets."@en .

:terrainName a owl:DatatypeProperty ;
    rdfs:label "Terrain name"@en ;
    rdfs:comment "For example 'Adamawa plateau' or 'coastal plain'. The class of the terrain node gives its normalised type."@en ;
    rdfs:domain :Terrain ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of a terrain as reported in a study."@en .

:thermalPower a owl:DatatypeProperty ;
    rdfs:label "Thermal power"@en ;
    rdfs:comment "It is usually in MWth; the electrical output is roughly one third of it. The unit is given by hasThermalPowerUnit."@en ;
    rdfs:domain :NuclearDesignCharacteristics ;
    rdfs:range xsd:decimal ;
    skos:definition "The thermal power of the reactor described by nuclear design characteristics."@en .

:tidalRange a owl:DatatypeProperty ;
    rdfs:label "Tidal range"@en ;
    rdfs:comment "It is the vertical difference between high and low tide, usually in metres; the unit is given by hasTidalRangeUnit."@en ;
    rdfs:domain :OceanPlantDesignCharacteristics ;
    rdfs:range xsd:decimal ;
    skos:definition "The tidal range at the site of an ocean energy plant described by ocean plant design characteristics."@en .

:timeSeriesModelFormula a owl:DatatypeProperty ;
    rdfs:label "Time series model formula"@en ;
    rdfs:comment "For example the ARIMA(p,d,q) equation."@en ;
    rdfs:domain :TimeSeriesModel ;
    rdfs:range xsd:string ;
    skos:definition "The standard equation of a time-series model."@en .

:timeSeriesModelParameters a owl:DatatypeProperty ;
    rdfs:label "Time series model parameters"@en ;
    rdfs:comment "For example p: autoregressive order ; d: differencing order ; q: moving-average order."@en ;
    rdfs:domain :TimeSeriesModel ;
    rdfs:range xsd:string ;
    skos:definition "The parameters of a time-series model, with their meaning."@en .

:toolCategory a owl:DatatypeProperty ;
    rdfs:label "Tool category"@en ;
    rdfs:comment "For example programming language, GIS, statistical software or renewable energy simulation software."@en ;
    rdfs:domain :SoftwareTool ;
    rdfs:range xsd:string ;
    skos:closeMatch schema:applicationCategory ;
    skos:definition "The category of a software tool."@en .

:toolName a owl:DatatypeProperty ;
    rdfs:label "Tool name"@en ;
    rdfs:comment "For example MATLAB, R, Python, HOMER, WAsP, PVsyst or QGIS."@en ;
    rdfs:domain :SoftwareTool ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of a software tool."@en .

:toolVersion a owl:DatatypeProperty ;
    rdfs:label "Tool version"@en ;
    rdfs:comment "For example 'R 4.2.1' or 'HOMER Pro 3.14'."@en ;
    rdfs:domain :SoftwareTool ;
    rdfs:range xsd:string ;
    skos:definition "The version of a software tool used in a study."@en ;
    skos:exactMatch schema:softwareVersion .

:trackingType a owl:DatatypeProperty ;
    rdfs:label "Tracking type"@en ;
    rdfs:comment "Values are fixed, single-axis or dual-axis tracking."@en ;
    rdfs:domain :SolarDesignCharacteristics ;
    rdfs:range xsd:string ;
    skos:definition "The sun-tracking type of a solar array described by solar design characteristics."@en .

:turbineAxisType a owl:DatatypeProperty ;
    rdfs:label "Turbine axis type"@en ;
    rdfs:comment "Values are horizontal-axis (HAWT) or vertical-axis (VAWT), such as Darrieus or Savonius turbines."@en ;
    rdfs:domain :WindDesignCharacteristics ;
    rdfs:range xsd:string ;
    skos:definition "The orientation of the rotor axis of a wind turbine described by wind design characteristics."@en .

:turbineType a owl:DatatypeProperty ;
    rdfs:label "Turbine type"@en ;
    rdfs:comment "Examples are Francis, Kaplan, Pelton, Turgo and cross-flow turbines; the choice depends on head and flow."@en ;
    rdfs:domain :HydroDesignCharacteristics ;
    rdfs:range xsd:string ;
    skos:definition "The type of hydro turbine described by hydro design characteristics."@en .

:uncertaintyAnalysisHasComponent a owl:ObjectProperty ;
    rdfs:label "Uncertainty analysis has component"@en ;
    rdfs:comment "For example a wind resource uncertainty analysis with components for measurement, long-term correction and extrapolation."@en ;
    rdfs:domain :UncertaintyAnalysis ;
    rdfs:range :UncertaintyComponent ;
    skos:definition "Relates an uncertainty analysis to an uncertainty component that it considers."@en .

:uncertaintyComponentDescription a owl:DatatypeProperty ;
    rdfs:label "Uncertainty component description"@en ;
    rdfs:comment "For example 'uncertainty due to the vertical extrapolation of wind speed from 10 m to hub height'."@en ;
    rdfs:domain :UncertaintyComponent ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "The textual description of an uncertainty component."@en .

:uncertaintyComponentDistribution a owl:DatatypeProperty ;
    rdfs:label "Uncertainty component distribution"@en ;
    rdfs:comment "For example normal, uniform or triangular."@en ;
    rdfs:domain :UncertaintyComponent ;
    rdfs:range xsd:string ;
    skos:definition "The probability distribution assumed for an uncertainty component."@en .

:uncertaintyComponentForApplication a owl:ObjectProperty ;
    rdfs:label "Uncertainty component for application"@en ;
    rdfs:comment "For example the parameter uncertainty of a Weibull fit at a station."@en ;
    rdfs:domain :UncertaintyComponent ;
    rdfs:range :ModelApplication ;
    skos:definition "Relates an uncertainty component to the model application whose uncertainty it describes."@en .

:uncertaintyComponentForVariable a owl:ObjectProperty ;
    rdfs:label "Uncertainty component for variable"@en ;
    rdfs:comment "For example the uncertainty of the annual mean wind speed or of the annual energy production."@en ;
    rdfs:domain :UncertaintyComponent ;
    rdfs:range :Variable ;
    skos:definition "Relates an uncertainty component to the variable whose uncertainty it describes."@en .

:uncertaintyComponentName a owl:DatatypeProperty ;
    rdfs:label "Uncertainty component name"@en ;
    rdfs:comment "For example anemometer calibration, long-term correction, vertical extrapolation or power curve uncertainty."@en ;
    rdfs:domain :UncertaintyComponent ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The name of an uncertainty component."@en .

:uncertaintyComponentValue a owl:DatatypeProperty ;
    rdfs:label "Uncertainty component value"@en ;
    rdfs:comment "It is often a standard uncertainty in percent of the wind speed or energy yield, for example 2%; the unit is given by hasUnit."@en ;
    rdfs:domain :UncertaintyComponent ;
    rdfs:range xsd:decimal ;
    skos:closeMatch <http://qudt.org/schema/qudt/value> ;
    skos:definition "The magnitude of an uncertainty component."@en .

:underCondition a owl:ObjectProperty ;
    rdfs:label "Under condition"@en ;
    rdfs:comment "For example a finding that holds for wind speeds below 5 m/s or for the dry season."@en ;
    rdfs:domain :ConditionalFinding ;
    rdfs:range :Condition ;
    skos:definition "Relates a conditional finding to a condition under which it holds."@en .

:unitSymbol a owl:DatatypeProperty ;
    rdfs:label "Unit symbol"@en ;
    rdfs:comment "Examples are m/s for metre per second and W/m² for watt per square metre. It corresponds to the Wikidata property unit symbol."@en ;
    rdfs:domain :UnitOfMeasurement ;
    rdfs:range xsd:string ;
    skos:definition "The symbol used to denote a unit of measurement."@en ;
    skos:exactMatch <http://qudt.org/schema/qudt/symbol> .

:usesDataset a owl:ObjectProperty ;
    rdfs:label "Uses dataset"@en ;
    rdfs:comment "For a model application, it is the data to which the model is fitted or on which it is tested."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Analysis :ModelApplication :Study ) ] ;
    rdfs:range :Dataset ;
    skos:broadMatch <http://purl.obolibrary.org/obo/OBI_0000293>,
        prov:used ;
    skos:definition "Relates a study, analysis or model application to a dataset that it uses."@en .

:usesEnergyResource a owl:ObjectProperty ;
    rdfs:label "Uses energy resource"@en ;
    rdfs:comment "For example wind energy for a wind turbine or hydro energy for a hydropower plant; a hybrid system uses several resources."@en ;
    rdfs:domain :EnergySystem ;
    rdfs:range :EnergyResource ;
    skos:definition "Relates an energy system to the energy resource that it converts."@en ;
    skos:relatedMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000503> .

:usesEstimationMethod a owl:ObjectProperty ;
    rdfs:label "Uses estimation method"@en ;
    rdfs:comment "For example maximum likelihood for Weibull parameters."@en ;
    rdfs:domain :ModelApplication ;
    rdfs:range :ParameterEstimationMethod ;
    skos:definition "Relates a model application to the method used to estimate the model parameters."@en .

:usesEvaluationMetric a owl:ObjectProperty ;
    rdfs:label "Uses evaluation metric"@en ;
    rdfs:comment "For example RMSE, R2 and the Kolmogorov-Smirnov statistic for comparing distributions."@en ;
    rdfs:domain :Study ;
    rdfs:range :EvaluationMetric ;
    skos:definition "Relates a study to an evaluation metric that it uses."@en .

:usesOptimizationAlgorithm a owl:ObjectProperty ;
    rdfs:label "Uses optimization algorithm"@en ;
    rdfs:comment "For example a genetic algorithm used to tune a model."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ModelApplication :ParameterEstimationMethod ) ] ;
    rdfs:range :OptimizationAlgorithm ;
    skos:definition "Relates a model application or estimation method to an optimization algorithm that it uses."@en .

:usesTool a owl:ObjectProperty ;
    rdfs:label "Uses tool"@en ;
    rdfs:comment "For example MATLAB or an R package."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Analysis :ModelApplication :Study ) ] ;
    rdfs:range :SoftwareTool ;
    skos:broadMatch prov:used ;
    skos:definition "Relates an analysis or model application to a software tool that it uses."@en .

:usesVariable a owl:ObjectProperty ;
    rdfs:label "Uses variable"@en ;
    rdfs:comment "For example the empirical method for Weibull parameters uses the mean and standard deviation of wind speed."@en ;
    rdfs:domain :ParameterEstimationMethod ;
    rdfs:range :Variable ;
    skos:definition "Relates a parameter estimation method to a variable that it uses."@en .

:variableDescription a owl:DatatypeProperty ;
    rdfs:label "Variable description"@en ;
    rdfs:comment "Descriptions written by individual studies are kept in the auxiliary files; the shared node carries its own definition."@en ;
    rdfs:domain :Variable ;
    rdfs:range xsd:string ;
    skos:broadMatch dcterms:description ;
    skos:definition "A description of a variable as given in a study."@en .

:variableName a owl:DatatypeProperty ;
    rdfs:label "Variable name"@en ;
    rdfs:comment "Names keep the temporal qualifiers and heights stated by the studies, for example daily global solar radiation or wind speed at 50 m."@en ;
    rdfs:domain :Variable ;
    rdfs:range xsd:string ;
    skos:broadMatch schema:name ;
    skos:definition "The standardized name of a variable."@en .

:variableSymbol a owl:DatatypeProperty ;
    rdfs:label "Variable symbol"@en ;
    rdfs:comment "Symbols differ between studies, for example v, V or U for wind speed, so they are kept in the auxiliary files rather than on the shared node."@en ;
    rdfs:domain :Variable ;
    rdfs:range xsd:string ;
    skos:closeMatch <http://qudt.org/schema/qudt/symbol> ;
    skos:definition "The symbol used for a variable in a study."@en .

:waveHeight a owl:DatatypeProperty ;
    rdfs:label "Wave height"@en ;
    rdfs:comment "It is usually in metres; the unit is given by hasWaveHeightUnit."@en ;
    rdfs:domain :OceanPlantDesignCharacteristics ;
    rdfs:range xsd:decimal ;
    skos:definition "The significant wave height at the site of an ocean energy plant described by ocean plant design characteristics."@en .

:wellDepth a owl:DatatypeProperty ;
    rdfs:label "Well depth"@en ;
    rdfs:comment "It is usually in metres, often 1,000–3,000 m; the unit is given by hasWellDepthUnit."@en ;
    rdfs:domain :GeothermalDesignCharacteristics ;
    rdfs:range xsd:decimal ;
    skos:definition "The depth of a geothermal well described by geothermal design characteristics."@en .

:windPowerClassLabel a owl:DatatypeProperty ;
    rdfs:label "Wind power class label"@en ;
    rdfs:comment "For the NREL classification, labels are Poor, Marginal, Fair, Good, Excellent, Outstanding and Superb."@en ;
    rdfs:domain :WindPowerClass ;
    rdfs:range xsd:string ;
    skos:definition "The label of a wind power class."@en .

:windPowerClassNumber a owl:DatatypeProperty ;
    rdfs:label "Wind power class number"@en ;
    rdfs:comment "In the NREL classification it ranges from 1 (lowest wind power density) to 7 (highest)."@en ;
    rdfs:domain :WindPowerClass ;
    rdfs:range xsd:integer ;
    skos:definition "The number of a wind power class."@en .

:BiomassEnergySystem a owl:Class ;
    rdfs:label "Biomass energy system"@en ;
    rdfs:comment "Biomass systems burn, gasify or digest organic matter, such as wood, crop residues or waste, to produce heat, electricity or fuels."@en ;
    rdfs:subClassOf :EnergySystem ;
    skos:definition "An energy system that produces energy from biomass."@en ;
    skos:narrowMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000036> .

:CopulaModel a owl:Class ;
    rdfs:label "Copula model"@en ;
    rdfs:comment "Copulas separate the marginal behaviour of each variable from their dependence structure."@en ;
    rdfs:subClassOf :BivariateDistribution ;
    skos:definition "A multivariate distribution built by joining marginal distributions with a copula function that describes their dependence."@en .

:DataAnalysis a owl:Class ;
    rdfs:label "Data analysis"@en ;
    rdfs:comment "Data analysis covers the quantitative work done on measured or modelled data: summarizing it, describing its variability and distribution, relating variables to each other or examining their spatial pattern. It corresponds to the Wikidata class data analysis."@en ;
    rdfs:subClassOf :Analysis ;
    skos:closeMatch <http://purl.obolibrary.org/obo/OBI_0200000> ;
    skos:definition "An analysis that inspects, transforms or models data in order to gain insight from it."@en .

:DescriptiveApplication a owl:Class ;
    rdfs:label "Descriptive application"@en ;
    rdfs:comment "Typical examples are fitting Weibull or mixture distributions to wind-speed data and estimating their parameters."@en ;
    rdfs:subClassOf :ModelApplication ;
    skos:definition "A model application that describes or characterizes data, such as fitting a probability distribution."@en .

:GeothermalEnergySystem a owl:Class ;
    rdfs:label "Geothermal energy system"@en ;
    rdfs:comment "Geothermal systems produce electricity from high-temperature reservoirs or supply heat directly from lower-temperature resources."@en ;
    rdfs:subClassOf :EnergySystem ;
    skos:definition "An energy system that uses heat from the interior of the Earth."@en ;
    skos:narrowMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000192> .

:HybridEnergySystem a owl:Class ;
    rdfs:label "Hybrid energy system"@en ;
    rdfs:comment "Examples are PV with wind, or PV with a diesel generator and batteries. Combining sources smooths variability, since resources such as sun and wind often peak at different times."@en ;
    rdfs:subClassOf :EnergySystem ;
    skos:definition "An energy system that combines two or more energy sources."@en .

:HybridModel a owl:Class ;
    rdfs:label "Hybrid model"@en ;
    rdfs:comment "Typical hybrids couple a machine-learning model with a metaheuristic optimizer or a decomposition method to improve accuracy."@en ;
    rdfs:subClassOf :Model ;
    skos:definition "A model that combines two or more models or techniques into one."@en .

:HydrogenEnergySystem a owl:Class ;
    rdfs:label "Hydrogen energy system"@en ;
    rdfs:comment "A typical hydrogen system is an electrolyser powered by renewable electricity, with storage and fuel cells or other end uses."@en ;
    rdfs:subClassOf :EnergySystem ;
    skos:definition "An energy system that produces, stores or uses hydrogen as an energy carrier."@en .

:HydropowerEnergySystem a owl:Class ;
    rdfs:label "Hydropower energy system"@en ;
    rdfs:comment "Hydropower systems include run-of-river, reservoir and pumped-storage plants, from micro to large scale."@en ;
    rdfs:subClassOf :EnergySystem ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00010086> ;
    skos:definition "An energy system that converts the energy of flowing or falling water into electricity."@en .

:KernelBasedModel a owl:Class ;
    rdfs:label "Kernel-based model"@en ;
    rdfs:comment "Kernel methods capture nonlinear relationships while keeping the learning problem convex."@en ;
    rdfs:subClassOf :MachineLearningModel ;
    skos:definition "A machine-learning model that uses kernel functions to work in a high-dimensional feature space."@en .

:MultivariateDistribution a owl:Class ;
    rdfs:label "Multivariate distribution"@en ;
    rdfs:comment "Multivariate distributions describe dependence, for example between wind speed and wind direction."@en ;
    rdfs:subClassOf :ContinuousProbabilityDistribution ;
    skos:definition "A continuous probability distribution of several random variables considered jointly."@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/STATO_0000538> .

:NuclearEnergySystem a owl:Class ;
    rdfs:label "Nuclear energy system"@en ;
    rdfs:comment "Nuclear power plants use the heat released by nuclear fission to drive steam turbines."@en ;
    rdfs:subClassOf :EnergySystem ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000303> ;
    skos:definition "An energy system that produces energy from nuclear reactions."@en .

:OceanEnergySystem a owl:Class ;
    rdfs:label "Ocean energy system"@en ;
    rdfs:comment "Ocean energy includes tidal, wave and ocean current energy and ocean thermal energy conversion."@en ;
    rdfs:subClassOf :EnergySystem ;
    skos:definition "An energy system that produces energy from the ocean."@en ;
    skos:narrowMatch <https://openenergyplatform.org/ontology/oeo/OEO_00010112>,
        <https://openenergyplatform.org/ontology/oeo/OEO_00010113> .

:ReferencePlane a owl:Class ;
    rdfs:label "Reference plane"@en ;
    rdfs:comment "Common reference planes are the ground level (above ground level, AGL) and mean sea level (above sea level, ASL). A height of 50 m does not designate the same position above the ground and above the sea, so the reference plane is needed to interpret and compare heights."@en ;
    skos:definition "A reference level from which a height or elevation is measured."@en .

:SolarEnergySystem a owl:Class ;
    rdfs:label "Solar energy system"@en ;
    rdfs:comment "Solar energy systems include photovoltaic systems, concentrated solar power plants and solar thermal systems."@en ;
    rdfs:subClassOf :EnergySystem ;
    skos:definition "An energy system that converts solar radiation into electricity or heat."@en ;
    skos:narrowMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000386> .

:StorageComponent a owl:Class ;
    rdfs:label "Storage component"@en ;
    rdfs:comment "Examples are battery banks, pumped-storage reservoirs, hydrogen tanks and thermal storage. Its technical data are given by storage design characteristics."@en ;
    rdfs:subClassOf :EnergySystemComponent ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000159> ;
    skos:definition "An energy system component that stores energy for later use."@en .

:TemperateClimate a owl:Class ;
    rdfs:label "Temperate climate"@en ;
    rdfs:comment "Temperate climates have distinct seasons without severe winters. They include humid subtropical, oceanic and Mediterranean climates, which differ mainly in when and how much rain falls."@en ;
    rdfs:subClassOf :Climate ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01000206> ;
    skos:definition "A climate with mild winters, whose coldest month averages between 0 °C (or −3 °C) and 18 °C (Köppen group C)."@en .

:TemporalResolution a owl:Class ;
    rdfs:label "Temporal resolution"@en ;
    rdfs:comment "Examples are 10-minute, hourly, daily, monthly or annual values. Fine resolutions capture short-term variability, such as gusts or the daily cycle, which coarser averages smooth out; statistics such as the standard deviation or the maximum therefore depend on the resolution."@en ;
    skos:definition "The time interval between successive values of a data series, or the period over which values are aggregated."@en ;
    skos:exactMatch <https://openenergyplatform.org/ontology/oeo/OEO_00020122> .

:UncertaintyAnalysis a owl:Class ;
    rdfs:label "Uncertainty analysis"@en ;
    rdfs:comment "Uncertainty analysis quantifies how uncertain inputs, parameters or data affect results, and includes sensitivity analysis, which identifies the inputs that most influence an output. It corresponds to the Wikidata class uncertainty analysis."@en ;
    rdfs:subClassOf :Analysis ;
    skos:definition "An analysis that investigates the uncertainty of variables or results used in decision-making."@en ;
    skos:narrowMatch <https://openenergyplatform.org/ontology/oeo/OEO_00010051> .

:UnivariateDistribution a owl:Class ;
    rdfs:label "Univariate distribution"@en ;
    rdfs:comment "Most wind-speed distributions are univariate."@en ;
    rdfs:subClassOf :ContinuousProbabilityDistribution ;
    skos:definition "A continuous probability distribution of a single random variable."@en .

:WindEnergySystem a owl:Class ;
    rdfs:label "Wind energy system"@en ;
    rdfs:comment "Wind energy systems include single wind turbines, wind farms and wind pumping systems."@en ;
    rdfs:subClassOf :EnergySystem ;
    skos:definition "An energy system that converts the kinetic energy of the wind into useful energy."@en ;
    skos:narrowMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000044>,
        <https://openenergyplatform.org/ontology/oeo/OEO_00000447> .

:AridClimate a owl:Class ;
    rdfs:label "Arid climate"@en ;
    rdfs:comment "Arid climates are defined by a lack of water rather than by temperature: the atmosphere could evaporate more water than falls as rain. The group covers both deserts and the drier steppes or semi-arid zones that border them."@en ;
    rdfs:subClassOf :Climate ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01000230> ;
    skos:definition "A climate in which potential evaporation exceeds precipitation (Köppen group B)."@en .

:BiomassComponent a owl:Class ;
    rdfs:label "Biomass component"@en ;
    rdfs:comment "Examples are boilers, gasifiers, anaerobic digesters, biogas engines and steam turbines fed with biomass. Its technical data are given by biomass design characteristics."@en ;
    rdfs:subClassOf :EnergySystemComponent ;
    skos:definition "An energy system component that belongs to a biomass energy system."@en .

:BivariateDistribution a owl:Class ;
    rdfs:label "Bivariate distribution"@en ;
    rdfs:comment "Bivariate distributions are used for the joint behaviour of wind speed and direction or of two sites."@en ;
    rdfs:subClassOf :MultivariateDistribution ;
    skos:definition "A multivariate distribution of two random variables."@en .

:ContinuousProbabilityDistribution a owl:Class ;
    rdfs:label "Continuous probability distribution"@en ;
    rdfs:comment "Wind speed, solar radiation and discharge are modelled with continuous distributions."@en ;
    rdfs:subClassOf :ProbabilityDistributionModel ;
    skos:definition "A probability distribution of a variable that can take any value in a continuous range."@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/STATO_0000067> .

:EnsembleTreeModel a owl:Class ;
    rdfs:label "Ensemble tree model"@en ;
    rdfs:comment "Combining trees reduces variance or bias compared with a single tree; bagging and boosting are the two main strategies."@en ;
    rdfs:subClassOf :TreeBasedModel ;
    skos:definition "A tree-based model that combines the predictions of many decision trees."@en ;
    skos:relatedMatch <http://purl.obolibrary.org/obo/STATO_0000549> .

:GeothermalComponent a owl:Class ;
    rdfs:label "Geothermal component"@en ;
    rdfs:comment "Examples are production and injection wells, heat exchangers, separators and turbines. Its technical data are given by geothermal design characteristics."@en ;
    rdfs:subClassOf :EnergySystemComponent ;
    skos:definition "An energy system component that belongs to a geothermal energy system."@en .

:HydroComponent a owl:Class ;
    rdfs:label "Hydro component"@en ;
    rdfs:comment "Examples are dams, intakes, penstocks, turbines and generators. Its technical data are given by hydro design characteristics."@en ;
    rdfs:subClassOf :EnergySystemComponent ;
    skos:definition "An energy system component that belongs to a hydropower energy system."@en ;
    skos:narrowMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000442> .

:HydrogenComponent a owl:Class ;
    rdfs:label "Hydrogen component"@en ;
    rdfs:comment "Examples are electrolysers, compressors, storage tanks and fuel cells. Its technical data are given by hydrogen plant design characteristics."@en ;
    rdfs:subClassOf :EnergySystemComponent ;
    skos:definition "An energy system component that belongs to a hydrogen energy system."@en .

:Metric a owl:Class ;
    rdfs:label "Metric"@en ;
    rdfs:comment "It is the general class of evaluation metrics and economic metrics. A metric is the definition, such as RMSE or LCOE; the numbers obtained in a study are recorded as evaluation results or metric values."@en ;
    skos:definition "A quantity defined to measure, compare or rank a model, system, resource or alternative."@en .

:NuclearComponent a owl:Class ;
    rdfs:label "Nuclear component"@en ;
    rdfs:comment "Examples are the reactor, steam generators, cooling systems and turbines. Its technical data are given by nuclear design characteristics."@en ;
    rdfs:subClassOf :EnergySystemComponent ;
    skos:definition "An energy system component that belongs to a nuclear energy system."@en .

:OceanComponent a owl:Class ;
    rdfs:label "Ocean component"@en ;
    rdfs:comment "Examples are wave energy converters, tidal stream turbines, barrages and power take-off systems. Its technical data are given by ocean plant design characteristics."@en ;
    rdfs:subClassOf :EnergySystemComponent ;
    skos:definition "An energy system component that belongs to an ocean energy system."@en .

:OceanEnergy a owl:Class ;
    rdfs:label "Ocean energy"@en ;
    rdfs:comment "Its main subclasses are wave energy and tidal energy. Offshore wind is not ocean energy: it belongs to wind energy."@en ;
    rdfs:subClassOf :RenewableEnergyResource ;
    skos:definition "A renewable energy resource consisting of the energy carried by ocean waves, tides, currents or thermal and salinity gradients."@en .

:PredictiveApplication a owl:Class ;
    rdfs:label "Predictive application"@en ;
    rdfs:comment "Typical examples are estimating solar radiation from sunshine and temperature, or forecasting wind speed or hydropower generation."@en ;
    rdfs:subClassOf :ModelApplication ;
    owl:disjointWith :DescriptiveApplication ;
    skos:definition "A model application that estimates or forecasts a target variable from input variables."@en .

:SWOTAnalysis a owl:Class ;
    rdfs:label "SWOT analysis"@en ;
    rdfs:comment "SWOT analysis is a strategic planning analysis that structures internal factors (strengths, weaknesses) and external factors (opportunities, threats). In energy research it is used to assess technologies, policies or deployment options."@en ;
    rdfs:subClassOf :Analysis ;
    skos:definition "An analysis of the strengths, weaknesses, opportunities and threats of an organization, project or technology."@en .

:SiteSetting a owl:Class ;
    rdfs:label "Site setting"@en ;
    rdfs:comment "Examples are onshore, offshore, rooftop, ground-mounted, floating or run-of-river settings. It differs from terrain, which describes the landform of the location itself."@en ;
    skos:definition "A category describing the physical or built setting in which an energy system is installed."@en .

:SolarComponent a owl:Class ;
    rdfs:label "Solar component"@en ;
    rdfs:comment "Examples are PV modules, inverters, charge controllers, mounting and tracking structures and solar collectors. Its technical data are given by solar design characteristics."@en ;
    rdfs:subClassOf :EnergySystemComponent ;
    skos:definition "An energy system component that belongs to a solar energy system."@en ;
    skos:narrowMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000032> .

:StatisticalModel a owl:Class ;
    rdfs:label "Statistical model"@en ;
    rdfs:comment "Statistical models include probability distributions, regression models and filters used for estimation."@en ;
    rdfs:subClassOf :DataDrivenModel ;
    skos:closeMatch <http://purl.obolibrary.org/obo/STATO_0000107> ;
    skos:definition "A data-driven model that describes data with probability distributions or statistical relationships."@en .

:StorageDesignCharacteristics a owl:Class ;
    rdfs:label "Storage design characteristics"@en ;
    rdfs:comment "Typical values are the storage technology, the storage capacity in kWh or MWh, the round-trip efficiency and the allowed depth of discharge."@en ;
    rdfs:subClassOf :DesignCharacteristics ;
    skos:definition "A set of design characteristics that describes the technical specification of an energy storage system or component."@en .

:SymbolicModel a owl:Class ;
    rdfs:label "Symbolic model"@en ;
    rdfs:comment "Symbolic models include empirical and physical equations, as well as multi-criteria decision methods and conceptual frameworks."@en ;
    rdfs:subClassOf :Model ;
    skos:broadMatch <https://openenergyplatform.org/ontology/oeo/OEO_00020354> ;
    skos:definition "A model expressed by explicit equations, rules or structured reasoning rather than learned from data."@en .

:TimeSeriesModel a owl:Class ;
    rdfs:label "Time series model"@en ;
    rdfs:comment "ARIMA, SARIMA and Holt-Winters models are used to forecast wind speed, irradiance and inflow."@en ;
    rdfs:subClassOf :DataDrivenModel ;
    skos:definition "A data-driven model that describes a variable through its own past values and past errors over time."@en .

:TreeBasedModel a owl:Class ;
    rdfs:label "Tree-based model"@en ;
    rdfs:comment "Tree-based models include single decision trees and ensembles of trees such as random forests and gradient boosting."@en ;
    rdfs:subClassOf :MachineLearningModel ;
    skos:definition "A machine-learning model that makes predictions by recursively splitting the input space into regions."@en .

:WindComponent a owl:Class ;
    rdfs:label "Wind component"@en ;
    rdfs:comment "Examples are the wind turbine, rotor, blades, gearbox, generator and tower. Its technical data are given by wind design characteristics."@en ;
    rdfs:subClassOf :EnergySystemComponent ;
    skos:definition "An energy system component that belongs to a wind energy system."@en ;
    skos:narrowMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000448> .

:DataDrivenModel a owl:Class ;
    rdfs:label "Data driven model"@en ;
    rdfs:comment "Data-driven models include statistical models, time-series models and machine-learning models."@en ;
    rdfs:subClassOf :Model ;
    skos:definition "A model whose structure or parameters are learned from data rather than derived from physical laws."@en .

:EmpiricalModel a owl:Class ;
    rdfs:label "Empirical model"@en ;
    rdfs:comment "Examples are the Angström-Prescott model for solar radiation and the power law for wind shear; their coefficients depend on the site."@en ;
    rdfs:subClassOf :SymbolicModel ;
    skos:definition "A symbolic model whose equation is fitted to observations rather than derived from physical laws."@en .

:EnergyCarrier a owl:Class ;
    rdfs:label "Energy carrier"@en ;
    rdfs:comment "Energy carriers, such as electricity or hydrogen, move energy from where it is produced to where it is used. They differ from energy resources, such as wind or sunlight, which are found in nature."@en ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00020039> ;
    skos:definition "A substance or phenomenon that can be used to produce mechanical work or heat or to operate chemical or physical processes."@en .

:HydroDesignCharacteristics a owl:Class ;
    rdfs:label "Hydro design characteristics"@en ;
    rdfs:comment "Typical values are the gross and net head in metres, the design flow in m3/s, the turbine type and efficiency, and the reservoir capacity."@en ;
    rdfs:subClassOf :DesignCharacteristics ;
    skos:definition "A set of design characteristics that describes the technical specification of a hydropower system or component."@en .

:OptimizationAlgorithm a owl:Class ;
    rdfs:label "Optimization algorithm"@en ;
    rdfs:comment "In renewable-energy studies, optimization algorithms such as genetic algorithms or particle swarm optimization tune model parameters and hyperparameters or size energy systems."@en ;
    skos:broadMatch <http://purl.obolibrary.org/obo/IAO_0000064>,
        <http://www.w3.org/ns/mls#Algorithm> ;
    skos:definition "An algorithm that searches for the values of variables that minimize or maximize an objective function."@en .

:ProcessBasedModel a owl:Class ;
    rdfs:label "Process-based model"@en ;
    rdfs:comment "Process-based models include climate, hydrological and hydrodynamic models. They range from physically based models that solve conservation equations to conceptual models built from storages calibrated against observations."@en ;
    rdfs:subClassOf :PhysicalModel ;
    skos:broadMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000371> ;
    skos:definition "A physical model that simulates the physical processes of a system over space and time."@en .

:SoftwareLibrary a owl:Class ;
    rdfs:label "Software library"@en ;
    rdfs:comment "Examples are TensorFlow, Keras and scikit-learn."@en ;
    rdfs:subClassOf :SoftwareTool ;
    skos:closeMatch <http://purl.obolibrary.org/obo/IAO_0000593> ;
    skos:definition "A software library or framework used to implement models."@en .

:SolarDesignCharacteristics a owl:Class ;
    rdfs:label "Solar design characteristics"@en ;
    rdfs:comment "Typical values are the cell technology, the module nominal power in Wp, the module efficiency, the tilt and azimuth angles and the tracking type."@en ;
    rdfs:subClassOf :DesignCharacteristics ;
    skos:definition "A set of design characteristics that describes the technical specification of a solar energy system or component."@en .

:UnitOfMeasurement a owl:Class ;
    rdfs:label "Unit of measurement"@en ;
    rdfs:comment "Units are shared nodes reused by every value in the graph, such as metre per second for wind speed or cubic metre per second for river discharge. Sharing them makes values in the same unit retrievable together and allows conversion between units. It corresponds to the Wikidata class unit of measurement."@en ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00010489> ;
    skos:definition "A definite magnitude of a quantity, adopted by convention, used as a standard for measuring quantities of the same kind."@en ;
    skos:exactMatch <http://qudt.org/schema/qudt/Unit> .

:WindPowerClass a owl:Class ;
    rdfs:label "Wind power class"@en ;
    rdfs:comment "Wind power classes, as defined by NREL, rank sites from class 1 (poor) to class 7 (superb) according to their mean wind power density, giving a quick indication of how suitable a site is for wind energy."@en ;
    skos:definition "A class of wind resource defined by ranges of mean wind power density."@en .

:BiomassDesignCharacteristics a owl:Class ;
    rdfs:label "Biomass design characteristics"@en ;
    rdfs:comment "Typical values are the feedstock type, the conversion technology (combustion, gasification, digestion) and the calorific value of the fuel in MJ/kg."@en ;
    rdfs:subClassOf :DesignCharacteristics ;
    skos:definition "A set of design characteristics that describes the technical specification of a biomass energy system or component."@en .

:Country a owl:Class ;
    rdfs:label "Country"@en ;
    rdfs:comment "A country is the national administrative unit in which a location lies. It is the level at which energy policies, statistics and resource assessments are most often reported, and it is identified by a standard ISO code."@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_00000009> ;
    skos:definition "A sovereign state or territory recognized as a distinct political entity."@en ;
    skos:exactMatch schema:Country .

:GeothermalDesignCharacteristics a owl:Class ;
    rdfs:label "Geothermal design characteristics"@en ;
    rdfs:comment "Typical values are the plant type (dry steam, flash or binary), the reservoir temperature in °C and the well depth in metres."@en ;
    rdfs:subClassOf :DesignCharacteristics ;
    skos:definition "A set of design characteristics that describes the technical specification of a geothermal energy system or component."@en .

:HydrogenPlantDesignCharacteristics a owl:Class ;
    rdfs:label "Hydrogen plant design characteristics"@en ;
    rdfs:comment "Typical values are the electrolyser type (alkaline, PEM or solid oxide), its efficiency and the hydrogen production rate, for example in kg/h."@en ;
    rdfs:subClassOf :DesignCharacteristics ;
    skos:definition "A set of design characteristics that describes the technical specification of a hydrogen production plant or component."@en .

:MeteorologicalVariable a owl:Class ;
    rdfs:label "Meteorological variable"@en ;
    rdfs:comment "Meteorological variables, such as precipitation or cloud cover, drive renewable resources and are common predictors in resource estimation models."@en ;
    rdfs:subClassOf :Variable ;
    skos:definition "A variable describing the state of the atmosphere or the weather."@en .

:NeuralNetworkModel a owl:Class ;
    rdfs:label "Neural network model"@en ;
    rdfs:comment "Neural networks approximate nonlinear relationships between inputs and outputs and are trained by gradient-based optimization."@en ;
    rdfs:subClassOf :MachineLearningModel ;
    skos:definition "A machine-learning model made of layers of interconnected artificial neurons."@en .

:NonRenewableEnergyResource a owl:Class ;
    rdfs:label "Non renewable energy resource"@en ;
    rdfs:comment "Non-renewable resources are finite; burning fossil fuels also emits greenhouse gases, which policies such as environmental levies aim to reduce."@en ;
    rdfs:subClassOf :EnergyResource ;
    skos:definition "An energy resource that is not replenished on a human timescale, such as coal, oil, natural gas or uranium."@en .

:NuclearDesignCharacteristics a owl:Class ;
    rdfs:label "Nuclear design characteristics"@en ;
    rdfs:comment "Typical values are the reactor type, the coolant type and the thermal power in MWth."@en ;
    rdfs:subClassOf :DesignCharacteristics ;
    skos:definition "A set of design characteristics that describes the technical specification of a nuclear energy system or component."@en .

:OceanPlantDesignCharacteristics a owl:Class ;
    rdfs:label "Ocean plant design characteristics"@en ;
    rdfs:comment "Typical values are the device type, the tidal range and the significant wave height, both in metres."@en ;
    rdfs:subClassOf :DesignCharacteristics ;
    skos:definition "A set of design characteristics that describes the technical specification of an ocean energy plant or component."@en .

:PhysicalModel a owl:Class ;
    rdfs:label "Physical model"@en ;
    rdfs:comment "Examples are the wind power density equation and the hydropower equation P = ρgQHη."@en ;
    rdfs:subClassOf :SymbolicModel ;
    skos:definition "A symbolic model derived from physical laws."@en .

:WindDesignCharacteristics a owl:Class ;
    rdfs:label "Wind design characteristics"@en ;
    rdfs:comment "Typical values are the hub height, rotor diameter, swept area, number of blades, axis type, cut-in, rated and cut-out wind speeds, and the power curve."@en ;
    rdfs:subClassOf :DesignCharacteristics ;
    skos:definition "A set of design characteristics that describes the technical specification of a wind turbine or wind energy system."@en .

:DesignParameterValue a owl:Class ;
    rdfs:label "Design parameter value"@en ;
    rdfs:comment "It records the parameter name, its value, its unit and the period it refers to, for example the inverter efficiency of a PV system or the penstock length of a small hydropower plant. It is attached to a set of design characteristics with belongsToDesignCharacteristics."@en ;
    skos:broadMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000350> ;
    skos:definition "The value of a design parameter of an energy system or component that has no dedicated property in the ontology."@en .

:MixtureComponent a owl:Class ;
    rdfs:label "Mixture component"@en ;
    rdfs:comment "Its parameter values are linked to it, so that each weight and parameter refers to the right component."@en ;
    skos:definition "One component of a mixture distribution in a model application, with its distribution and weight."@en .

:Paper a owl:Class ;
    rdfs:label "Paper"@en ;
    rdfs:comment "A paper is the document through which research is communicated, identified by its title, authors and digital object identifier. It carries the bibliographic record of the study it reports."@en ;
    skos:broadMatch <http://purl.obolibrary.org/obo/IAO_0000311> ;
    skos:closeMatch <http://purl.org/ontology/bibo/AcademicArticle>,
        <http://purl.org/spar/fabio/ResearchPaper>,
        schema:ScholarlyArticle ;
    skos:definition "A scientific publication that reports a study."@en .

:MeasuringInstrument a owl:Class ;
    rdfs:label "Measuring instrument"@en ;
    rdfs:comment "A measuring instrument converts a physical quantity, such as wind speed or solar irradiance, into recorded data. The type, height and placement of instruments determine the quality of the datasets they produce."@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/OBI_0000832>,
        sosa:Sensor,
        <https://openenergyplatform.org/ontology/oeo/OEO_00010259> ;
    skos:definition "A device used to measure a physical variable."@en .

:RenewableEnergyResource a owl:Class ;
    rdfs:label "Renewable energy resource"@en ;
    rdfs:comment "Renewable resources, such as wind, solar radiation and flowing water, are continually renewed by natural processes. Their availability varies in space and time, which is why they must be assessed and modelled."@en ;
    rdfs:subClassOf :EnergyResource ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00020085> ;
    skos:definition "An energy resource that is naturally replenished on a human timescale."@en .

:ParameterValue a owl:Class ;
    rdfs:label "Parameter value"@en ;
    rdfs:comment "It keeps the location, the period, the unit and, for mixtures, the component to which the value refers, so that values from many stations or months stay distinct."@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/STATO_0000144> ;
    skos:definition "The value of a parameter of a model in a model application."@en .

:ProbabilityDistributionModel a owl:Class ;
    rdfs:label "Probability distribution model"@en ;
    rdfs:comment "Probability distributions such as the Weibull distribution describe how often each wind speed occurs and are the basis of wind energy yield estimates."@en ;
    rdfs:subClassOf :StatisticalModel ;
    skos:closeMatch <http://purl.obolibrary.org/obo/STATO_0000225> ;
    skos:definition "A statistical model that describes the probability of the possible values of a random variable."@en .

:Climate a owl:Class ;
    rdfs:label "Climate"@en ;
    rdfs:comment "Climate summarizes temperature, rainfall and seasonality over many years. It conditions the availability of renewable resources, such as sunshine, wind regimes and river flow, and is classified here following the Köppen-Geiger system."@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001082> ;
    skos:definition "The long-term pattern of weather conditions characterizing a location."@en .

:Condition a owl:Class ;
    rdfs:label "Condition"@en ;
    rdfs:comment "For example a range of wind speeds, a terrain type or a data period."@en ;
    skos:definition "A condition under which a finding of a study holds."@en .

:ConditionalFinding a owl:Class ;
    rdfs:label "Conditional finding"@en ;
    rdfs:comment "It is linked to its conditions, to the model application and models it is about, and to the study that reports it."@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/OBI_0001909> ;
    skos:definition "A finding of a study that holds under stated conditions."@en .

:DerivedValue a owl:Class ;
    rdfs:label "Derived value"@en ;
    rdfs:comment "An example is the mean wind power density computed from fitted Weibull parameters at a station."@en ;
    skos:broadMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000350> ;
    skos:definition "A value computed from data or from a model application in a study, for a variable at a location."@en .

:MachineLearningModel a owl:Class ;
    rdfs:label "Machine learning model"@en ;
    rdfs:comment "Machine-learning models are widely used to forecast wind speed, solar radiation and hydropower generation from meteorological and historical data."@en ;
    rdfs:subClassOf :DataDrivenModel ;
    skos:closeMatch <http://www.w3.org/ns/mls#Model> ;
    skos:definition "A data-driven model that learns patterns from data by an algorithm in order to make predictions or decisions."@en .

:ParameterEstimationMethod a owl:Class ;
    rdfs:label "Parameter estimation method"@en ;
    rdfs:comment "For wind-speed distributions, common methods are maximum likelihood, the method of moments, least squares and the energy pattern factor method; they can give different parameter values for the same data."@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/STATO_0000119> ;
    skos:definition "A method used to estimate the parameters of a model from data."@en .

:SWOTFactor a owl:Class ;
    rdfs:label "SWOT factor"@en ;
    rdfs:comment "Strengths and weaknesses are internal to the system or sector analysed, opportunities and threats are external. A SWOT factor can be linked to the general influencing factor it represents with representsFactor."@en ;
    skos:definition "A factor identified in a SWOT analysis and classified as a strength, weakness, opportunity or threat."@en .

:EvaluationResult a owl:Class ;
    rdfs:label "Evaluation result"@en ;
    rdfs:comment "It is linked to the application, the metric, and when reported the location, the period, the scenario and the unit."@en ;
    skos:closeMatch <http://www.w3.org/ns/mls#ModelEvaluation> ;
    skos:definition "The value of an evaluation metric obtained for a model application in a study."@en .

:ResearchProblem a owl:Class ;
    rdfs:label "Research problem"@en ;
    rdfs:comment "A research problem is the question a field works on, such as wind resource assessment or solar radiation estimation. It is shared across studies, so that all research on the same problem can be found together."@en ;
    skos:definition "A scientific problem or topic that a study addresses."@en .

:UncertaintyComponent a owl:Class ;
    rdfs:label "Uncertainty component"@en ;
    rdfs:comment "For example the uncertainty due to measurement height extrapolation."@en ;
    skos:definition "A component of the uncertainty of a model application or variable reported in a study."@en .

:DecisionCriterion a owl:Class ;
    rdfs:label "Decision criterion"@en ;
    rdfs:comment "For example slope or distance to the grid in site selection."@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/OBI_0001755> ;
    skos:definition "A criterion used to compare or rank alternatives in a study."@en .

:PolicyTarget a owl:Class ;
    rdfs:label "Policy target"@en ;
    rdfs:comment "A target has a value, a unit, a year and often a basis, for example 23% of total power generation from renewables by 2025."@en ;
    skos:definition "A quantified goal set by a policy, such as a share of renewable electricity or an installed capacity to reach by a given year."@en .

:Scenario a owl:Class ;
    rdfs:label "Scenario"@en ;
    rdfs:comment "Examples are climate scenarios, demand scenarios and input-data configurations."@en ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000364> ;
    skos:definition "A set of assumptions under which a model application, analysis or result is obtained."@en .

:EnergyResource a owl:Class ;
    rdfs:label "Energy resource"@en ;
    rdfs:comment "An energy resource is what an energy system converts into useful energy, such as wind, sunlight, flowing water or fossil fuels. Studies are linked to the resources they analyse."@en ;
    skos:definition "A natural source from which usable energy can be obtained."@en .

:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment "Observations keep their unit, measurement height, temporal resolution and reference plane."@en ;
    skos:closeMatch sosa:Observation ;
    skos:definition "A measured value of a variable at a location reported in a study."@en .

:DesignCharacteristics a owl:Class ;
    rdfs:label "Design characteristics"@en ;
    rdfs:comment "It groups values such as rated power, hub height, rotor diameter, module efficiency or hydraulic head; technology-specific subclasses exist for wind, solar, hydro, storage and other systems. Values not covered by a dedicated property are recorded as design parameter values."@en ;
    skos:definition "A set of technical attributes that specifies how an energy system or component is designed and sized."@en .

:StudyObjective a owl:Class ;
    rdfs:label "Study objective"@en ;
    rdfs:comment "A study objective states what a piece of research intends to do, such as assessing a resource, comparing models or optimizing a system. Each study pursues one or more objectives, expressed in its own words."@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/IAO_0000005> ;
    skos:definition "A goal that a study sets out to achieve."@en .

:Terrain a owl:Class ;
    rdfs:label "Terrain"@en ;
    rdfs:comment "Terrain describes the relief and surface of a place, such as mountains, plains, coasts or open sea. It affects how wind flows, how water drains and how much solar radiation a site receives."@en ;
    skos:definition "The physical form and nature of the land or sea surface at a location."@en ;
    skos:relatedMatch <http://purl.obolibrary.org/obo/ENVO_01001886>,
        schema:Landform .

:SoftwareTool a owl:Class ;
    rdfs:label "Software tool"@en ;
    rdfs:comment "Tools are shared nodes, such as MATLAB or ArcGIS, linked to the studies, analyses and model applications that use them."@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/IAO_0000010>,
        <http://www.ebi.ac.uk/swo/SWO_0000001>,
        schema:SoftwareApplication ;
    skos:definition "A software product, library or programming language used in a study."@en .

:Impact a owl:Class ;
    rdfs:label "Impact"@en ;
    rdfs:comment "Impacts record the consequences a study reports, such as tonnes of CO2 avoided, the number of people who could be supplied with water, or the share of national demand that could be covered. Most impacts in the corpus are potential or estimated rather than measured."@en ;
    skos:definition "An effect that an energy system, resource or policy has, or could have, on the environment, society, the economy or energy supply."@en ;
    skos:relatedMatch <https://www.commoncoreontologies.org/ont00000660> .

:Dataset a owl:Class ;
    rdfs:label "Dataset"@en ;
    rdfs:comment "A dataset is the body of observations or model outputs on which a study relies, such as wind speed measurements, satellite radiation estimates or reanalysis data. It is characterized by its source, period, temporal and spatial resolution, and the variables it contains."@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/IAO_0000100>,
        dcat:Dataset,
        schema:Dataset ;
    skos:definition "A collection of data used or produced by a study."@en .

:EvaluationMetric a owl:Class ;
    rdfs:label "Evaluation metric"@en ;
    rdfs:comment "Metrics are shared nodes, such as the root mean square error, used by many studies; each value obtained in a study is an evaluation result."@en ;
    rdfs:subClassOf :Metric ;
    skos:closeMatch <http://www.w3.org/ns/mls#EvaluationMeasure> ;
    skos:definition "A measure used to assess how well a model or method reproduces observed data."@en .

:EnergySystemComponent a owl:Class ;
    rdfs:label "Energy system component"@en ;
    rdfs:comment "Examples are wind turbines, PV modules, inverters, hydro turbines, generators and batteries. Its technical data are recorded in design characteristics, and its performance may be reported with performance metrics."@en ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000011> ;
    skos:definition "A physical part of an energy system that performs a distinct function in converting, storing or delivering energy."@en .

:Model a owl:Class ;
    rdfs:label "Model"@en ;
    rdfs:comment "Models are shared canonical nodes: the Weibull distribution or random forest exists once in the graph, with its standard formula and parameters, and every study that applies it points to it through a model application."@en ;
    skos:closeMatch <http://purl.org/spar/fabio/Model>,
        <https://openenergyplatform.org/ontology/oeo/OEO_00020352> ;
    skos:definition "A simplified representation of a system or phenomenon used to describe, explain, estimate or predict it."@en .

:Analysis a owl:Class ;
    rdfs:label "Analysis"@en ;
    rdfs:comment "An analysis is a step of a study in which data or evidence is examined, for example computing monthly means of wind speed, drawing a wind rose or analysing stakeholder interviews. Model building, model evaluation and economic calculations are represented by their own entities."@en ;
    skos:broadMatch <http://purl.obolibrary.org/obo/OBI_0000011>,
        prov:Activity ;
    skos:definition "A study activity that examines data or information to describe, characterize or explain a phenomenon."@en .

:Policy a owl:Class ;
    rdfs:label "Policy"@en ;
    rdfs:comment "Policies range from binding laws to tariffs, levies, procurement programmes and national plans. In the corpus they are reported as context for a study, used as constraints, or recommended by the authors."@en ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00140150> ;
    skos:definition "A course of action adopted or proposed by a government or authority to influence the energy sector."@en ;
    skos:relatedMatch <https://openenergyplatform.org/ontology/oeo/OEO_00140151> .

:ResourceCharacterization a owl:Class ;
    rdfs:label "Resource characterization"@en ;
    rdfs:comment "A resource characterization records what a study reports about a resource, such as the mean wind speed at 10 m above ground, its standard deviation, or the mean river discharge, together with the location, height, period and dataset from which it was derived. It is the main quantitative answer to questions about how much resource is available."@en ;
    skos:definition "A set of statistical values describing a renewable resource variable at a location over a period."@en .

:EconomicMetric a owl:Class ;
    rdfs:label "Economic metric"@en ;
    rdfs:comment "Examples are the levelised cost of electricity, the net present value and the payback period."@en ;
    rdfs:subClassOf :Metric ;
    skos:definition "An indicator of the cost or profitability of an energy system or resource reported in a study."@en .

:InfluencingFactor a owl:Class ;
    rdfs:label "Influencing factor"@en ;
    rdfs:comment "Influencing factors record what a study identifies as affecting its results, such as surface roughness changing wind speed with height, or cost limiting deployment. Each factor keeps the study's own statement and is linked to a shared factor type."@en ;
    skos:definition "A condition that affects an energy resource, an energy system or the results of a study."@en .

:Location a owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:comment "A location can be as small as a single measurement mast or as large as a country or region. It anchors research findings in space, so that results about resources, systems and models can be compared across places."@en ;
    skos:closeMatch schema:Place ;
    skos:definition "A place on the Earth at which a study, measurement, energy system or analysis is situated."@en .

:PerformanceMetric a owl:Class ;
    rdfs:label "Performance metric"@en ;
    rdfs:comment "Examples are the capacity factor, the annual energy production and the wind power density."@en ;
    skos:definition "An indicator of the performance of an energy resource or system reported in a study."@en .

:ModelApplication a owl:Class ;
    rdfs:label "Model application"@en ;
    rdfs:comment "A model application links a canonical model, such as the Weibull distribution, to what is specific to one study: the dataset, the location, the variable, the estimation method and the evaluation results. It keeps these elements together so that each result can be traced to its context."@en ;
    skos:broadMatch prov:Activity ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00000275> ;
    skos:definition "The use of a model in a study, with the data, place, variables and settings of that use."@en .

:Study a owl:Class ;
    rdfs:label "Study"@en ;
    rdfs:comment "A study is the research work itself, as distinct from the document that reports it. It brings together the problems investigated, the objectives pursued, the places examined, the data and models used and the conclusions reached."@en ;
    skos:broadMatch prov:Activity ;
    skos:closeMatch <http://purl.obolibrary.org/obo/OBI_0000066>,
        <https://openenergyplatform.org/ontology/oeo/OEO_00020011> ;
    skos:definition "A piece of research reported in a scientific paper, with its objectives, methods and findings."@en .

:EnergySystem a owl:Class ;
    rdfs:label "Energy system"@en ;
    rdfs:comment "An energy system is what a study assesses, designs or simulates, from a single wind turbine to a fleet of hydropower plants. Each system is typed by the energy source it uses and linked to a shared category, such as wind farm or small hydropower plant."@en ;
    skos:closeMatch <https://openenergyplatform.org/ontology/oeo/OEO_00020102> ;
    skos:definition "A system that converts, stores or delivers energy, such as a power plant, a turbine or a hybrid system."@en ;
    skos:relatedMatch <https://openenergyplatform.org/ontology/oeo/OEO_00030024> .

:Variable a owl:Class ;
    rdfs:label "Variable"@en ;
    rdfs:comment "Variables are shared nodes: one node, such as wind speed or global solar radiation, is used by every study that deals with it, so that all data, analyses and results about the same quantity can be found together. Temporal qualifiers and heights are part of the name when the study states them, for example daily global solar radiation or wind speed at 50 m."@en ;
    skos:closeMatch <http://qudt.org/schema/qudt/QuantityKind>,
        sosa:ObservableProperty ;
    skos:definition "A measurable or computable quantity that a study observes, estimates or uses."@en .

