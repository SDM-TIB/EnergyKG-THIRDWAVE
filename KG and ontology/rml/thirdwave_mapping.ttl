# THIRDWAVE KG -- RML rules for SDM-RDFizer (2026-10-13)
# Each TriplesMap reads one CSV of data/ and produces:
#   entities/*.csv   -> rdf:type + datatype and object properties of the ontology (one row = one instance)
#   relations/*.csv  -> one object property between two instances (columns: subject id, target id)
#   alignments/*.csv -> skos links from shared nodes to external ontologies (QUDT, STATO, OEO, ENVO, SWO)
# Subjects: https://w3id.org/thirdwave/data/{id}   Ontology: https://w3id.org/thirdwave/ontology#
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@base <https://w3id.org/thirdwave/mapping/> .

<#analyses_final> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "data/entities/analyses_final.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [ rr:template "https://w3id.org/thirdwave/data/{analysis_id}" ] ;
  rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant <https://w3id.org/thirdwave/ontology#Analysis> ] ] ;
  rr:predicateObjectMap [ rr:predicate <https://w3id.org/thirdwave/ontology#analysisName> ; rr:objectMap [ rml:reference "analysisName" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] ;
  rr:predicateObjectMap [ rr:predicate <http://www.w3.org/2000/01/rdf-schema#label> ; rr:objectMap [ rml:reference "analysisName" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] ;
  rr:predicateObjectMap [ rr:predicate <https://w3id.org/thirdwave/ontology#analysisPurpose> ; rr:objectMap [ rml:reference "analysisPurpose" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] ;
  rr:predicateObjectMap [ rr:predicate <https://w3id.org/thirdwave/ontology#analysisTechnique> ; rr:objectMap [ rml:reference "analysisTechnique" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] ;
  rr:predicateObjectMap [ rr:predicate <https://w3id.org/thirdwave/ontology#analysisMethodDescription> ; rr:objectMap [ rml:reference "analysisMethodDescription" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] ;
  rr:predicateObjectMap [ rr:predicate <https://w3id.org/thirdwave/ontology#analysisKeyOutcome> ; rr:objectMap [ rml:reference "analysisKeyOutcome" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] .

<#analysis_node_types_final> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "data/entities/analysis_node_types_final.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [ rr:template "https://w3id.org/thirdwave/data/{analysis_id}" ] ;
  rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:template "https://w3id.org/thirdwave/ontology#{analysisType}" ; rr:termType rr:IRI ] ] .

<#analysis_nodes_final> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "data/entities/analysis_nodes_final.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [ rr:template "https://w3id.org/thirdwave/data/{analysis_id}" ] ;
  rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant <https://w3id.org/thirdwave/ontology#Analysis> ] ] ;
  rr:predicateObjectMap [ rr:predicate <https://w3id.org/thirdwave/ontology#analysisName> ; rr:objectMap [ rml:reference "analysisName" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] ;
  rr:predicateObjectMap [ rr:predicate <http://www.w3.org/2000/01/rdf-schema#label> ; rr:objectMap [ rml:reference "analysisName" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] ;
  rr:predicateObjectMap [ rr:predicate <http://www.w3.org/2004/02/skos/core#definition> ; rr:objectMap [ rml:reference "definition" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] ;
  rr:predicateObjectMap [ rr:predicate <http://www.w3.org/2000/01/rdf-schema#comment> ; rr:objectMap [ rml:reference "comment" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] .

