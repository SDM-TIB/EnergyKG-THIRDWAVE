    rdfs:label "Hybrid energy system"@en .

:HybridModel a owl:Class ;
    rdfs:subClassOf :Model ;
    rdfs:label "Hybrid model"@en .

:HydroComponent a owl:Class ;
    rdfs:subClassOf :EnergySystemComponent ;
    rdfs:label "Hydro component"@en .

:HydroDesignCharacteristics a owl:Class ;
    rdfs:subClassOf :DesignCharacteristics ;
    rdfs:label "Hydro design characteristics"@en .

:HydroEnergy a owl:Class ;
    rdfs:subClassOf :RenewableEnergyResource ;
    rdfs:label "Hydro energy"@en .

:HydrogenComponent a owl:Class ;
